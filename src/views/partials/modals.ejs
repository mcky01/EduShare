<!-- Global Omnisearch Modal (Ctrl+K) -->
<div class="modal fade modal-glass" id="omniSearchModal" tabindex="-1" aria-labelledby="omniSearchTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2 w-100">
                    <i class="bi bi-search text-success fs-4" aria-hidden="true"></i>
                    <% const _omniLabel = (typeof user !== 'undefined' && user && user.role === 'teacher') ? 'Search your classes, library materials, and quizzes' : ((typeof user !== 'undefined' && user && user.role === 'admin') ? 'Search classes, users, and quizzes' : 'Search classes, materials, and quizzes'); %>
                    <label class="visually-hidden" for="omniSearchInput" id="omniSearchTitle"><%= _omniLabel %></label>
                    <input type="text" id="omniSearchInput" class="form-control border-0 shadow-none fs-5 bg-transparent" placeholder="<%= _omniLabel %>" aria-describedby="omniSearchHint">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close search"></button>
                </div>
            </div>
            <div class="modal-body pt-2">
                <hr style="border-color: rgba(16, 185, 129, 0.2);">
                <div id="omniSearchResults" role="status" aria-live="polite" style="max-height: 380px; overflow-y: auto;">
                    <div class="text-center text-muted p-4" id="omniSearchHint">
                        <i class="bi bi-keyboard fs-2 d-block mb-2 text-success" aria-hidden="true"></i>
                        <span class="small fw-semibold">Press <kbd class="px-2 py-1 rounded bg-light border">ESC</kbd> to close &bull; Search indexed content across EduShare</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Profile Settings Modal -->
<div class="modal fade modal-glass" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="profileModalLabel">
                    <i class="bi bi-person-circle text-success me-2"></i>My Profile Settings
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/auth/profile" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <% const _initials = (user && user.first_name && user.last_name) ? (user.first_name[0] + user.last_name[0]).toUpperCase() : 'U'; %>
                        <% if (user && user.avatar_url) { %>
                            <img src="<%= user.avatar_url %>" alt="Profile photo of <%= user.first_name %>" class="rounded-circle shadow" style="width: 80px; height: 80px; object-fit: cover; border: 3px solid var(--zahs-jade);" data-avatar-fallback>
                        <% } else { %>
                            <div class="user-avatar-initials mx-auto" style="width: 80px; height: 80px; font-size: 1.75rem;" aria-hidden="true">
                                <%= _initials %>
                            </div>
                        <% } %>
                        <div class="mt-2">
                            <label class="btn btn-sm btn-glass" for="avatarUploadInput" tabindex="0">
                                <i class="bi bi-camera me-1" aria-hidden="true"></i> Change Avatar
                            </label>
                            <input type="file" id="avatarUploadInput" name="avatar" class="visually-hidden" accept="image/jpeg,image/png,image/gif,image/webp">
                            <div class="form-text small text-muted mt-1">Max 5 MB.</div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted" for="profileFirstName">First Name</label>
                            <input type="text" id="profileFirstName" name="first_name" class="glass-input" value="<%= user ? user.first_name : '' %>" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted" for="profileLastName">Last Name</label>
                            <input type="text" id="profileLastName" name="last_name" class="glass-input" value="<%= user ? user.last_name : '' %>" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted" for="profileEmail">Email Address (Read-only)</label>
                            <input type="email" id="profileEmail" class="glass-input text-muted" value="<%= user ? user.email : '' %>" readonly>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted" for="profileRole">Role</label>
                            <input type="text" id="profileRole" class="glass-input text-muted text-uppercase fw-bold" value="<%= user ? user.role : '' %>" readonly>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-liquid-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Logout Confirmation Modal -->
<div class="modal fade modal-glass" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center p-3">
            <div class="modal-body">
                <i class="bi bi-door-open fs-1 text-danger d-block mb-3" aria-hidden="true"></i>
                <h5 class="fw-bold mb-2" id="logoutModalTitle">Sign Out?</h5>
                <p class="small text-muted mb-4">Are you sure you want to end your current session?</p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <form action="/auth/logout" method="POST" class="d-inline">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <button type="submit" class="btn btn-danger rounded-3 px-3">Sign Out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
