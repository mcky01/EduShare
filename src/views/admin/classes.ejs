<div class="admin-page-head">
    <div>
        <h2>Academic Oversight — Classes</h2>
        <p class="text-muted">Read-only view of every class section across all teachers.</p>
    </div>
    <span class="badge-amber"><i class="bi bi-eye me-1"></i>Read-only oversight</span>
</div>

<% const _hideEmpty = typeof hideEmpty !== 'undefined' && hideEmpty; %>
<% const _groups = typeof groups !== 'undefined' ? groups : []; %>
<% const _gaps = typeof coverageGaps !== 'undefined' ? coverageGaps : []; %>

<div class="glass-card p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="nav gap-1" aria-label="Filter by grade level">
        <a href="/admin/classes?grade=all&q=<%= encodeURIComponent(searchQuery) %><%= _hideEmpty ? '&hideEmpty=1' : '' %>" class="filter-pill <%= selectedGrade === 'all' ? 'active' : '' %>">All</a>
        <% grades.forEach(g => { %>
            <a href="/admin/classes?grade=<%= encodeURIComponent(g) %>&q=<%= encodeURIComponent(searchQuery) %><%= _hideEmpty ? '&hideEmpty=1' : '' %>" class="filter-pill <%= selectedGrade === g ? 'active' : '' %>"><%= g %></a>
        <% }) %>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a href="/admin/classes?grade=<%= encodeURIComponent(selectedGrade) %>&q=<%= encodeURIComponent(searchQuery) %><%= _hideEmpty ? '' : '&hideEmpty=1' %>" class="btn btn-sm <%= _hideEmpty ? 'btn-liquid-primary' : 'btn-glass' %>" title="Show only classes with enrolled students">
            <i class="bi bi-people me-1"></i>Hide empty<%= _hideEmpty ? ' ✓' : '' %>
        </a>
        <form action="/admin/classes" method="GET" class="d-flex gap-2" style="max-width: 300px; width: 100%;">
            <input type="hidden" name="grade" value="<%= selectedGrade %>">
            <% if (_hideEmpty) { %><input type="hidden" name="hideEmpty" value="1"><% } %>
            <input type="text" name="q" class="glass-input py-1 px-3" placeholder="Search class, code, teacher..." value="<%= searchQuery %>" aria-label="Search classes">
            <button type="submit" class="btn btn-glass py-1 px-3" aria-label="Search">
                <i class="bi bi-search"></i>
            </button>
        </form>
    </div>
</div>

<!-- Coverage gaps: known grade/section pairs with no active class -->
<% if (_gaps.length > 0) { %>
<div class="glass-card p-3 mb-4 d-flex align-items-center gap-3 flex-wrap" style="border-left: 4px solid var(--zahs-amber-gold);" role="status">
    <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
    <div class="flex-grow-1">
        <span class="fw-bold text-dark"><%= _gaps.length %> section<%= _gaps.length === 1 ? '' : 's' %> with students/advisers but no active class</span>
        <span class="text-muted small"> — <%= _gaps.slice(0, 6).map(g => `${g.grade_level} - ${g.section}`).join(', ') %><%= _gaps.length > 6 ? ` (+${_gaps.length - 6} more)` : '' %></span>
    </div>
</div>
<% } %>

<!-- Grouped by grade: one collapsible card per grade, rows sorted Subject → Section -->
<% if (_groups.length === 0) { %>
    <%- include('../partials/admin-empty', { icon: 'bi-mortarboard', title: 'No classes found', hint: 'Try a different search or grade filter.' }) %>
<% } else { %>
    <% _groups.forEach((g, gi) => { %>
    <div class="glass-card mb-3 class-grade-group" data-grade-group="<%= g.grade %>">
        <button type="button" class="w-100 d-flex align-items-center gap-2 flex-wrap text-start border-0 bg-transparent p-3 class-grade-toggle" data-grade-toggle="<%= g.grade %>" aria-expanded="true" aria-controls="grade-body-<%= gi %>">
            <i class="bi bi-chevron-down class-grade-chevron" aria-hidden="true"></i>
            <span class="fw-bold text-dark fs-6"><%= g.grade %></span>
            <span class="badge-emerald"><%= g.classCount %> class<%= g.classCount === 1 ? '' : 'es' %></span>
            <span class="badge-amber"><%= g.studentCount %> student<%= g.studentCount === 1 ? '' : 's' %></span>
            <span class="badge-gray"><%= g.teacherCount %> teacher<%= g.teacherCount === 1 ? '' : 's' %></span>
            <% if (g.emptyCount > 0) { %>
                <span class="badge-red" title="<%= g.emptyCount %> class(es) with zero enrolled students"><i class="bi bi-exclamation-circle me-1"></i><%= g.emptyCount %> empty</span>
            <% } %>
        </button>
        <div id="grade-body-<%= gi %>" class="class-grade-body">
            <div class="table-responsive">
                <table class="glass-table">
                    <thead>
                        <tr>
                            <th scope="col">Class</th>
                            <th scope="col">Join Code</th>
                            <th scope="col">Teacher</th>
                            <th scope="col">Students</th>
                            <th scope="col">Content</th>
                            <th scope="col">Status</th>
                            <th scope="col">Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% g.classes.forEach(c => { %>
                            <tr class="<%= (Number(c.student_count) || 0) === 0 ? 'class-row-empty' : '' %>">
                                <td>
                                    <div class="fw-bold text-dark"><%= c.class_name %></div>
                                    <div class="text-muted small"><%= c.subject %> &bull; <%= c.grade_level %> - <%= c.section %></div>
                                </td>
                                <td class="font-monospace small fw-bold"><%= c.class_code %></td>
                                <td class="small">
                                    <div class="fw-bold text-dark"><%= c.teacher_first %> <%= c.teacher_last %></div>
                                    <div class="text-muted"><%= c.teacher_email %></div>
                                </td>
                                <td>
                                    <% if ((Number(c.student_count) || 0) === 0) { %>
                                        <span class="badge-red" title="No enrolled students"><i class="bi bi-exclamation-circle me-1"></i>0 enrolled</span>
                                    <% } else { %>
                                        <span class="badge-emerald"><%= c.student_count %> enrolled</span>
                                    <% } %>
                                </td>
                                <td class="small text-muted">
                                    <%= c.material_count %> materials &bull; <%= c.activity_count %> activities &bull; <%= c.quiz_count %> quizzes
                                </td>
                                <td>
                                    <span class="<%= c.is_active ? 'badge-emerald' : 'badge-gray' %>">
                                        <%= c.is_active ? 'Active' : 'Archived' %>
                                    </span>
                                </td>
                                <td>
                                    <a href="/admin/classes/<%= c.id %>" class="btn btn-sm btn-liquid-primary">
                                        <i class="bi bi-eye me-1"></i>Open
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <% }) %>
<% } %>

<script src="/js/class-groups.js" defer></script>
