<div class="mb-4">
    <h2 class="fw-bold mb-1" style="color: var(--zahs-emerald-deep);">Curriculum Standards & Knowledge Base</h2>
    <p class="text-muted small mb-0">DepEd MATATAG Curriculum Guides (CG), Budgets of Work (BOW), and AI Grounding Competencies.</p>
</div>

<div class="row g-4 mb-4">
    <!-- Upload CG/BOW for RAG grounding -->
    <div class="col-12">
        <div class="glass-card p-4">
            <h5 class="fw-bold mb-1"><i class="bi bi-cloud-upload text-success me-2"></i>Upload Curriculum Document</h5>
            <p class="text-muted small mb-3">Text-based PDF or .txt (max 15MB). Parsed into grounded chunks for lesson + quiz generation. Scanned-image PDFs need a .txt/OCR export.</p>
            <form id="curriculumUploadForm" class="row g-3" enctype="multipart/form-data">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Title</label>
                    <input type="text" id="docTitle" class="glass-input" placeholder="e.g. English 7 CG Q1" required>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Type</label>
                    <select id="docType" class="glass-input">
                        <option value="CG">CG</option>
                        <option value="BOW">BOW</option>
                        <option value="LE">LE</option>
                        <option value="LM">LM</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Subject</label>
                    <input type="text" id="docSubject" class="glass-input" value="English" required>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Grade</label>
                    <select id="docGrade" class="glass-input">
                        <option value="Grade 7">Grade 7</option>
                        <option value="Grade 8">Grade 8</option>
                        <option value="Grade 9">Grade 9</option>
                        <option value="Grade 10">Grade 10</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Quarter</label>
                    <select id="docQuarter" class="glass-input">
                        <option value="Q1">Q1 → T1</option>
                        <option value="Q2">Q2 → T1</option>
                        <option value="Q3">Q3 → T2</option>
                        <option value="Q4">Q4 → T3</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Competency code (optional)</label>
                    <input type="text" id="docCompCode" class="glass-input" placeholder="e.g. EN7LIT-I-1">
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">File (.pdf / .txt)</label>
                    <input type="file" id="docFile" class="glass-input" accept=".pdf,.txt" required>
                </div>
                <div class="col-12 d-flex justify-content-end align-items-center gap-3 flex-wrap">
                    <label class="small fw-semibold text-muted mb-0 d-flex align-items-center gap-1">
                        <input type="checkbox" id="docForce" class="form-check-input mt-0" value="1">
                        Replace existing (same type/subject/grade)
                    </label>
                    <span id="uploadStatus" class="small fw-semibold text-muted"></span>
                    <button type="submit" id="btnUploadDoc" class="btn btn-liquid-primary px-4">
                        <i class="bi bi-cloud-arrow-up me-1"></i> Ingest Document
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- Seeded Competencies -->
    <div class="col-12">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h5 class="fw-bold mb-0"><i class="bi bi-book text-success me-2"></i>DepEd Learning Competencies</h5>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge-emerald"><%= competencies.length %> Standards Active</span>
                    <label class="small fw-bold text-muted mb-0" for="compSubject">Subject</label>
                    <select id="compSubject" class="glass-input py-1 px-3" style="width: auto;">
                        <option value="">All subjects</option>
                        <% [...new Set(competencies.map(c => c.subject))].forEach(s => { %>
                            <option value="<%= s %>"><%= s %></option>
                        <% }) %>
                    </select>
                    <label class="small fw-bold text-muted mb-0" for="compGrade">Grade</label>
                    <select id="compGrade" class="glass-input py-1 px-3" style="width: auto;">
                        <option value="">All grades</option>
                        <% [...new Set(competencies.map(c => c.grade_level))].forEach(g => { %>
                            <option value="<%= g %>"><%= g %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="table-responsive">
                <table class="glass-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Description</th>
                            <th>Subject</th>
                            <th>Grade Level</th>
                            <th>Quarter</th>
                            <th>Source</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% competencies.forEach(comp => { %>
                            <tr data-subject="<%= comp.subject %>" data-grade="<%= comp.grade_level %>">
                                <td class="font-monospace fw-bold text-success"><%= comp.code %></td>
                                <td class="small" style="max-width: 400px;"><%= comp.description %></td>
                                <td><%= comp.subject %></td>
                                <td><%= comp.grade_level %></td>
                                <td><span class="badge <%= comp.quarter === 'Q1' ? 'badge-emerald' : (comp.quarter === 'Q2' ? 'badge-jade' : (comp.quarter === 'Q3' ? 'badge-amber' : 'badge-gray')) %>"><%= comp.quarter %></span></td>
                                <td class="small text-muted"><%= comp.source_version %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="/js/curriculum-upload.js"></script>
