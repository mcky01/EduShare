<% const actTrail = [{ label: 'Classes', href: '/admin/classes' }]; if (postings.length) { actTrail.push({ label: postings[0].class_name, href: '/admin/classes/' + postings[0].class_id + '?tab=activities' }); } actTrail.push({ label: activity.title }); %>
<%- include('../partials/admin-crumbs', { trail: actTrail }) %>
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <span class="badge-emerald"><i class="bi bi-pencil-square me-1"></i>Activity</span>
            <span class="badge-gray"><i class="bi bi-eye me-1"></i>Read-only oversight</span>
        </div>
        <h2 class="fw-bold mb-1 text-dark" style="font-size: 1.25rem;"><%= activity.title %></h2>
        <p class="text-muted small mb-0">
            by <%= activity.teacher_first %> <%= activity.teacher_last %>
            &bull; <%= activity.points %> points
            &bull; Due <%= activity.due_date ? new Date(activity.due_date).toLocaleString() : 'no deadline' %>
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <% if (postings.length > 0) { %>
            <a href="/admin/classes/<%= postings[0].class_id %>?tab=activities" class="btn btn-glass">
                <i class="bi bi-arrow-left me-1"></i> Back to Class
            </a>
        <% } %>
    </div>
</div>

<% if (activity.instructions) { %>
    <div class="glass-card p-3 mb-4 small text-secondary"><%= activity.instructions %></div>
<% } %>

<div class="glass-card p-4 mb-4">
    <h5 class="fw-bold mb-3">Posted In</h5>
    <% if (postings.length === 0) { %>
        <p class="text-muted small mb-0">Not posted to any class.</p>
    <% } else { %>
        <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
            <% postings.forEach(p => { %>
                <li class="small">
                    <a href="/admin/classes/<%= p.class_id %>" class="fw-bold text-dark text-decoration-none"><%= p.class_name %></a>
                    <span class="text-muted font-monospace">(<%= p.class_code %>)</span>
                </li>
            <% }) %>
        </ul>
    <% } %>
</div>

<div class="glass-card p-4">
    <h5 class="fw-bold mb-3">Submissions (<%= submissions.length %>)</h5>
    <% if (submissions.length === 0) { %>
        <p class="text-muted small mb-0">No submissions recorded.</p>
    <% } else { %>
        <div class="table-responsive">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Class</th>
                        <th scope="col">Submitted</th>
                        <th scope="col">Score</th>
                        <th scope="col">Status</th>
                        <th scope="col">File</th>
                    </tr>
                </thead>
                <tbody>
                    <% submissions.forEach(s => { %>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark small"><%= s.first_name %> <%= s.last_name %></div>
                                <div class="text-muted font-monospace" style="font-size: 0.72rem;"><%= s.lrn %></div>
                            </td>
                            <td class="small text-muted"><%= s.class_name %></td>
                            <td class="small text-muted"><%= s.submitted_at ? new Date(s.submitted_at).toLocaleString() : 'N/A' %></td>
                            <td class="small fw-bold"><%= s.score != null ? s.score : '—' %></td>
                            <td>
                                <span class="<%= s.status === 'graded' ? 'badge-emerald' : 'badge-amber' %>"><%= s.status %></span>
                            </td>
                            <td>
                                <% if (s.file_path) { %>
                                    <a href="<%= s.file_path %>" target="_blank" class="btn btn-sm btn-glass"><i class="bi bi-download"></i></a>
                                <% } else { %>
                                    <span class="text-muted small">—</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
