<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--zahs-emerald-deep);">Administrator Dashboard</h2>
        <p class="text-muted small mb-0">Overview of institutional operations and learning metrics at <%= school.name %>.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/users" class="btn btn-liquid-primary">
            <i class="bi bi-person-plus me-1"></i> Manage Users
        </a>
        <a href="/admin/settings" class="btn btn-glass">
            <i class="bi bi-gear me-1"></i> Settings
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="glass-card stat-card-glass">
            <div class="stat-icon-wrapper stat-icon-emerald">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <div class="stat-value"><%= stats.teachers %></div>
                <div class="stat-label">Faculty Teachers</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="glass-card stat-card-glass">
            <div class="stat-icon-wrapper stat-icon-jade">
                <i class="bi bi-backpack4"></i>
            </div>
            <div>
                <div class="stat-value"><%= stats.students %></div>
                <div class="stat-label">Enrolled Students</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="glass-card stat-card-glass">
            <div class="stat-icon-wrapper stat-icon-amber">
                <i class="bi bi-mortarboard"></i>
            </div>
            <div>
                <div class="stat-value"><%= stats.classes %></div>
                <div class="stat-label">Active Classes</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="glass-card stat-card-glass">
            <div class="stat-icon-wrapper stat-icon-gray">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <div class="stat-value"><%= stats.activeUsers %></div>
                <div class="stat-label">Active Accounts</div>
            </div>
        </div>
    </div>
</div>

<!-- System AI Status (slim pill, below the data) -->
<div class="d-flex justify-content-end mb-4">
    <span class="<%= isAiHealthy ? 'badge-emerald' : 'badge-amber' %>" title="<%= isAiHealthy ? 'Ollama server online and model ready for real-time streaming and quiz generation.' : 'Ollama is offline or warming up. The built-in smart educational fallback engine is actively ensuring 100% uptime.' %>">
        <i class="bi bi-cpu me-1"></i> <%= isAiHealthy ? 'AI ONLINE · Qwen 2.5 7B' : 'SMART FALLBACK READY' %>
    </span>
</div>

<!-- Tables Row (equal heights keep the row aligned) -->
<div class="row g-4 align-items-stretch">
    <!-- Recent Users -->
    <div class="col-lg-7 d-flex">
        <div class="glass-card h-100 w-100 p-4 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent User Registrations</h5>
                <a href="/admin/users" class="small text-success fw-bold text-decoration-none">View All &rarr;</a>
            </div>
            <div class="table-responsive flex-grow-1">
                <table class="glass-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Role</th>
                            <th>Identifier</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentUsers.forEach(u => { %>
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark"><%= u.first_name %> <%= u.last_name %></div>
                                    <div class="text-muted small"><%= u.email %></div>
                                </td>
                                <td>
                                    <span class="<%= u.role === 'admin' ? 'badge-amber' : (u.role === 'teacher' ? 'badge-emerald' : 'badge-jade') %>">
                                        <%= u.role.toUpperCase() %>
                                    </span>
                                </td>
                                <td class="font-monospace small">
                                    <%= u.lrn || u.employee_id || 'N/A' %>
                                </td>
                                <td>
                                    <span class="<%= u.is_active ? 'badge-emerald' : 'badge-gray' %>">
                                        <%= u.is_active ? 'Active' : 'Inactive' %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Audit Logs -->
    <div class="col-lg-5 d-flex">
        <div class="glass-card h-100 w-100 p-4 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent Activity Logs</h5>
                <a href="/admin/logs" class="small text-success fw-bold text-decoration-none">View Full Audit &rarr;</a>
            </div>
            <div class="d-flex flex-column gap-3">
                <% recentLogs.forEach(log => { %>
                    <div class="p-2 rounded-3" style="background: rgba(255,255,255,0.5); border-left: 3px solid var(--zahs-jade);">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold small text-dark"><%= log.action %></span>
                            <span class="text-muted" style="font-size: 0.72rem;"><%= new Date(log.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                        </div>
                        <div class="small text-secondary" style="font-size: 0.8rem;"><%= log.description %></div>
                        <div class="text-muted" style="font-size: 0.7rem;">By: <%= log.first_name %> <%= log.last_name %> (<%= log.role %>)</div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>
