<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--zahs-emerald-deep);">User Management</h2>
        <p class="text-muted small mb-0">Create, monitor, and configure teacher and student accounts across all levels.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-liquid-primary" data-bs-toggle="modal" data-bs-target="#addTeacherModal">
            <i class="bi bi-person-plus me-1"></i> Add Teacher
        </button>
        <button type="button" class="btn btn-liquid-amber" data-bs-toggle="modal" data-bs-target="#addStudentModal">
            <i class="bi bi-person-badge me-1"></i> Add Student
        </button>
    </div>
</div>

<!-- Unified Filter Bar: role pills + status select + search -->
<div class="glass-card p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <!-- Role Tabs -->
    <div class="nav gap-1" aria-label="Filter by role">
        <a href="/admin/users?role=all&status=<%= typeof selectedStatus !== 'undefined' ? selectedStatus : 'all' %>" class="filter-pill <%= selectedRole === 'all' ? 'active' : '' %>">All</a>
        <a href="/admin/users?role=teacher&status=<%= typeof selectedStatus !== 'undefined' ? selectedStatus : 'all' %>" class="filter-pill <%= selectedRole === 'teacher' ? 'active' : '' %>">Teachers</a>
        <a href="/admin/users?role=student&status=<%= typeof selectedStatus !== 'undefined' ? selectedStatus : 'all' %>" class="filter-pill <%= selectedRole === 'student' ? 'active' : '' %>">Students</a>
        <a href="/admin/users?role=admin&status=<%= typeof selectedStatus !== 'undefined' ? selectedStatus : 'all' %>" class="filter-pill <%= selectedRole === 'admin' ? 'active' : '' %>">Admins</a>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <!-- Status Select -->
        <label class="small fw-bold text-muted mb-0" for="statusFilter">Status</label>
        <select id="statusFilter" class="glass-input py-1 px-3" style="width: auto;" onchange="location.href='/admin/users?role=<%= selectedRole %>&status=' + this.value">
            <% const st = typeof selectedStatus !== 'undefined' ? selectedStatus : 'all'; %>
            <option value="all" <%= st === 'all' ? 'selected' : '' %>>All</option>
            <option value="pending" <%= st === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="active" <%= st === 'active' ? 'selected' : '' %>>Active</option>
            <option value="rejected" <%= st === 'rejected' ? 'selected' : '' %>>Rejected</option>
        </select>

        <!-- Search Form -->
        <form action="/admin/users" method="GET" class="d-flex gap-2" style="max-width: 280px; width: 100%;">
            <input type="hidden" name="role" value="<%= selectedRole %>">
            <input type="hidden" name="status" value="<%= typeof selectedStatus !== 'undefined' ? selectedStatus : 'all' %>">
            <input type="text" name="q" class="glass-input py-1 px-3" placeholder="Search name, email, LRN..." value="<%= searchQuery %>" aria-label="Search users">
            <button type="submit" class="btn btn-glass py-1 px-3" aria-label="Search">
                <i class="bi bi-search"></i>
            </button>
        </form>
    </div>
</div>

<!-- Pending Approvals -->
<% const pendingUsers = users.filter(u => u.status === 'pending'); %>
<div class="glass-card p-3 mb-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-hourglass-split text-warning me-2"></i>Pending Approvals (<%= pendingUsers.length %>)</h5>
    <% if (pendingUsers.length === 0) { %>
        <p class="text-muted small mb-0">No pending registrations.</p>
    <% } else { %>
        <div class="table-responsive">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Registered</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% pendingUsers.forEach(u => { %>
                        <tr>
                            <td class="fw-bold text-dark"><%= u.first_name %> <%= u.last_name %></td>
                            <td class="small text-muted"><%= u.email %></td>
                            <td><span class="badge badge-gray"><%= u.role.toUpperCase() %></span></td>
                            <td class="small text-muted font-monospace"><%= u.created_at ? new Date(u.created_at).toLocaleString() : 'N/A' %></td>
                            <td>
                                <div class="d-flex gap-2">
                                    <form action="/admin/users/<%= u.id %>/approve" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                    <form action="/admin/users/<%= u.id %>/reject" method="POST" onsubmit="return confirm('Reject this registration?')">
                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<!-- Users Table -->
<div class="glass-table-container">
    <div class="table-responsive">
        <table class="glass-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Identifier / Level</th>
                    <th>Advisory</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (users.length === 0) { %>
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 d-block mb-2"></i>
                            No users found matching your query.
                        </td>
                    </tr>
                <% } %>
                <% users.forEach(u => { %>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar-initials" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                    <%= u.first_name[0] %><%= u.last_name[0] %>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark"><%= u.first_name %> <%= u.last_name %></div>
                                    <div class="text-muted small"><%= u.email %></div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="<%= u.role === 'admin' ? 'badge-amber' : (u.role === 'teacher' ? 'badge-emerald' : 'badge-jade') %>">
                                <%= u.role.toUpperCase() %>
                            </span>
                        </td>
                        <td class="small">
                            <% if (u.role === 'student') { %>
                                <div class="fw-bold text-dark">LRN: <%= u.lrn || 'N/A' %></div>
                                <div class="text-muted"><%= u.grade_level %> - <%= u.section %></div>
                            <% } else if (u.role === 'teacher') { %>
                                <div class="fw-bold text-dark">ID: <%= u.employee_id || 'N/A' %></div>
                                <div class="text-muted"><%= u.department %></div>
                            <% } else { %>
                                <div class="text-muted">System Administrator</div>
                            <% } %>
                        </td>
                        <td class="small">
                            <% if (u.is_adviser) { %>
                                <span class="badge-amber">
                                    <i class="bi bi-star-fill me-1"></i> <%= u.advisory_grade %> - <%= u.advisory_section %>
                                </span>
                            <% } else { %>
                                <span class="text-muted">&mdash;</span>
                            <% } %>
                        </td>
                        <td>
                            <span class="<%= u.is_active ? 'badge-emerald' : 'badge-gray' %>">
                                <%= u.is_active ? 'Active' : 'Inactive' %>
                            </span>
                            <% if (u.status === 'pending') { %>
                                <span class="badge-amber ms-1">Pending</span>
                            <% } else if (u.status === 'rejected') { %>
                                <span class="badge-red ms-1">Rejected</span>
                            <% } %>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <form action="/admin/users/<%= u.id %>/toggle-status" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-sm <%= u.is_active ? 'btn-glass' : 'btn-liquid-primary' %>" title="<%= u.is_active ? 'Deactivate Account' : 'Activate Account' %>" aria-label="<%= u.is_active ? 'Deactivate' : 'Activate' %> <%= u.first_name %> <%= u.last_name %>">
                                        <i class="bi <%= u.is_active ? 'bi-slash-circle' : 'bi-check-circle' %>"></i>
                                    </button>
                                </form>
                                <form action="/admin/users/<%= u.id %>/reset-password" method="POST" class="d-inline" onsubmit="return confirm('Reset this user password to default (ChangeMe123!)?')">
                                    <button type="submit" class="btn btn-sm btn-glass" title="Reset Password" aria-label="Reset password for <%= u.first_name %> <%= u.last_name %>">
                                        <i class="bi bi-key"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add Teacher -->
<div class="modal fade modal-glass" id="addTeacherModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus text-success me-2"></i>Register New Teacher</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/users" method="POST">
                <input type="hidden" name="role" value="teacher">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">First Name</label>
                            <input type="text" name="first_name" class="glass-input" placeholder="e.g. Juan" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Last Name</label>
                            <input type="text" name="last_name" class="glass-input" placeholder="e.g. Dela Cruz" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">DepEd Email</label>
                            <input type="email" name="email" class="glass-input" placeholder="e.g. juan.delacruz@zahs.edu.ph" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Employee ID</label>
                            <input type="text" name="employee_id" class="glass-input" placeholder="e.g. EMP-2026-042">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Department</label>
                            <select name="department" class="glass-input">
                                <option value="Junior High School">Junior High School</option>
                                <option value="Senior High School">Senior High School</option>
                                <option value="SPED">SPED</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Temporary Password</label>
                            <input type="password" name="password" class="glass-input" value="Teacher123!" required>
                            <div class="form-text small">User will be forced to change this upon initial login.</div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="is_adviser" value="1" id="adviserSwitch" onchange="document.getElementById('adviserFields').style.display = this.checked ? 'block' : 'none'">
                                <label class="form-check-label small fw-bold" for="adviserSwitch">Designate as Advisory Class Adviser</label>
                            </div>
                        </div>
                        <div class="col-12" id="adviserFields" style="display: none;">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small fw-bold">Advisory Grade</label>
                                    <select name="advisory_grade" class="glass-input">
                                        <option value="Grade 7">Grade 7</option>
                                        <option value="Grade 8">Grade 8</option>
                                        <option value="Grade 9">Grade 9</option>
                                        <option value="Grade 10">Grade 10</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold">Advisory Section</label>
                                    <input type="text" name="advisory_section" class="glass-input" placeholder="e.g. Rizal">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-liquid-primary">Create Teacher Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Student -->
<div class="modal fade modal-glass" id="addStudentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-backpack4 text-warning me-2"></i>Register New Student</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/users" method="POST">
                <input type="hidden" name="role" value="student">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">First Name</label>
                            <input type="text" name="first_name" class="glass-input" placeholder="e.g. Maria" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Last Name</label>
                            <input type="text" name="last_name" class="glass-input" placeholder="e.g. Santos" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Learner Reference Number (LRN)</label>
                            <input type="text" name="student_id" class="glass-input" placeholder="12-digit DepEd LRN" required maxlength="12">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Student Email</label>
                            <input type="email" name="email" class="glass-input" placeholder="e.g. maria.santos@student.edushare.local" required>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold">Gender</label>
                            <select name="gender" class="glass-input">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold">Grade Level</label>
                            <select name="grade_level" class="glass-input">
                                <option value="Grade 7">Grade 7</option>
                                <option value="Grade 8">Grade 8</option>
                                <option value="Grade 9">Grade 9</option>
                                <option value="Grade 10">Grade 10</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold">Section</label>
                            <input type="text" name="section" class="glass-input" value="Rizal" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Temporary Password</label>
                            <input type="password" name="password" class="glass-input" value="Student123!" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-liquid-amber">Create Student Account</button>
                </div>
            </form>
        </div>
    </div>
</div>
