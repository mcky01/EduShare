<%- include('../partials/admin-crumbs', { trail: [{ label: 'Users', href: '/admin/users' }, { label: profile.first_name + ' ' + profile.last_name }] }) %>
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-3">
        <div class="user-avatar-initials" style="width: 56px; height: 56px; font-size: 1.3rem;">
            <%= profile.first_name[0] %><%= profile.last_name[0] %>
        </div>
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h2 class="fw-bold mb-0 text-dark" style="font-size: 1.25rem;"><%= profile.first_name %> <%= profile.last_name %></h2>
                <span class="<%= profile.role === 'admin' ? 'badge-gray' : (profile.role === 'teacher' ? 'badge-emerald' : 'badge-jade') %>">
                    <%= profile.role.toUpperCase() %>
                </span>
                <span class="<%= profile.is_active ? 'badge-emerald' : 'badge-gray' %>">
                    <%= profile.is_active ? 'Active' : 'Inactive' %>
                </span>
                <% if (profile.status === 'pending') { %>
                    <span class="badge-amber">Pending</span>
                <% } else if (profile.status === 'rejected') { %>
                    <span class="badge-red">Rejected</span>
                <% } %>
            </div>
            <div class="text-muted small"><%= profile.email %> &bull; joined <%= profile.created_at ? new Date(profile.created_at).toLocaleDateString() : 'N/A' %> &bull; last login <%= profile.last_login ? new Date(profile.last_login).toLocaleString() : 'never' %></div>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/admin/sessions?user_id=<%= profile.id %>" class="btn btn-glass"><i class="bi bi-hdd-network me-1"></i>Sessions</a>
        <button type="button" class="btn btn-glass" data-bs-toggle="modal" data-bs-target="#editUserModal"><i class="bi bi-pencil me-1"></i>Edit</button>
        <% if (profile.role !== 'admin') { %>
            <form action="/admin/users/<%= profile.id %>/toggle-status" method="POST" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button type="submit" class="btn <%= profile.is_active ? 'btn-glass' : 'btn-liquid-primary' %>">
                    <%= profile.is_active ? 'Deactivate' : 'Activate' %>
                </button>
            </form>
            <form action="/admin/users/<%= profile.id %>/reset-password" method="POST" class="d-inline" data-confirm="Generate a random temporary password for this user? It will be shown once and they must change it on next sign-in.">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button type="submit" class="btn btn-glass">Reset Password</button>
            </form>
            <form action="/admin/users/<%= profile.id %>/revoke-sessions" method="POST" class="d-flex gap-1 align-items-center" data-confirm="Revoke all other sessions for this user? They sign out on next request." data-require-reason>
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="text" name="reason" class="glass-input py-1 px-2 small reason-input" placeholder="Reason (min 10)" required minlength="10" aria-label="Reason">
                <button type="submit" class="btn btn-glass" title="Revoke all other sessions">Revoke Sessions</button>
            </form>
        <% } %>
    </div>
</div>

<!-- Phase 2.7: edit-user modal -->
<div class="modal fade modal-glass" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil text-success me-2"></i>Edit <%= profile.role === 'admin' ? 'Administrator' : (profile.role === 'teacher' ? 'Teacher' : 'Student') %></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/users/<%= profile.id %>/edit" method="POST">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">First Name</label>
                            <input type="text" name="first_name" class="glass-input" value="<%= profile.first_name %>" required maxlength="100">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Last Name</label>
                            <input type="text" name="last_name" class="glass-input" value="<%= profile.last_name %>" required maxlength="100">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Email</label>
                            <input type="email" name="email" class="glass-input" value="<%= profile.email %>" required maxlength="150">
                            <% if (profile.role === 'teacher') { %><div class="form-text small">Teacher email must end with @zahs.edu.ph.</div><% } %>
                        </div>
                        <% if (profile.role === 'teacher') { %>
                            <div class="col-6">
                                <label class="form-label small fw-bold">Department</label>
                                <select name="department" class="glass-input">
                                    <% ['Junior High School', 'Senior High School', 'SPED'].forEach(d => { %>
                                        <option value="<%= d %>" <%= profile.department === d ? 'selected' : '' %>><%= d %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold">Specialization</label>
                                <input type="text" name="specialization" class="glass-input" value="<%= profile.specialization || '' %>" maxlength="100">
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="is_adviser" value="1" id="editAdviserSwitch" <%= profile.is_adviser ? 'checked' : '' %>>
                                    <label class="form-check-label small fw-bold" for="editAdviserSwitch">Advisory class adviser</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold">Advisory Grade</label>
                                <select name="advisory_grade" class="glass-input">
                                    <% ['Grade 7', 'Grade 8', 'Grade 9', 'Grade 10', 'Grade 11', 'Grade 12'].forEach(g => { %>
                                        <option value="<%= g %>" <%= profile.advisory_grade === g ? 'selected' : '' %>><%= g %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold">Advisory Section</label>
                                <input type="text" name="advisory_section" class="glass-input" value="<%= profile.advisory_section || '' %>" maxlength="50">
                            </div>
                        <% } else if (profile.role === 'student') { %>
                            <div class="col-4">
                                <label class="form-label small fw-bold">Gender</label>
                                <select name="gender" class="glass-input">
                                    <% ['Male', 'Female', 'Other'].forEach(g => { %>
                                        <option value="<%= g %>" <%= profile.gender === g ? 'selected' : '' %>><%= g %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-bold">Grade Level</label>
                                <select name="grade_level" class="glass-input">
                                    <% ['Grade 7', 'Grade 8', 'Grade 9', 'Grade 10', 'Grade 11', 'Grade 12'].forEach(g => { %>
                                        <option value="<%= g %>" <%= profile.grade_level === g ? 'selected' : '' %>><%= g %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-bold">Section</label>
                                <input type="text" name="section" class="glass-input" value="<%= profile.section || '' %>" maxlength="50">
                            </div>
                        <% } %>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-liquid-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="glass-card p-4 mb-4">
            <h5 class="fw-bold mb-3">Profile Facts</h5>
            <% if (profile.role === 'student') { %>
                <div class="small mb-2"><span class="text-muted">LRN:</span> <strong class="font-monospace"><%= profile.lrn || 'N/A' %></strong></div>
                <div class="small mb-2"><span class="text-muted">Level:</span> <strong><%= profile.grade_level %> - <%= profile.section %></strong></div>
                <div class="small mb-0"><span class="text-muted">Gender:</span> <strong><%= profile.gender %></strong></div>
            <% } else if (profile.role === 'teacher') { %>
                <div class="small mb-2"><span class="text-muted">Employee ID:</span> <strong class="font-monospace"><%= profile.employee_id || 'N/A' %></strong></div>
                <div class="small mb-2"><span class="text-muted">Department:</span> <strong><%= profile.department %></strong></div>
                <div class="small mb-2"><span class="text-muted">Specialization:</span> <strong><%= profile.specialization %></strong></div>
                <% if (profile.is_adviser) { %>
                    <div class="small mb-0"><span class="badge-amber"><i class="bi bi-star-fill me-1"></i><%= profile.advisory_grade %> - <%= profile.advisory_section %></span></div>
                <% } %>
            <% } else { %>
                <div class="small text-muted mb-0">System Administrator</div>
            <% } %>
        </div>

        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h5 class="fw-bold mb-0">Recent Security History</h5>
            </div>
            <% if (recentLogs.length === 0) { %>
                <p class="text-muted small mb-0">No recorded events for this account.</p>
            <% } else { %>
                <div class="d-flex flex-column gap-2">
                    <% recentLogs.forEach(l => { %>
                        <div class="p-2 rounded-3" style="background: rgba(255,255,255,0.5); border-left: 3px solid var(--zahs-jade);">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold small text-dark"><%= l.action %></span>
                                <span class="text-muted" style="font-size: 0.7rem;"><%= new Date(l.created_at).toLocaleString() %></span>
                            </div>
                            <div class="small text-secondary" style="font-size: 0.78rem;"><%= l.description %></div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <div class="col-lg-8">
        <% if (profile.role === 'student') { %>
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3">Enrollments (<%= relations.enrollments.length %>)</h5>
                <% if (relations.enrollments.length === 0) { %>
                    <p class="text-muted small mb-0">Not enrolled in any class.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="glass-table">
                            <thead><tr><th scope="col">Class</th><th scope="col">Code</th><th scope="col">Status</th></tr></thead>
                            <tbody>
                                <% relations.enrollments.forEach(e => { %>
                                    <tr>
                                        <td class="fw-bold text-dark small"><%= e.class_name %></td>
                                        <td class="font-monospace small"><%= e.class_code %></td>
                                        <td><span class="<%= e.status === 'active' ? 'badge-emerald' : 'badge-gray' %>"><%= e.status %></span></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3">Recent Quiz Attempts</h5>
                <% if (relations.attempts.length === 0) { %>
                    <p class="text-muted small mb-0">No quiz attempts.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="glass-table">
                            <thead><tr><th scope="col">Quiz</th><th scope="col">Class</th><th scope="col">Score</th><th scope="col">Result</th></tr></thead>
                            <tbody>
                                <% relations.attempts.forEach(a => { %>
                                    <tr>
                                        <td class="small fw-bold text-dark"><%= a.quiz_title %></td>
                                        <td class="small text-muted"><%= a.class_name %></td>
                                        <td class="small fw-bold"><%= a.score %> (<%= a.percentage %>%)</td>
                                        <td><span class="<%= a.passed ? 'badge-emerald' : 'badge-red' %>"><%= a.passed ? 'PASS' : 'FAIL' %></span></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

            <div class="glass-card p-4">
                <h5 class="fw-bold mb-3">Recent Submissions</h5>
                <% if (relations.submissions.length === 0) { %>
                    <p class="text-muted small mb-0">No activity submissions.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="glass-table">
                            <thead><tr><th scope="col">Activity</th><th scope="col">Class</th><th scope="col">Score</th><th scope="col">Status</th></tr></thead>
                            <tbody>
                                <% relations.submissions.forEach(s => { %>
                                    <tr>
                                        <td class="small fw-bold text-dark"><%= s.activity_title %></td>
                                        <td class="small text-muted"><%= s.class_name %></td>
                                        <td class="small fw-bold"><%= s.score != null ? s.score : '—' %></td>
                                        <td><span class="<%= s.status === 'graded' ? 'badge-emerald' : 'badge-amber' %>"><%= s.status %></span></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        <% } else if (profile.role === 'teacher') { %>
            <div class="glass-card p-4 mb-4">
                <div class="d-flex gap-2 flex-wrap mb-3">
                    <span class="badge-emerald"><%= relations.counts.library || 0 %> library items</span>
                    <span class="badge-amber"><%= relations.counts.quizzes || 0 %> quizzes</span>
                    <span class="badge-emerald"><%= relations.counts.activities || 0 %> activities</span>
                </div>
                <h5 class="fw-bold mb-3">Classes Owned (<%= relations.classesOwned.length %>)</h5>
                <% if (relations.classesOwned.length === 0) { %>
                    <p class="text-muted small mb-0">No classes created.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="glass-table">
                            <thead><tr><th scope="col">Class</th><th scope="col">Code</th><th scope="col">Students</th><th scope="col">Open</th></tr></thead>
                            <tbody>
                                <% relations.classesOwned.forEach(c => { %>
                                    <tr>
                                        <td class="fw-bold text-dark small"><%= c.class_name %></td>
                                        <td class="font-monospace small"><%= c.class_code %></td>
                                        <td class="small"><%= c.student_count %></td>
                                        <td><a href="/admin/classes/<%= c.id %>" class="btn btn-sm btn-glass">Open</a></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="glass-card p-4">
                <h5 class="fw-bold mb-2">Administrator Account</h5>
                <p class="text-muted small mb-0">Identity events for this account appear under Recent Security History. Use Edit above for corrections; new administrators are created from User Management.</p>
            </div>
        <% } %>
    </div>
</div>
