<div class="mb-4">
    <a href="/student/classes/<%= attempt.class_id %>?tab=quizzes" class="small text-success text-decoration-none fw-bold">&larr; Back to Class Quizzes</a>
</div>

<!-- Score Header Card -->
<div class="glass-card p-4 p-md-5 mb-4 text-center">
    <div class="mb-3">
        <span class="<%= attempt.passed ? 'badge-emerald' : 'badge bg-danger text-white' %> px-3 py-2 fs-6">
            <i class="bi <%= attempt.passed ? 'bi-check-circle-fill' : 'bi-x-circle-fill' %> me-1"></i>
            <%= attempt.passed ? 'ASSESSMENT PASSED' : 'NEEDS IMPROVEMENT' %>
        </span>
    </div>

    <h2 class="fw-bold text-dark mb-1"><%= attempt.quiz_title %></h2>
    <p class="text-muted small mb-4"><%= attempt.class_name %> &bull; Submitted on <%= new Date(attempt.completed_at).toLocaleString() %></p>

    <!-- Score Display -->
    <div class="d-inline-flex flex-column align-items-center justify-content-center p-4 rounded-circle shadow-sm mb-3"
         style="width: 170px; height: 170px; background: rgba(255,255,255,0.85); border: 4px solid <%= attempt.passed ? 'var(--zahs-jade)' : '#ef4444' %>;">
        <div class="display-5 fw-bold <%= attempt.passed ? 'text-success' : 'text-danger' %> font-monospace">
            <%= Math.round(attempt.score) %>
        </div>
        <div class="small text-muted fw-bold">out of <%= attempt.max_score %> pts</div>
        <div class="badge-amber mt-1" style="font-size: 0.72rem;"><%= Math.round(attempt.percentage) %>% Score</div>
    </div>

    <p class="text-secondary small max-w-md mx-auto mb-0" style="max-width: 500px;">
        Your score has been synchronized with your class record. Review each question below to deepen your learning.
    </p>
</div>

<!-- Question by Question Review -->
<h4 class="fw-bold mb-3"><i class="bi bi-journal-check text-success me-2"></i>Detailed Question Review</h4>

<div class="d-flex flex-column gap-3">
    <% answers.forEach((a, idx) => { %>
        <div class="glass-card p-4 <%= a.is_correct ? 'border-start border-4 border-success' : 'border-start border-4 border-danger' %>">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge <%= a.is_correct ? 'badge-emerald' : 'badge bg-danger text-white' %>">
                    <i class="bi <%= a.is_correct ? 'bi-check' : 'bi-x' %>"></i> Question <%= idx + 1 %>: <%= a.is_correct ? 'Correct (+1 pt)' : 'Incorrect (0 pt)' %>
                </span>
                <span class="small text-muted text-capitalize"><%= a.question_type.replace('_', ' ') %></span>
            </div>

            <h5 class="fw-bold text-dark mb-3"><%= a.question_text %></h5>

            <% if (a.question_type === 'multiple_choice' || a.question_type === 'true_false') { %>
                <div class="d-flex flex-column gap-2 mb-3">
                    <% a.options.forEach(opt => { %>
                        <% 
                            const isStudentPick = a.selected_option_id === opt.id;
                            const isCorrectOpt = opt.is_correct === 1;
                            let cardStyle = 'background: rgba(255,255,255,0.6);';
                            let icon = 'bi-circle text-muted';
                            if (isCorrectOpt) {
                                cardStyle = 'background: rgba(16,185,129,0.15); border: 1px solid var(--zahs-jade); font-weight: bold;';
                                icon = 'bi-check-circle-fill text-success';
                            } else if (isStudentPick && !isCorrectOpt) {
                                cardStyle = 'background: rgba(239,68,68,0.1); border: 1px solid #ef4444; font-weight: bold;';
                                icon = 'bi-x-circle-fill text-danger';
                            }
                        %>
                        <div class="p-2 px-3 rounded-3 d-flex align-items-center justify-content-between" style="<%= cardStyle %>">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi <%= icon %>"></i>
                                <span class="small"><%= opt.option_text %></span>
                            </div>
                            <% if (isStudentPick) { %>
                                <span class="badge <%= isCorrectOpt ? 'bg-success' : 'bg-danger' %>" style="font-size: 0.68rem;">Your Answer</span>
                            <% } else if (isCorrectOpt) { %>
                                <span class="badge bg-success" style="font-size: 0.68rem;">Correct Answer</span>
                            <% } %>
                        </div>
                    <% }) %>
                </div>

            <% } else if (a.question_type === 'identification') { %>
                <div class="p-3 rounded-3 mb-3" style="background: rgba(255,255,255,0.6);">
                    <div class="small"><strong>Your Answer:</strong> <span class="<%= a.is_correct ? 'text-success fw-bold' : 'text-danger fw-bold' %>"><%= a.answer_text || '(blank)' %></span></div>
                </div>
            <% } %>

            <% if (a.explanation) { %>
                <div class="p-2 px-3 rounded-3 bg-white small text-secondary">
                    <i class="bi bi-info-circle text-success me-1"></i><strong>Explanation:</strong> <%= a.explanation %>
                </div>
            <% } %>
        </div>
    <% }) %>
</div>
