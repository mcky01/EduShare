<!-- Class Header Banner -->
<div class="glass-card p-4 mb-4" style="background: linear-gradient(135deg, rgba(13,82,44,0.1), rgba(245,158,11,0.06)), rgba(255,255,255,0.85);">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge-emerald"><%= cls.subject %></span>
                <span class="small text-muted font-monospace">Class Code: <%= cls.class_code %></span>
            </div>
            <h2 class="fw-bold text-dark mb-1"><%= cls.class_name %></h2>
            <div class="small text-muted">
                Teacher <%= cls.teacher_first %> <%= cls.teacher_last %> &bull; <%= cls.grade_level %> - <%= cls.section %> &bull; <%= cls.schedule || 'Regular' %>
            </div>
        </div>
        <div>
            <a href="/student/chatbot" class="btn btn-liquid-amber">
                <i class="bi bi-robot me-1"></i> Ask AI Tutor
            </a>
        </div>
    </div>
</div>

<!-- Navigation Tabs -->
<ul class="nav nav-pills gap-2 mb-4 p-2 glass-card" style="background: rgba(255,255,255,0.65);">
    <li class="nav-item">
        <a class="nav-link rounded-pill fw-bold <%= activeTab === 'materials' ? 'active bg-success' : 'text-dark' %>" href="/student/classes/<%= cls.id %>?tab=materials">
            <i class="bi bi-folder me-1"></i> Materials (<%= materials.length %>)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill fw-bold <%= activeTab === 'activities' ? 'active bg-success' : 'text-dark' %>" href="/student/classes/<%= cls.id %>?tab=activities">
            <i class="bi bi-pencil-square me-1"></i> Activities (<%= activities.length %>)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill fw-bold <%= activeTab === 'quizzes' ? 'active bg-success' : 'text-dark' %>" href="/student/classes/<%= cls.id %>?tab=quizzes">
            <i class="bi bi-card-checklist me-1"></i> Quizzes (<%= quizzes.length %>)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill fw-bold <%= activeTab === 'announcements' ? 'active bg-success' : 'text-dark' %>" href="/student/classes/<%= cls.id %>?tab=announcements">
            <i class="bi bi-megaphone me-1"></i> Bulletins (<%= announcements.length %>)
        </a>
    </li>
</ul>

<!-- TAB CONTENT -->
<% if (activeTab === 'materials') { %>
    <div class="d-flex justify-content-end mb-3">
        <%- include('../partials/view-toggle', { scope: 'student-class-materials', label: 'class materials' }) %>
    </div>
    <div class="row g-3" data-view-cards="student-class-materials">
        <% if (materials.length === 0) { %>
            <div class="col-12">
                <div class="glass-card p-5 text-center text-muted">
                    <i class="bi bi-folder2-open fs-2 text-success d-block mb-2"></i>
                    <h6>No Learning Materials Posted Yet</h6>
                    <p class="small">Your teacher has not uploaded materials for this section yet.</p>
                </div>
            </div>
        <% } %>

        <% materials.forEach(m => { %>
            <div class="col-md-6 col-lg-4">
                <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge-emerald"><%= m.subject %></span>
                            <span class="small text-muted font-monospace"><%= m.file_size || '' %></span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1"><%= m.title %></h5>
                        <p class="small text-muted mb-3"><%= m.description || 'Classroom study file.' %></p>
                    </div>
                    <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                        <span class="small text-muted"><%= new Date(m.posted_at).toLocaleDateString() %></span>
                        <div class="d-flex gap-2">
                            <% if (m.source === 'ai_lesson' && m.lesson_content) { %>
                                <button type="button" class="btn btn-sm btn-liquid-primary lesson-viewer" data-lesson="<%= encodeURIComponent(m.lesson_content) %>" data-lesson-title="<%= m.title %>">
                                    <i class="bi bi-easel me-1"></i> View Slides
                                </button>
                            <% } %>
                            <% if (m.file_path) { %>
                                <a href="<%= m.file_path %>" target="_blank" class="btn btn-sm btn-glass">
                                    <i class="bi bi-download me-1"></i> View / Download
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <% if (materials.length > 0) { %>
    <div class="glass-table-container d-none" data-view-table="student-class-materials">
        <div class="table-responsive">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Subject</th>
                        <th scope="col">Posted</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% materials.forEach(m => { %>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark"><%= m.title %></div>
                                <div class="small text-muted"><%= m.description || 'Classroom study file.' %> <% if (m.file_size) { %>&bull; <%= m.file_size %><% } %></div>
                            </td>
                            <td><span class="badge-emerald"><%= m.subject %></span></td>
                            <td class="small text-muted"><%= m.posted_at ? new Date(m.posted_at).toLocaleDateString() : 'N/A' %></td>
                            <td>
                                <div class="d-flex gap-1 justify-content-end flex-wrap">
                                    <% if (m.source === 'ai_lesson' && m.lesson_content) { %>
                                        <button type="button" class="btn btn-sm btn-liquid-primary lesson-viewer" data-lesson="<%= encodeURIComponent(m.lesson_content) %>" data-lesson-title="<%= m.title %>">
                                            <i class="bi bi-easel me-1"></i> Slides
                                        </button>
                                    <% } %>
                                    <% if (m.file_path) { %>
                                        <a href="<%= m.file_path %>" target="_blank" class="btn btn-sm btn-glass">
                                            <i class="bi bi-download me-1"></i> View
                                        </a>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

<% } else if (activeTab === 'activities') { %>
    <div class="d-flex justify-content-end mb-3">
        <%- include('../partials/view-toggle', { scope: 'student-class-activities', label: 'class activities' }) %>
    </div>
    <div class="row g-3" data-view-cards="student-class-activities">
        <% if (activities.length === 0) { %>
            <div class="col-12">
                <div class="glass-card p-5 text-center text-muted">
                    <i class="bi bi-clipboard-check fs-2 text-success d-block mb-2"></i>
                    <h6>No Activities Assigned Yet</h6>
                    <p class="small">Check back later for class tasks or homework.</p>
                </div>
            </div>
        <% } %>

        <% activities.forEach(act => { %>
            <div class="col-md-6 col-lg-4">
                <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-1">
                            <span class="badge-amber"><%= act.points %> Max Points</span>
                            <span class="small <%= act.due_date && new Date(act.due_date) < new Date() && act.submission_status !== 'graded' ? 'text-danger fw-bold' : 'text-muted' %>">Due: <%= act.due_date ? new Date(act.due_date).toLocaleDateString() : 'None' %><% if (act.due_date && new Date(act.due_date) < new Date() && act.submission_status !== 'graded') { %> <span class="badge-red" style="font-size:0.72rem;">Overdue</span><% } %></span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2"><%= act.title %></h5>
                        <p class="small text-secondary mb-3"><%= act.instructions || 'Review task details upon submission.' %></p>
                    </div>
                    <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                        <% if (act.submission_status === 'graded') { %>
                            <span class="badge-emerald"><i class="bi bi-check2-circle me-1"></i>Score: <%= act.score %>/<%= act.points %></span>
                        <% } else if (act.submission_status === 'submitted') { %>
                            <span class="badge-amber"><i class="bi bi-clock me-1"></i>Under Review</span>
                        <% } else { %>
                            <span class="badge-gray">Not Submitted</span>
                        <% } %>

                        <a href="/student/activities/<%= act.id %>/classes/<%= cls.id %>/submit" class="btn btn-sm btn-liquid-primary">
                            <%= act.submission_status ? 'View Work' : 'Submit Work &rarr;' %>
                        </a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <% if (activities.length > 0) { %>
    <div class="glass-table-container d-none" data-view-table="student-class-activities">
        <div class="table-responsive">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th scope="col">Activity</th>
                        <th scope="col">Points</th>
                        <th scope="col">Due</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% activities.forEach(act => { %>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark"><%= act.title %></div>
                                <div class="small text-muted"><%= act.instructions || 'Review task details upon submission.' %></div>
                            </td>
                            <td><span class="badge-amber"><%= act.points %> Pts</span></td>
                            <td class="small <%= act.due_date && new Date(act.due_date) < new Date() && act.submission_status !== 'graded' ? 'text-danger fw-bold' : 'text-muted' %>"><%= act.due_date ? new Date(act.due_date).toLocaleDateString() : 'None' %><% if (act.due_date && new Date(act.due_date) < new Date() && act.submission_status !== 'graded') { %> <span class="badge-red" style="font-size:0.72rem;">Overdue</span><% } %></td>
                            <td>
                                <% if (act.submission_status === 'graded') { %>
                                    <span class="badge-emerald">Score: <%= act.score %>/<%= act.points %></span>
                                <% } else if (act.submission_status === 'submitted') { %>
                                    <span class="badge-amber">Under Review</span>
                                <% } else { %>
                                    <span class="badge-gray">Not Submitted</span>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <a href="/student/activities/<%= act.id %>/classes/<%= cls.id %>/submit" class="btn btn-sm btn-liquid-primary">
                                    <%= act.submission_status ? 'View Work' : 'Submit Work &rarr;' %>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

<% } else if (activeTab === 'quizzes') { %>
    <div class="d-flex justify-content-end mb-3">
        <%- include('../partials/view-toggle', { scope: 'student-class-quizzes', label: 'class quizzes' }) %>
    </div>
    <div class="row g-3" data-view-cards="student-class-quizzes">
        <% if (quizzes.length === 0) { %>
            <div class="col-12">
                <div class="glass-card p-5 text-center text-muted">
                    <i class="bi bi-card-checklist fs-2 text-warning d-block mb-2"></i>
                    <h6>No Online Quizzes Scheduled Yet</h6>
                    <p class="small">Your teacher has not published active quizzes for this section.</p>
                </div>
            </div>
        <% } %>

        <% quizzes.forEach(q => { %>
            <div class="col-md-6 col-lg-4">
                <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge-emerald"><%= q.total_questions %> Questions</span>
                            <span class="badge-amber"><%= q.time_limit_minutes %> Mins</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1"><%= q.title %></h5>
                        <p class="small text-muted mb-1"><%= q.description || 'Course assessment.' %></p>
                        <% const _qNow = new Date(); const _qStart = q.start_time ? new Date(q.start_time) : null; const _qEnd = q.end_time ? new Date(q.end_time) : null; const _qNotOpen = !!(_qStart && _qStart > _qNow); const _qClosed = !!(_qEnd && _qEnd < _qNow); %>
                        <% if (_qStart || _qEnd) { %>
                            <p class="small text-muted mb-1">Open: <%= _qStart ? _qStart.toLocaleString() : 'Now' %> – <%= _qEnd ? _qEnd.toLocaleString() : 'No closing date' %></p>
                        <% } %>
                        <p class="small text-muted mb-3">One attempt only.</p>
                    </div>
                    <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                        <% if (q.attempt_status === 'submitted' || q.attempt_status === 'graded') { %>
                            <div>
                                <div class="fw-bold text-success">Score: <%= q.score %>/<%= (q.max_score != null ? q.max_score : q.total_questions) %></div>
                                <span class="<%= q.passed ? 'badge-emerald' : 'badge bg-danger' %>"><%= q.passed ? 'PASSED' : 'NEEDS REVIEW' %></span>
                            </div>
                            <a href="/student/quizzes/<%= q.attempt_id %>/result" class="btn btn-sm btn-glass text-success fw-bold">
                                Review &rarr;
                            </a>
                        <% } else if (_qNotOpen || _qClosed) { %>
                            <span class="badge-gray">Closed</span>
                            <button type="button" class="btn btn-sm btn-glass" disabled><%= _qNotOpen ? 'Not open yet' : 'Window closed' %></button>
                        <% } else { %>
                            <span class="badge-amber">Ready to Take</span>
                            <a href="/student/quizzes/<%= q.id %>/take" class="btn btn-sm btn-liquid-primary">
                                Start Quiz &rarr;
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <% if (quizzes.length > 0) { %>
    <div class="glass-table-container d-none" data-view-table="student-class-quizzes">
        <div class="table-responsive">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th scope="col">Quiz</th>
                        <th scope="col">Items</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% quizzes.forEach(q => { %>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark"><%= q.title %></div>
                                <div class="small text-muted"><%= q.description || 'Course assessment.' %> &bull; <%= q.total_questions %> questions, <%= q.time_limit_minutes %> mins &bull; One attempt only.<% if (q.start_time || q.end_time) { %> Open: <%= q.start_time ? new Date(q.start_time).toLocaleString() : 'Now' %> – <%= q.end_time ? new Date(q.end_time).toLocaleString() : 'No closing date' %>.<% } %></div>
                            </td>
                            <td><span class="badge-emerald"><%= q.total_questions %></span></td>
                            <td>
                                <% if (q.attempt_status === 'submitted' || q.attempt_status === 'graded') { %>
                                    <div class="fw-bold text-success small">Score: <%= q.score %>/<%= (q.max_score != null ? q.max_score : q.total_questions) %></div>
                                    <span class="<%= q.passed ? 'badge-emerald' : 'badge bg-danger' %>"><%= q.passed ? 'PASSED' : 'NEEDS REVIEW' %></span>
                                <% } else { %>
                                    <% const _tNow = new Date(); const _tStart = q.start_time ? new Date(q.start_time) : null; const _tEnd = q.end_time ? new Date(q.end_time) : null; %>
                                    <% if ((_tStart && _tStart > _tNow) || (_tEnd && _tEnd < _tNow)) { %>
                                        <span class="badge-gray">Closed</span>
                                    <% } else { %>
                                        <span class="badge-amber">Ready to Take</span>
                                    <% } %>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <% if (q.attempt_status === 'submitted' || q.attempt_status === 'graded') { %>
                                    <a href="/student/quizzes/<%= q.attempt_id %>/result" class="btn btn-sm btn-glass text-success fw-bold">Review &rarr;</a>
                                <% } else { %>
                                    <% const _bNow = new Date(); const _bStart = q.start_time ? new Date(q.start_time) : null; const _bEnd = q.end_time ? new Date(q.end_time) : null; %>
                                    <% if ((_bStart && _bStart > _bNow) || (_bEnd && _bEnd < _bNow)) { %>
                                        <button type="button" class="btn btn-sm btn-glass" disabled>Closed</button>
                                    <% } else { %>
                                        <a href="/student/quizzes/<%= q.id %>/take" class="btn btn-sm btn-liquid-primary">Start Quiz &rarr;</a>
                                    <% } %>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

<% } else if (activeTab === 'announcements') { %>
    <div class="d-flex flex-column gap-3">
        <% if (announcements.length === 0) { %>
            <div class="glass-card p-5 text-center text-muted">
                <i class="bi bi-megaphone fs-2 text-success d-block mb-2"></i>
                <h6>No Bulletins Posted Yet</h6>
                <p class="small">Check back later for teacher updates and class notices.</p>
            </div>
        <% } %>

        <% announcements.forEach(a => { %>
            <div class="glass-card p-4 <%= a.is_pinned ? 'border-start border-4 border-warning' : '' %>">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <% if (a.is_pinned) { %>
                            <span class="badge-amber"><i class="bi bi-pin-angle-fill me-1"></i>PINNED</span>
                        <% } %>
                        <h5 class="fw-bold text-dark mb-0"><%= a.title %></h5>
                    </div>
                    <span class="small text-muted"><%= new Date(a.created_at).toLocaleString() %></span>
                </div>
                <p class="small text-secondary mb-0" style="white-space: pre-wrap;"><%= a.message %></p>
            </div>
        <% }) %>
    </div>
<% } %>

<!-- Shared AI lesson slide viewer (projection bullets only; speaker notes stay teacher-only) -->
<div class="modal fade modal-glass" id="studentLessonModal" tabindex="-1" aria-labelledby="studentLessonTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-easel text-success me-2"></i><span id="studentLessonTitle">Lesson Slides</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close lesson slides"></button>
            </div>
            <div class="modal-body">
                <div id="studentLessonSlides" class="d-flex flex-column gap-3" aria-live="polite"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="/js/student-lesson-viewer.js"></script>
