<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge-emerald"><i class="bi bi-cpu me-1"></i>Ollama Qwen 2.5 7B</span>
            <span class="badge-amber">Personalized Study Tutor</span>
        </div>
        <h2 class="fw-bold mb-0 text-dark">AI Study Buddy & Tutor</h2>
        <p class="text-muted small mb-0">Ask questions about your subjects, practice exercises, or clarify tough concepts.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <select id="subjectSelect" class="glass-input py-1 px-3 fw-semibold text-dark" style="width: 170px;">
            <option value="English">English</option>
            <option value="Mathematics">Mathematics</option>
            <option value="Science">Science</option>
            <option value="Araling Panlipunan">Araling Panlipunan</option>
            <option value="General" selected>General</option>
        </select>
        <button type="button" id="clearHistoryBtn" class="btn btn-glass btn-sm text-danger" title="Clear Chat History">
            <i class="bi bi-trash3"></i>
        </button>
    </div>
</div>

<!-- Suggestion Chips Bar -->
<div class="d-flex gap-2 mb-3 overflow-x-auto pb-2">
    <button type="button" class="btn btn-sm btn-glass rounded-pill suggestion-chip" data-prompt="Explain the difference between a simile and a metaphor with examples.">
        <i class="bi bi-lightbulb text-warning me-1"></i> Simile vs Metaphor
    </button>
    <button type="button" class="btn btn-sm btn-glass rounded-pill suggestion-chip" data-prompt="How does photosynthesis work in plants?">
        <i class="bi bi-lightbulb text-warning me-1"></i> Photosynthesis
    </button>
    <button type="button" class="btn btn-sm btn-glass rounded-pill suggestion-chip" data-prompt="Give me a step-by-step guide to solving quadratic equations.">
        <i class="bi bi-lightbulb text-warning me-1"></i> Quadratic Formula
    </button>
    <button type="button" class="btn btn-sm btn-glass rounded-pill suggestion-chip" data-prompt="What are the five core elements of a short story?">
        <i class="bi bi-lightbulb text-warning me-1"></i> Short Story Elements
    </button>
</div>

<!-- Chat Messages Container -->
<div class="glass-card p-4 mb-3 d-flex flex-column" style="height: 520px;">
    <div id="chatMessages" class="flex-grow-1 overflow-y-auto pe-2" style="scroll-behavior: smooth;">
        <div class="text-center text-muted p-4">
            <div class="user-avatar-initials mx-auto mb-2" style="width: 56px; height: 56px; font-size: 1.5rem; background: linear-gradient(135deg, var(--zahs-emerald-primary), var(--zahs-amber));">
                <i class="bi bi-robot"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">Hello, Zeferinian!</h5>
            <p class="small mb-0" style="max-width: 420px; margin: 0 auto;">
                I am your 24/7 AI Study Tutor. Pick a suggestion above or ask any question below to begin studying.
            </p>
        </div>
    </div>

    <!-- Message Input Bar -->
    <form id="chatForm" class="d-flex gap-2 pt-3 border-top" style="border-color: rgba(16,185,129,0.15) !important;">
        <input type="text" id="chatInput" class="glass-input py-2 px-3 flex-grow-1" placeholder="Type your question here (e.g. Explain photosynthesis)..." required autocomplete="off">
        <button type="submit" id="sendBtn" class="btn btn-liquid-primary px-4">
            <i class="bi bi-send-fill me-1"></i> Send
        </button>
    </form>
</div>

<script src="/js/chatbot.js"></script>
