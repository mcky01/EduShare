<!-- ZAHS Glass chatbot: slim header + collapsible suggestions + tall panel + pill composer -->
<style>
    .chat-material-bar { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; padding: 0.55rem 1.1rem; border-top: 1px solid rgba(16, 185, 129, 0.12); background: rgba(236, 253, 245, 0.6); font-size: 0.82rem; }
    .chat-material-bar .material-bar-label { font-weight: 700; color: var(--zahs-emerald-deep); }
    .material-chip { display: inline-flex; align-items: center; gap: 0.35rem; max-width: 100%; background: rgba(16, 185, 129, 0.14); border: 1px solid rgba(16, 185, 129, 0.35); color: var(--zahs-emerald-deep); border-radius: 999px; padding: 0.2rem 0.35rem 0.2rem 0.7rem; font-weight: 700; font-size: 0.78rem; }
    .material-chip .material-chip-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px; }
    .material-chip button { border: 0; background: transparent; color: inherit; line-height: 1; padding: 0.1rem 0.35rem; border-radius: 50%; cursor: pointer; }
    .material-chip button:hover { background: rgba(6, 56, 30, 0.12); }
    .material-chip button:focus-visible, .material-suggest-chip:focus-visible { outline: 3px solid var(--zahs-amber); outline-offset: 2px; }
    .material-suggest-chip { display: inline-flex; align-items: center; gap: 0.35rem; background: rgba(245, 158, 11, 0.13); border: 1px solid rgba(245, 158, 11, 0.4); color: var(--zahs-amber-gold); border-radius: 999px; padding: 0.3rem 0.8rem; font-weight: 700; font-size: 0.8rem; cursor: pointer; }
    .material-suggest-chip:hover { background: rgba(245, 158, 11, 0.22); }
    .material-item { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.75rem 0.9rem; border-radius: 14px; background: rgba(255, 255, 255, 0.7); border: 1px solid rgba(16, 185, 129, 0.18); margin-bottom: 0.6rem; }
    .material-item.is-selected { border-color: var(--zahs-emerald-primary); background: rgba(16, 185, 129, 0.09); }
    .material-item.is-disabled { opacity: 0.75; }
    .material-item label { cursor: pointer; flex: 1 1 auto; min-width: 0; }
    .material-item.is-disabled label { cursor: default; }
    .material-item .form-check-input { width: 1.15rem; height: 1.15rem; margin-top: 0.2rem; flex-shrink: 0; }
    .material-item .material-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    @media (max-width: 768px) { .material-chip .material-chip-title { max-width: 130px; } }
</style>

<div class="chat-top d-flex align-items-center gap-2 gap-md-3 mb-3 flex-wrap">
    <div class="chat-identity d-flex align-items-center gap-2 min-w-0">
        <div class="chat-avatar chat-avatar-ai chat-identity-avatar" aria-hidden="true">
            <i class="bi bi-robot"></i>
        </div>
        <div class="min-w-0">
            <h2 class="fw-bold text-dark mb-0 text-truncate chat-identity-title">AI Study Tutor</h2>
            <div class="d-flex align-items-center gap-2">
                <span id="chatStatusPill" class="badge-gray" role="status" aria-live="polite">
                    <span class="chat-status-dot" aria-hidden="true"></span><span id="chatStatusText">Connecting…</span>
                </span>
            </div>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 ms-auto flex-shrink-0">
        <label class="visually-hidden" for="subjectSelect">Study subject</label>
        <select id="subjectSelect" class="glass-input py-2 px-3 fw-semibold text-dark" aria-label="Study subject">
            <% const _subs = typeof subjects !== 'undefined' && subjects.length ? subjects : ['English', 'Mathematics', 'Science', 'Araling Panlipunan', 'Filipino', 'General']; %>
            <% _subs.forEach(s => { %>
                <option value="<%= s %>" <%= s === 'General' ? 'selected' : '' %>><%= s %></option>
            <% }) %>
        </select>
        <button type="button" id="materialsBtn" class="btn btn-glass btn-sm" title="Pick your teachers' materials as the basis for the tutor's answers" aria-haspopup="dialog" aria-controls="materialsModal">
            <i class="bi bi-folder2-open" aria-hidden="true"></i><span class="ms-1 fw-bold">Materials</span>
            <span id="materialsCount" class="badge rounded-pill bg-success ms-1 d-none" aria-live="polite">0</span>
        </button>
        <button type="button" id="exportChatBtn" class="btn btn-glass btn-sm" title="Download this conversation as a study note (.md)">
            <i class="bi bi-download" aria-hidden="true"></i><span class="visually-hidden">Export chat</span>
        </button>
        <button type="button" id="clearHistoryBtn" class="btn btn-glass btn-sm text-danger" title="Clear chat history">
            <i class="bi bi-trash3" aria-hidden="true"></i><span class="visually-hidden">Clear chat history</span>
        </button>
    </div>
</div>

<!-- Suggestions: open row on desktop, collapsed toggle on mobile -->
<div class="chat-suggest mb-3">
    <button type="button" id="suggestToggle" class="btn btn-sm btn-glass rounded-pill" aria-expanded="false" aria-controls="suggestRow">
        <i class="bi bi-stars text-warning me-1" aria-hidden="true"></i>Suggestions
        <i class="bi bi-chevron-down ms-1 suggest-caret" aria-hidden="true"></i>
    </button>
    <div id="suggestRow" class="gap-2 flex-wrap pt-2">
        <button type="button" class="btn btn-sm btn-glass rounded-pill suggestion-chip" data-subject="English" data-prompt="Explain the difference between a simile and a metaphor with examples.">
            <i class="bi bi-lightbulb text-warning me-1"></i>Simile vs Metaphor
        </button>
        <button type="button" class="btn btn-sm btn-glass rounded-pill suggestion-chip" data-subject="Science" data-prompt="How does photosynthesis work in plants? Explain it simply with the chemical equation.">
            <i class="bi bi-lightbulb text-warning me-1"></i>Photosynthesis
        </button>
        <button type="button" class="btn btn-sm btn-glass rounded-pill suggestion-chip" data-subject="Mathematics" data-prompt="Give me a step-by-step guide to solving quadratic equations using the quadratic formula.">
            <i class="bi bi-lightbulb text-warning me-1"></i>Quadratic Formula
        </button>
        <button type="button" class="btn btn-sm btn-glass rounded-pill suggestion-chip" data-subject="English" data-prompt="What are the five core elements of a short story? Give one example for each.">
            <i class="bi bi-lightbulb text-warning me-1"></i>Short Story Elements
        </button>
        <button type="button" class="btn btn-sm btn-glass rounded-pill suggestion-chip" data-subject="Araling Panlipunan" data-prompt="Quiz me: ask me 3 review questions about Philippine history, one at a time.">
            <i class="bi bi-lightbulb text-warning me-1"></i>Quiz Me
        </button>
        <button type="button" class="btn btn-sm btn-glass rounded-pill suggestion-chip" data-subject="General" data-prompt="Help me make a 30-minute study plan for my exams tonight.">
            <i class="bi bi-lightbulb text-warning me-1"></i>Study Plan
        </button>
    </div>
</div>

<!-- Chat panel -->
<div class="glass-card chat-panel d-flex flex-column mb-3" aria-label="AI Study Tutor conversation" data-grade="<%= typeof gradeLevel !== 'undefined' ? gradeLevel : 'Grade 7' %>">
    <div id="chatLiveRegion" class="visually-hidden" aria-live="polite"></div>

    <div id="chatMessages" class="chat-messages flex-grow-1 overflow-y-auto" tabindex="0" aria-label="Conversation messages">
        <div class="chat-empty text-center p-4" id="chatEmptyState">
            <div class="user-avatar-initials mx-auto mb-3 chat-empty-avatar">
                <i class="bi bi-robot" aria-hidden="true"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">What can I help you study today?</h5>
            <p class="small text-muted mb-0" style="max-width: 460px; margin: 0 auto;">
                Ask about any subject — I'll explain, quiz you, or help you plan.
            </p>
            <!-- Suggested teacher materials for the current subject (filled by chatbot.js) -->
            <div id="materialSuggest" class="mt-3 d-none" style="max-width: 560px; margin: 0 auto;">
                <div class="small fw-bold text-dark mb-2"><i class="bi bi-folder2-open text-success me-1" aria-hidden="true"></i><span id="materialSuggestLabel">Suggested from your teachers:</span></div>
                <div id="materialSuggestRow" class="d-flex flex-wrap justify-content-center gap-2"></div>
            </div>
        </div>
    </div>

    <div id="chatTypingBar" class="chat-typing-bar d-none" role="status" aria-live="polite">
        <span class="typing-dots" aria-hidden="true"><span></span><span></span><span></span></span>
        <span id="chatTypingText">Tutor is thinking…</span>
        <button type="button" id="stopStreamBtn" class="btn btn-sm btn-glass text-danger ms-auto">
            <i class="bi bi-stop-circle me-1" aria-hidden="true"></i>Stop
        </button>
    </div>

    <!-- Selected study materials (basis for answers) -->
    <div id="materialBar" class="chat-material-bar d-none" role="group" aria-label="Selected study materials">
        <div class="material-bar-head">
            <span class="material-bar-label"><i class="bi bi-journal-bookmark-fill" aria-hidden="true"></i>Study basis</span>
            <span class="material-bar-hint">The tutor answers using these teacher materials</span>
            <button type="button" id="materialBarClear" class="material-bar-clear"><i class="bi bi-x-circle me-1" aria-hidden="true"></i>Clear all</button>
        </div>
        <div id="materialChips" class="material-chips"></div>
    </div>

    <!-- Pill composer: textarea + round send share one box -->
    <form id="chatForm" class="chat-composer" autocomplete="off">
        <label class="visually-hidden" for="chatInput">Type your question</label>
        <div class="chat-composer-pill">
            <textarea id="chatInput" class="chat-input" rows="1"
                placeholder="Message AI Study Tutor…"
                maxlength="2000" aria-describedby="chatComposerHint"></textarea>
            <button type="submit" id="sendBtn" class="btn btn-liquid-primary chat-send-btn" aria-label="Send message">
                <i class="bi bi-arrow-up" aria-hidden="true"></i>
            </button>
        </div>
        <div class="chat-composer-meta">
            <span id="chatCharCount" class="chat-char-count" aria-hidden="true">0 / 2000</span>
        </div>
        <div id="chatComposerHint" class="visually-hidden">Press Enter to send, Shift plus Enter for a new line. Maximum 2000 characters.</div>
    </form>
</div>

<script src="/js/chatbot.js?v=20260930"></script>

<!-- Materials picker -->
<div class="modal fade modal-glass" id="materialsModal" tabindex="-1" aria-labelledby="materialsModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="materialsModalTitle"><i class="bi bi-folder2-open text-success me-2" aria-hidden="true"></i>Class Materials</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close materials"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">
                    These were posted by your teachers. Tick up to <strong id="materialsMax">3</strong> and the AI Tutor will use them as the basis for its answers.
                    Materials matching your selected subject are marked <span class="badge-amber">Suggested</span>.
                </p>
                <label class="visually-hidden" for="materialsSearch">Search materials</label>
                <input type="search" id="materialsSearch" class="glass-input py-2 mb-3" placeholder="Search by title, subject, or class…">
                <div id="materialsList" role="status" aria-live="polite">
                    <div class="text-center text-muted p-4 small">Loading class materials…</div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <span class="small text-muted" id="materialsSelectedText">0 selected</span>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-glass" id="materialsClearBtn">Clear selection</button>
                    <button type="button" class="btn btn-liquid-primary" data-bs-dismiss="modal">Done</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Clear history confirmation: scoped per subject or everything -->
<div class="modal fade" id="clearHistoryModal" tabindex="-1" aria-labelledby="clearHistoryTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <i class="bi bi-trash3 fs-1 text-danger d-block mb-3" aria-hidden="true"></i>
                <h5 class="fw-bold mb-2" id="clearHistoryTitle">Clear chat history?</h5>
                <p class="small text-muted mb-4">Saved exchanges are removed permanently. Choose what to clear.</p>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-liquid-primary" id="clearSubjectBtn">Clear <span id="clearSubjectName">this subject</span> only</button>
                    <button type="button" class="btn btn-glass text-danger" id="clearAllBtn">Clear everything</button>
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Keep my chats</button>
                </div>
            </div>
        </div>
    </div>
</div>