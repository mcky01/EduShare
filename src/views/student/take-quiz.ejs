<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= quiz.title %> | EduShare 2.0 Quiz Runner</title>
    <link rel="icon" type="image/png" href="/images/zahs-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/liquid-glass.css">
</head>
<body class="p-3 p-md-4" style="background: radial-gradient(circle at 10% 10%, rgba(13,82,44,0.18) 0%, transparent 40%), radial-gradient(circle at 90% 90%, rgba(245,158,11,0.12) 0%, transparent 40%), #f2f7f4;">

<div class="container-fluid" style="max-width: 1140px;" id="quizRunnerContainer"
     data-quiz-id="<%= quiz.id %>"
     data-class-id="<%= classInfo.class_id %>"
     data-time-limit="<%= quiz.time_limit_minutes %>">

    <!-- Top Runner Bar -->
    <div class="glass-card p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <img src="/images/zahs-logo.png" alt="ZAHS Logo" style="width: 44px; height: 44px; object-fit: contain;">
            <div>
                <h5 class="fw-bold mb-0 text-dark"><%= quiz.title %></h5>
                <span class="small text-muted"><%= classInfo.class_name %> &bull; Question <span id="currentQuestionDisplay">1</span> of <%= questions.length %></span>
            </div>
        </div>

        <!-- Live Countdown Timer -->
        <div class="d-flex align-items-center gap-2 p-2 px-3 rounded-pill glass-card" style="background: rgba(255,255,255,0.9); border: 1.5px solid var(--zahs-amber);">
            <i class="bi bi-clock-history fs-5 text-warning"></i>
            <div>
                <div class="small fw-bold text-muted" style="font-size: 0.68rem; line-height: 1;">TIME REMAINING</div>
                <div id="quizTimerDisplay" class="fw-bold font-monospace fs-5 text-dark" style="line-height: 1.1;">--:--</div>
            </div>
        </div>
    </div>

    <!-- Quiz Main Body Grid -->
    <div class="row g-4">
        <!-- Center/Left: Current Question Card -->
        <div class="col-lg-8">
            <div class="glass-card p-4 p-md-5 h-100 d-flex flex-column justify-content-between">
                <div>
                    <% questions.forEach((q, idx) => { %>
                        <div class="question-card" data-question-id="<%= q.id %>" data-question-type="<%= q.question_type %>" style="<%= idx === 0 ? '' : 'display: none;' %>">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge-emerald">Question <%= idx + 1 %> of <%= questions.length %></span>
                                <span class="badge-amber text-capitalize"><%= q.question_type.replace('_', ' ') %> &bull; <%= q.points %> Pt</span>
                            </div>

                            <h4 class="fw-bold text-dark mb-4" style="line-height: 1.5;"><%= q.question_text %></h4>

                            <!-- Multiple Choice / True-False Options -->
                            <% if (q.question_type === 'multiple_choice' || q.question_type === 'true_false') { %>
                                <div class="d-flex flex-column gap-3 mb-4">
                                    <% q.options.forEach((opt, optIdx) => { %>
                                        <label class="p-3 rounded-4 glass-card d-flex align-items-center gap-3 cursor-pointer" style="background: rgba(255,255,255,0.7); cursor: pointer; transition: all 0.2s ease;">
                                            <input type="radio" name="question_<%= q.id %>" class="form-check-input quiz-option-input mt-0" 
                                                   value="<%= opt.id %>" data-question-id="<%= q.id %>" style="width: 22px; height: 22px; cursor: pointer;">
                                            <span class="fw-semibold text-dark fs-6"><%= opt.option_text %></span>
                                        </label>
                                    <% }) %>
                                </div>

                            <% } else if (q.question_type === 'identification') { %>
                                <div class="mb-4">
                                    <label class="form-label small fw-bold text-muted">Type your answer below:</label>
                                    <input type="text" class="glass-input fs-5 quiz-ident-input" data-question-id="<%= q.id %>" placeholder="Type your answer here..." autocomplete="off">
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>

                <!-- Navigation Controls -->
                <div class="border-top pt-4 mt-4 d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-color: rgba(16,185,129,0.15) !important;">
                    <div class="d-flex gap-2">
                        <button type="button" id="prevQuestionBtn" class="btn btn-glass" disabled>
                            <i class="bi bi-chevron-left me-1"></i> Previous
                        </button>
                        <button type="button" id="flagQuestionBtn" class="btn btn-glass">
                            <i class="bi bi-flag me-1"></i> Flag for Review
                        </button>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" id="nextQuestionBtn" class="btn btn-liquid-primary">
                            Next <i class="bi bi-chevron-right ms-1"></i>
                        </button>
                        <button type="button" id="submitQuizBtn" class="btn btn-liquid-amber px-4 shadow" style="display: none;">
                            <i class="bi bi-check2-circle me-1"></i> Submit Final Answers
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Question Palette Navigator -->
        <div class="col-lg-4">
            <div class="glass-card p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-grid-3x3 text-success me-2"></i>Question Palette</h6>
                <div class="d-flex flex-wrap mb-4" id="questionNavigatorGrid">
                    <!-- Rendered by quiz-runner.js -->
                </div>

                <!-- Legend -->
                <div class="border-top pt-3 small text-muted">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="rounded-circle" style="width: 14px; height: 14px; background: #0d522c; display: inline-block;"></span>
                        <span>Answered</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="rounded-circle" style="width: 14px; height: 14px; background: #f59e0b; display: inline-block;"></span>
                        <span>Flagged for Review</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="rounded-circle border" style="width: 14px; height: 14px; background: rgba(255,255,255,0.7); display: inline-block;"></span>
                        <span>Unanswered</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/quiz-runner.js"></script>

</body>
</html>
