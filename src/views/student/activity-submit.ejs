<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/student/classes/<%= cls.id %>?tab=activities" class="small text-success text-decoration-none fw-bold">&larr; Back to <%= cls.class_name %></a>
</div>

<div class="row g-4">
    <!-- Activity Instructions -->
    <div class="col-lg-6">
        <div class="glass-card p-4 p-md-5 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge-emerald"><%= cls.subject %></span>
                <span class="badge-amber"><%= activity.points %> Points</span>
            </div>

            <h3 class="fw-bold text-dark mb-2"><%= activity.title %></h3>
            <div class="small text-muted mb-4">
                Due Date: <strong><%= activity.due_date ? new Date(activity.due_date).toLocaleDateString() : 'No deadline' %></strong>
                <% const _due = activity.due_date ? new Date(activity.due_date) : null; const _over = _due && _due < new Date() && (!submission || submission.status !== 'graded'); %>
                <% if (_over) { %><span class="badge-red ms-2" style="font-size:0.72rem;"><i class="bi bi-exclamation-triangle me-1"></i>Overdue — submit ASAP</span><% } %>
                <% if (submission) { %><span class="badge <%= submission.status === 'graded' ? 'badge-emerald' : 'badge-amber' %> ms-2"><%= submission.status === 'graded' ? 'Graded' : 'Submitted — resubmit allowed' %></span><% } %>
            </div>

            <h6 class="fw-bold text-dark">Instructions:</h6>
            <div class="small text-secondary mb-4" style="line-height: 1.7; white-space: pre-wrap;"><%= activity.instructions || 'Follow classroom guidance.' %></div>

            <% if (activity.file_path) { %>
                <div class="p-3 rounded-4" style="background: rgba(255,255,255,0.7); border: 1px solid rgba(16,185,129,0.2);">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-dark small">Teacher Attachment</div>
                            <div class="small text-muted"><%= activity.file_size || '' %></div>
                        </div>
                        <a href="<%= activity.file_path %>" target="_blank" class="btn btn-sm btn-liquid-primary">
                            <i class="bi bi-download me-1"></i> Download File
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Student Submission Form & Feedback -->
    <div class="col-lg-6">
        <div class="glass-card p-4 p-md-5 h-100 d-flex flex-column justify-content-between">
            <div>
                <h4 class="fw-bold mb-3"><i class="bi bi-cloud-arrow-up text-success me-2"></i>Your Submission</h4>

                <% if (submission && submission.status === 'graded') { %>
                    <!-- Graded Badge and Feedback Banner -->
                    <div class="p-4 rounded-4 mb-4 text-center" style="background: rgba(16,185,129,0.12); border: 1.5px solid var(--zahs-jade);">
                        <div class="text-uppercase small fw-bold text-success mb-1">Graded by Teacher</div>
                        <div class="display-5 fw-bold text-success mb-2 font-monospace"><%= submission.score %> <span class="fs-4 text-muted">/ <%= activity.points %></span></div>
                        <% if (submission.feedback) { %>
                            <div class="small text-dark p-2 rounded bg-white mt-2">
                                <strong class="text-success">Feedback:</strong> "<%= submission.feedback %>"
                            </div>
                        <% } %>
                    </div>
                <% } else if (submission) { %>
                    <div class="alert alert-warning rounded-4 small mb-4">
                        <i class="bi bi-clock-history me-1"></i> Your work was submitted on <strong><%= new Date(submission.submitted_at).toLocaleString() %></strong> and is currently awaiting teacher review. You may re-upload before the deadline.
                    </div>
                <% } %>

                <div id="activitySubmitError" class="alert alert-danger rounded-4 small d-none" role="alert" aria-live="assertive"></div>
                <form id="activitySubmitForm" action="/student/activities/<%= activity.id %>/classes/<%= cls.id %>/submit" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Upload Your File (PDF, DOCX, PPTX, XLSX, TXT, Image)</label>
                        <input type="file" id="submissionFileInput" name="submission_file" class="glass-input" accept=".pdf,.docx,.pptx,.xlsx,.txt,.jpg,.jpeg,.png,.gif,.webp" <%= submission ? '' : 'required' %> aria-describedby="submissionFileHint">
                        <div id="submissionFileHint" class="form-text small text-muted">Max 50 MB. Allowed: PDF, DOCX, PPTX, XLSX, TXT, JPG, PNG, GIF, WEBP.</div>
                        <% if (submission && submission.file_path) { %>
                            <div class="small text-muted mt-1">
                                Current file: <a href="<%= submission.file_path %>" target="_blank" class="text-success fw-bold">View Submitted File</a>
                            </div>
                        <% } %>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold">Student Note to Teacher (Optional)</label>
                        <textarea name="note" class="glass-input" rows="3" placeholder="Add any comments or reflection on your work..."><%= submission ? submission.note || '' : '' %></textarea>
                    </div>

                    <div class="progress d-none mb-3" id="activityUploadProgress" role="progressbar" aria-label="Upload progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" id="activityUploadBar" style="width: 0%">0%</div>
                    </div>
                    <button type="submit" id="activitySubmitBtn" class="btn btn-liquid-primary w-100 py-2 fs-6 shadow">
                        <i class="bi bi-check2-circle me-2"></i> <span id="activitySubmitLabel"><%= submission ? 'Update Submission' : 'Submit Activity' %></span>
                    </button>
                </form>
                <script src="/js/activity-submit.js"></script>
            </div>

        </div>
    </div>
</div>
