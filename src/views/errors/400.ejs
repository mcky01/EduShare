<div class="d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="glass-card p-4 p-md-5 text-center" style="max-width: 500px;">
        <div class="user-avatar-initials mx-auto mb-3" style="width: 72px; height: 72px; font-size: 1.8rem; background: linear-gradient(135deg, #f59e0b, #d97706);">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h2 class="fw-bold text-dark mb-2">400 - Bad Request</h2>
        <p class="text-muted small mb-4">
            <%= typeof message !== 'undefined' && message ? message : 'The request could not be understood. Please check your input and try again.' %>
        </p>
        <a href="/" class="btn btn-liquid-primary">
            <i class="bi bi-house me-1"></i> Return to Homepage
        </a>
    </div>
</div>
