<div class="auth-single-card">
    <!-- Brand header: big seal left, EduShare + school stacked right -->
    <div class="auth-brand-header">
        <div class="auth-brand-lockup">
            <img src="<%= school.logo || '/images/zahs-logo.png' %>" alt="ZAHS Logo" class="auth-brand-seal">
            <div class="auth-brand-text">
                <div class="fw-extrabold auth-brand-name">EduShare</div>
                <div class="auth-brand-school"><%= school.name %></div>
                <div class="auth-brand-motto">"<%= school.motto %>"</div>
            </div>
        </div>
    </div>

    <div class="auth-form-heading">
        <h3 class="fw-bold text-dark mb-0">Welcome Back</h3>
    </div>

    <!-- Inline Error Notice -->
    <% if (typeof loginError !== 'undefined' && loginError) { %>
    <div class="alert auth-alert-error d-flex align-items-start gap-2 py-2 px-3 mb-3" role="alert" aria-live="assertive">
        <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
        <div><%= loginError %></div>
    </div>
    <% } %>

    <!-- Client-side empty-field error (populated by /js/login.js) -->
    <div id="clientError" class="alert auth-alert-error d-flex align-items-start gap-2 py-2 px-3 mb-3 d-none" role="alert" aria-live="assertive">
        <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
        <div data-client-error-text></div>
    </div>

    <!-- Login Form -->
    <form action="/auth/login" method="POST" id="loginForm" data-has-error="<%= typeof loginError !== 'undefined' && loginError ? 'true' : 'false' %>" novalidate>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" name="returnTo" value="<%= typeof returnTo !== 'undefined' ? returnTo : '' %>">

        <!-- Credential Field -->
        <div class="auth-field">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label small fw-bold text-muted mb-0" id="credentialLabel" for="credentialInput">School ID or Email</label>
            </div>
            <div class="auth-input-group input-group">
                <span class="input-group-text">
                    <i class="bi bi-person" id="credentialIcon" aria-hidden="true"></i>
                </span>
                <input type="text" name="credential" id="credentialInput" class="form-control" placeholder="12-digit LRN, employee ID, or email" required autocomplete="username" value="<%= typeof credential !== 'undefined' ? credential : '' %>">
            </div>
        </div>

        <!-- Password Field -->
        <div class="auth-field">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label small fw-bold text-muted mb-0" for="passwordInput">Password</label>
                <span id="capsWarning" class="caps-warning-pill" aria-live="polite">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Caps Lock is ON
                </span>
            </div>
            <div class="auth-input-group input-group">
                <span class="input-group-text">
                    <i class="bi bi-lock" aria-hidden="true"></i>
                </span>
                <input type="password" name="password" id="passwordInput" class="form-control" placeholder="Enter your password" required autocomplete="current-password">
                <button type="button" class="btn-peek" id="passwordPeekBtn" aria-label="Show password" aria-pressed="false" title="Toggle password visibility">
                    <i class="bi bi-eye text-muted" id="passwordPeekIcon" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="submitBtn" class="btn btn-liquid-primary w-100 fs-6 auth-submit auth-submit-spaced">
            <span id="btnText">
                <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i> Sign In to EduShare
            </span>
            <span id="btnSpinner" class="d-none">
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                Signing in...
            </span>
        </button>
    </form>

    <p class="text-center small mt-2 mb-0"><a href="/auth/forgot-password">Forgot your password?</a></p>
    <p class="text-center small mt-3 mb-0">New here? <a href="/auth/register">Create an account</a></p>
</div>

<!-- Floating login guide -->
<button type="button" class="auth-help-fab" id="loginHelpFab" aria-label="How to sign in" aria-expanded="false" aria-controls="loginHelpPanel">
    <i class="bi bi-question-lg" aria-hidden="true"></i>
</button>
<div class="auth-help-panel d-none" id="loginHelpPanel" role="dialog" aria-label="How to sign in">
    <div class="auth-help-panel-head">
        <strong>How to sign in</strong>
        <button type="button" class="btn-close btn-close-sm" id="loginHelpCloseBtn" aria-label="Close sign-in help"></button>
    </div>
    <ol class="auth-help-steps">
        <li><strong>Type your school ID or email.</strong> <span class="text-muted">No role picker — the system detects your portal.</span></li>
        <li><strong>Students:</strong> <span class="text-muted">use your 12-digit LRN.</span></li>
        <li><strong>Teachers:</strong> <span class="text-muted">use your @zahs.edu.ph email or employee ID.</span></li>
        <li><strong>Admins:</strong> <span class="text-muted">use the admin email.</span></li>
        <li><strong>Enter your password</strong> <span class="text-muted">and press Sign In.</span></li>
    </ol>
    <p class="auth-help-note">Locked out? See <button type="button" id="troubleLinkBtn" class="btn btn-link p-0 align-baseline small fw-semibold text-success text-decoration-none">Trouble signing in?</button></p>
</div>

<!-- Trouble Signing In Modal -->
<div class="modal fade modal-glass" id="troubleModal" tabindex="-1" aria-labelledby="troubleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="stat-icon-wrapper stat-icon-amber" style="width: 42px; height: 42px; font-size: 1.2rem;">
                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-dark" id="troubleModalLabel">Need Assistance Signing In?</h5>
                        <small class="text-muted">Zeferino Arroyo High School ICT Support</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-close-trouble aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <ul class="auth-help-list">
                    <li>
                        <i class="bi bi-person-fill text-success me-1" aria-hidden="true"></i>
                        <strong>Students:</strong>
                        <span class="text-muted">sign in with your 12-digit LRN; <a href="/auth/forgot-password">reset your password by email</a> if needed, or approach your Class Adviser or Grade Level Coordinator.</span>
                    </li>
                    <li>
                        <i class="bi bi-briefcase-fill text-warning me-1" aria-hidden="true"></i>
                        <strong>Teachers & Faculty:</strong>
                        <span class="text-muted">sign in with your @zahs.edu.ph email or employee ID; <a href="/auth/forgot-password">reset your password by email</a>, visit the ICT Coordination Office (Room 204), or email <a href="mailto:ict@zahs.edu.ph">ict@zahs.edu.ph</a>.</span>
                    </li>
                    <li>
                        <i class="bi bi-key text-info me-1" aria-hidden="true"></i>
                        <strong>Admins:</strong>
                        <span class="text-muted">sign in with the admin email and your password. Use <a href="/auth/forgot-password">forgot password</a> if you lose access.</span>
                    </li>
                    <li>
                        <i class="bi bi-building me-1" aria-hidden="true"></i>
                        <strong>School:</strong>
                        <span class="text-muted">Zeferino Arroyo High School (Iriga City) · DepEd ID 302015 · MATATAG / K to 12.</span>
                    </li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-liquid-primary px-4" data-bs-dismiss="modal" data-close-trouble>
                    Got it, Back to Sign In
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/js/login.js" defer></script>
