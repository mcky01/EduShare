<%# Register page: tabbed Teacher/Student self-registration with OTP code step. %>
<% const tab = typeof activeTab !== 'undefined' && activeTab ? activeTab : 'teacher'; %>
<% const tf = typeof teacherForm !== 'undefined' && teacherForm ? teacherForm : {}; %>
<% const sf = typeof studentForm !== 'undefined' && studentForm ? studentForm : {}; %>
<% const sentTo = typeof codeSentTo !== 'undefined' ? codeSentTo : null; %>
<div class="auth-single-card">
    <!-- Brand header: big seal left, EduShare + school stacked right -->
    <div class="auth-brand-header">
        <div class="auth-brand-lockup">
            <img src="<%= school.logo || '/images/zahs-logo.png' %>" alt="ZAHS Logo" class="auth-brand-seal">
            <div class="auth-brand-text">
                <div class="fw-extrabold auth-brand-name">EduShare</div>
                <div class="auth-brand-school"><%= school.name %></div>
            </div>
        </div>
    </div>

    <div class="auth-form-heading">
        <h3 class="fw-bold text-dark mb-0">Create Account</h3>
        <p class="text-muted small mb-0 mt-1">Pick your account type, verify your email, then wait for admin approval.</p>
    </div>

    <!-- Inline Error Notice (mirrors login) -->
    <% if (typeof registerError !== 'undefined' && registerError) { %>
    <div class="alert auth-alert-error d-flex align-items-start gap-2 py-2 px-3 mb-3" role="alert" aria-live="assertive">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div><%= registerError %></div>
    </div>
    <% } %>

    <!-- Account type tabs: no page reload, just switches visible pane -->
    <div class="btn-group w-100 mb-3" role="tablist" aria-label="Account type">
        <button type="button" role="tab" id="tabBtnTeacher" aria-selected="<%= tab === 'teacher' %>" aria-controls="teacherPane" class="btn <%= tab === 'teacher' ? 'btn-success' : 'btn-outline-success' %>" onclick="showRegisterTab('teacher')">
            <i class="bi bi-briefcase me-1"></i>Teacher
        </button>
        <button type="button" role="tab" id="tabBtnStudent" aria-selected="<%= tab === 'student' %>" aria-controls="studentPane" class="btn <%= tab === 'student' ? 'btn-success' : 'btn-outline-success' %>" onclick="showRegisterTab('student')">
            <i class="bi bi-mortarboard me-1"></i>Student
        </button>
    </div>

    <!-- Teacher pane -->
    <div id="teacherPane" role="tabpanel" aria-labelledby="tabBtnTeacher" <%= tab === 'teacher' ? '' : 'hidden style="display:none"' %>>
        <% if (sentTo && tab === 'teacher') { %>
        <div class="alert alert-success d-flex align-items-start gap-2 py-2 px-3 mb-3" role="status" aria-live="polite">
            <i class="bi bi-envelope-check mt-1"></i>
            <div>Verification code sent to <strong><%= sentTo %></strong>. Enter it below with your password.</div>
        </div>
        <% } %>
        <form action="/auth/register/teacher/request-code" method="POST" novalidate>
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="row g-2">
                <div class="col-6">
                    <div class="auth-field">
                        <label class="form-label small fw-bold text-muted mb-1" for="tFirst">First name</label>
                        <div class="auth-input-group input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" name="first_name" id="tFirst" class="form-control" placeholder="Juan" required autocomplete="given-name" value="<%= tf.first_name || '' %>">
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="auth-field">
                        <label class="form-label small fw-bold text-muted mb-1" for="tLast">Last name</label>
                        <div class="auth-input-group input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" name="last_name" id="tLast" class="form-control" placeholder="Dela Cruz" required autocomplete="family-name" value="<%= tf.last_name || '' %>">
                        </div>
                    </div>
                </div>
            </div>
            <div class="auth-field">
                <label class="form-label small fw-bold text-muted mb-1" for="tEmail">School email</label>
                <div class="auth-input-group input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input type="email" name="email" id="tEmail" class="form-control" placeholder="you@zahs.edu.ph" required autocomplete="email" value="<%= tf.email || '' %>">
                </div>
                <div class="form-text">Must be an @zahs.edu.ph address.</div>
            </div>
            <div class="auth-field">
                <label class="form-label small fw-bold text-muted mb-1" for="tPass">Password</label>
                <div class="auth-input-group input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" id="tPass" class="form-control" placeholder="10+ chars, upper + lower + number" required autocomplete="new-password">
                </div>
            </div>
            <button type="submit" class="btn btn-liquid-primary w-100 fs-6 auth-submit">
                <i class="bi bi-send me-2"></i>Send code
            </button>
        </form>
        <% if (sentTo && tab === 'teacher') { %>
        <form action="/auth/register/teacher/verify" method="POST" class="mt-3" novalidate>
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="first_name" value="<%= tf.first_name || '' %>">
            <input type="hidden" name="last_name" value="<%= tf.last_name || '' %>">
            <input type="hidden" name="email" value="<%= sentTo %>">
            <div class="auth-field">
                <label class="form-label small fw-bold text-muted mb-1" for="tPass2">Password (re-enter to confirm)</label>
                <div class="auth-input-group input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" id="tPass2" class="form-control" placeholder="Same password as above" required autocomplete="new-password">
                </div>
            </div>
            <div class="auth-field">
                <label class="form-label small fw-bold text-muted mb-1" for="tCode">Verification code</label>
                <div class="auth-input-group input-group">
                    <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                    <input type="text" name="code" id="tCode" class="form-control" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="6-digit code" required>
                </div>
            </div>
            <button type="submit" class="btn btn-liquid-primary w-100 fs-6 auth-submit">
                <i class="bi bi-person-check me-2"></i>Verify &amp; Create Account
            </button>
        </form>
        <% } %>
    </div>

    <!-- Student pane -->
    <div id="studentPane" role="tabpanel" aria-labelledby="tabBtnStudent" <%= tab === 'student' ? '' : 'hidden style="display:none"' %>>
        <% if (sentTo && tab === 'student') { %>
        <div class="alert alert-success d-flex align-items-start gap-2 py-2 px-3 mb-3" role="status" aria-live="polite">
            <i class="bi bi-envelope-check mt-1"></i>
            <div>Verification code sent to <strong><%= sentTo %></strong>. Enter it below with your password.</div>
        </div>
        <% } %>
        <form action="/auth/register/student/request-code" method="POST" novalidate>
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="row g-2">
                <div class="col-6">
                    <div class="auth-field">
                        <label class="form-label small fw-bold text-muted mb-1" for="sFirst">First name</label>
                        <div class="auth-input-group input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" name="first_name" id="sFirst" class="form-control" placeholder="Maria" required autocomplete="given-name" value="<%= sf.first_name || '' %>">
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="auth-field">
                        <label class="form-label small fw-bold text-muted mb-1" for="sLast">Last name</label>
                        <div class="auth-input-group input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" name="last_name" id="sLast" class="form-control" placeholder="Santos" required autocomplete="family-name" value="<%= sf.last_name || '' %>">
                        </div>
                    </div>
                </div>
            </div>
            <div class="auth-field">
                <label class="form-label small fw-bold text-muted mb-1" for="sLrn">LRN (12 digits)</label>
                <div class="auth-input-group input-group">
                    <span class="input-group-text"><i class="bi bi-hash"></i></span>
                    <input type="text" name="lrn" id="sLrn" class="form-control" placeholder="12-digit Learner Reference Number" required inputmode="numeric" pattern="[0-9]{12}" maxlength="12" value="<%= sf.lrn || '' %>">
                </div>
            </div>
            <div class="auth-field">
                <label class="form-label small fw-bold text-muted mb-1" for="sEmail">Email</label>
                <div class="auth-input-group input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input type="email" name="email" id="sEmail" class="form-control" placeholder="you@example.com" required autocomplete="email" value="<%= sf.email || '' %>">
                </div>
            </div>
            <div class="auth-field">
                <label class="form-label small fw-bold text-muted mb-1" for="sPass">Password</label>
                <div class="auth-input-group input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" id="sPass" class="form-control" placeholder="10+ chars, upper + lower + number" required autocomplete="new-password">
                </div>
            </div>
            <button type="submit" class="btn btn-liquid-primary w-100 fs-6 auth-submit">
                <i class="bi bi-send me-2"></i>Send code
            </button>
        </form>
        <% if (sentTo && tab === 'student') { %>
        <form action="/auth/register/student/verify" method="POST" class="mt-3" novalidate>
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="first_name" value="<%= sf.first_name || '' %>">
            <input type="hidden" name="last_name" value="<%= sf.last_name || '' %>">
            <input type="hidden" name="lrn" value="<%= sf.lrn || '' %>">
            <input type="hidden" name="email" value="<%= sentTo %>">
            <div class="auth-field">
                <label class="form-label small fw-bold text-muted mb-1" for="sPass2">Password (re-enter to confirm)</label>
                <div class="auth-input-group input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" id="sPass2" class="form-control" placeholder="Same password as above" required autocomplete="new-password">
                </div>
            </div>
            <div class="auth-field">
                <label class="form-label small fw-bold text-muted mb-1" for="sCode">Verification code</label>
                <div class="auth-input-group input-group">
                    <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                    <input type="text" name="code" id="sCode" class="form-control" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="6-digit code" required>
                </div>
            </div>
            <button type="submit" class="btn btn-liquid-primary w-100 fs-6 auth-submit">
                <i class="bi bi-person-check me-2"></i>Verify &amp; Create Account
            </button>
        </form>
        <% } %>
    </div>

    <p class="text-center small mt-3 mb-0">Already have an account? <a href="/auth/login">Sign in</a></p>

    <!-- Footer: motto + school year -->
    <div class="auth-single-footer">
        <span class="auth-single-motto">"<%= school.motto %>"</span>
        <span class="badge rounded-pill auth-sy-badge">
            <i class="bi bi-calendar-event me-1"></i> SY <%= school.year %> &bull; <%= school.term %>
        </span>
    </div>
</div>

<script>
// Tab toggle: switches visible pane without a page reload.
function showRegisterTab(which) {
    const panes = { teacher: document.getElementById('teacherPane'), student: document.getElementById('studentPane') };
    const btns = { teacher: document.getElementById('tabBtnTeacher'), student: document.getElementById('tabBtnStudent') };
    for (const key of ['teacher', 'student']) {
        const active = key === which;
        const pane = panes[key];
        const btn = btns[key];
        if (pane) {
            pane.hidden = !active;
            pane.style.display = active ? '' : 'none';
        }
        if (btn) {
            btn.setAttribute('aria-selected', active ? 'true' : 'false');
            btn.classList.toggle('btn-success', active);
            btn.classList.toggle('btn-outline-success', !active);
        }
    }
}
window.showRegisterTab = showRegisterTab;
</script>
