<%# Reset-password page: new-password form with strength-meter markup (server-validated, no JS). %>
<div class="auth-single-card">
    <!-- Brand header: big seal left, EduShare + school stacked right -->
    <div class="auth-brand-header">
        <div class="auth-brand-lockup">
            <img src="<%= school.logo || '/images/zahs-logo.png' %>" alt="ZAHS Logo" class="auth-brand-seal">
            <div class="auth-brand-text">
                <div class="fw-extrabold auth-brand-name">EduShare</div>
                <div class="auth-brand-school"><%= school.name %></div>
                <div class="auth-brand-motto">"<%= school.motto %>"</div>
            </div>
        </div>
    </div>

    <div class="auth-form-heading">
        <h3 class="fw-bold text-dark mb-0">Set New Password</h3>
        <p class="text-muted small mb-0 mt-1">Enter the code from your email, then choose a secure password.</p>
    </div>

    <!-- Inline Error Notice (mirrors login) -->
    <% if (typeof resetError !== 'undefined' && resetError) { %>
    <div class="alert auth-alert-error d-flex align-items-start gap-2 py-2 px-3 mb-3" role="alert" aria-live="assertive">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div><%= resetError %></div>
    </div>
    <% } %>

    <!-- Client-side validation error (hidden until JS shows it) -->
    <div id="clientError" class="alert auth-alert-error d-flex align-items-start gap-2 py-2 px-3 mb-3 d-none" role="alert" aria-live="assertive" hidden>
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div id="clientErrorText"></div>
    </div>

    <% const shownEmail = typeof email !== 'undefined' && email ? email : ''; %>

    <form action="/auth/forgot-password/verify" method="POST" novalidate data-strength-meter>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="auth-field">
            <label class="form-label small fw-bold text-muted mb-1" for="rpEmail">Account email</label>
            <div class="auth-input-group input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input type="email" name="email" id="rpEmail" class="form-control" placeholder="you@example.com" required autocomplete="email" value="<%= shownEmail %>">
            </div>
        </div>
        <div class="auth-field">
            <label class="form-label small fw-bold text-muted mb-1" for="rpCode">Verification code</label>
            <div class="auth-input-group input-group">
                <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                <input type="text" name="code" id="rpCode" class="form-control" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="6-digit code" required aria-describedby="rpCodeExpiry">
            </div>
            <div class="form-text" id="rpCodeExpiry">Code expires in <span data-otp-countdown data-ttl="10" aria-hidden="true">10:00</span>.</div>
            <span data-otp-announce class="visually-hidden" aria-live="polite"></span>
        </div>
        <div class="auth-field">
            <label class="form-label small fw-bold text-muted mb-1" for="rpNewPass">New password</label>
            <div class="auth-input-group input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input type="password" name="new_password" id="rpNewPass" class="form-control js-peek" placeholder="Minimum 10 characters, mixed case + number" minlength="10" required autocomplete="new-password" aria-describedby="passRules passStrength" data-meter-new>
                <button type="button" class="btn-peek" data-meter-peek-for="rpNewPass" aria-label="Show password" aria-pressed="false" title="Toggle password visibility">
                    <i class="bi bi-eye text-muted"></i>
                </button>
            </div>
            <div id="passRules" class="form-text small text-muted mt-1">
                Use at least 10 characters with upper/lowercase letters and a number.
            </div>
            <div class="progress mt-2" style="height: 6px; border-radius: 50px;" aria-hidden="true">
                <div id="passStrengthBar" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
            </div>
            <div id="passStrength" class="small fw-semibold mt-1 text-muted" aria-live="polite">Password strength: —</div>
        </div>
        <div class="auth-field">
            <label class="form-label small fw-bold text-muted mb-1" for="rpConfirmPass">Confirm new password</label>
            <div class="auth-input-group input-group">
                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                <input type="password" name="confirm_password" id="rpConfirmPass" class="form-control js-peek" placeholder="Re-enter new password" minlength="10" required autocomplete="new-password" aria-describedby="passMatch" data-meter-confirm>
                <button type="button" class="btn-peek" data-meter-peek-for="rpConfirmPass" aria-label="Show password" aria-pressed="false" title="Toggle password visibility">
                    <i class="bi bi-eye text-muted"></i>
                </button>
            </div>
            <div id="passMatch" class="small fw-semibold mt-1 text-muted" aria-live="polite"></div>
        </div>
        <button type="submit" class="btn btn-liquid-primary w-100 fs-6 auth-submit">
            <i class="bi bi-check-lg me-2"></i>Update Password
        </button>
        <p class="text-center small mt-2 mb-0">Didn&apos;t get the code? <button type="submit" formaction="/auth/forgot-password/request-code" data-resend class="btn btn-link p-0 align-baseline small fw-semibold">Resend code</button></p>
    </form>

    <p class="text-center small mt-3 mb-0">Need a fresh code? <a href="/auth/forgot-password">Request a new one</a></p>
</div>

<!-- Floating reset guide: instructions scoped to setting a new password -->
<button type="button" class="auth-help-fab" id="loginHelpFab" aria-label="How to set a new password" aria-expanded="false" aria-controls="loginHelpPanel">
    <i class="bi bi-question-lg" aria-hidden="true"></i>
</button>
<div class="auth-help-panel d-none" id="loginHelpPanel" role="dialog" aria-label="How to set a new password">
    <div class="auth-help-panel-head">
        <strong>How to set a new password</strong>
        <button type="button" class="btn-close btn-close-sm" id="loginHelpCloseBtn" aria-label="Close password help"></button>
    </div>
    <ol class="auth-help-steps">
        <li><strong>Enter your account email.</strong> <span class="text-muted">Use the email linked to your account.</span></li>
        <li><strong>Enter the 6-digit code</strong> <span class="text-muted">from your email — it expires after 10 minutes; request a new one if it lapsed.</span></li>
        <li><strong>Choose a new password.</strong> <span class="text-muted">10+ characters with upper/lowercase letters and a number, confirm it, then press Update Password and sign in with it.</span></li>
    </ol>
    <p class="auth-help-note">Still stuck? Contact your Class Adviser, or for staff visit the ICT Coordination Office (Room 204).</p>
</div>

<script src="/js/register.js" defer></script>
<script src="/js/password-meter.js" defer></script>
