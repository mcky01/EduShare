<div class="glass-card p-4 p-md-5">
    <div class="text-center mb-4">
        <div class="user-avatar-initials mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.5rem; background: linear-gradient(135deg, var(--zahs-amber), var(--zahs-amber-gold));">
            <i class="bi bi-shield-lock"></i>
        </div>
        <h3 class="fw-bold mb-1">Set New Password</h3>
        <p class="small text-muted mb-0">
            <% if (user && user.force_password_change) { %>
                Welcome! Please choose a secure personalized password before proceeding.
            <% } else { %>
                Enter your current and new password below.
            <% } %>
        </p>
    </div>

    <form action="/auth/change-password" method="POST" id="changePassForm" novalidate>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <% if (user && !user.force_password_change) { %>
            <div class="mb-3">
                <label class="form-label small fw-bold text-muted" for="currentPass">Current Password</label>
                <input type="password" name="current_password" id="currentPass" class="glass-input" placeholder="Enter current password" required autocomplete="current-password">
            </div>
        <% } %>

        <div class="mb-2">
            <label class="form-label small fw-bold text-muted" for="newPass">New Password</label>
            <input type="password" name="new_password" id="newPass" class="glass-input" placeholder="Minimum 10 characters, mixed case + number" minlength="10" required autocomplete="new-password" aria-describedby="passRules passStrength">
            <div id="passRules" class="form-text small text-muted mt-1">
                Use at least 10 characters with upper/lowercase letters and a number.
            </div>
            <div class="progress mt-2" style="height: 6px; border-radius: 50px;" aria-hidden="true">
                <div id="passStrengthBar" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
            </div>
            <div id="passStrength" class="small fw-semibold mt-1 text-muted" aria-live="polite">Password strength: —</div>
        </div>

        <div class="mb-4">
            <label class="form-label small fw-bold text-muted" for="confirmPass">Confirm New Password</label>
            <input type="password" name="confirm_password" id="confirmPass" class="glass-input" placeholder="Re-enter new password" minlength="10" required autocomplete="new-password">
            <div id="passMatch" class="small fw-semibold mt-1 text-muted" aria-live="polite"></div>
        </div>

        <button type="submit" class="btn btn-liquid-primary w-100 py-2 fs-6" id="changePassBtn">
            <i class="bi bi-check-lg me-2"></i> Update Password & Continue
        </button>
    </form>
</div>

<script>
(function () {
    const newPass = document.getElementById('newPass');
    const confirmPass = document.getElementById('confirmPass');
    const bar = document.getElementById('passStrengthBar');
    const label = document.getElementById('passStrength');
    const match = document.getElementById('passMatch');
    if (!newPass) return;

    function scorePassword(v) {
        let s = 0;
        if (v.length >= 10) s += 1;
        if (v.length >= 14) s += 1;
        if (/[a-z]/.test(v) && /[A-Z]/.test(v)) s += 1;
        if (/\d/.test(v)) s += 1;
        if (/[^A-Za-z0-9]/.test(v)) s += 1;
        return s;
    }

    function render() {
        const v = newPass.value || '';
        const s = scorePassword(v);
        const pct = Math.round((s / 5) * 100);
        const names = ['Very weak', 'Weak', 'Fair', 'Good', 'Strong', 'Very strong'];
        const colors = ['#dc2626', '#ea580c', '#d97706', '#059669', '#059669', '#06381e'];
        if (bar) {
            bar.style.width = pct + '%';
            bar.style.background = colors[s];
            bar.setAttribute('aria-valuenow', String(pct));
        }
        if (label) {
            label.textContent = 'Password strength: ' + (v ? names[s] : '—');
            label.style.color = v ? colors[s] : '';
        }
        if (match && confirmPass) {
            if (!confirmPass.value) {
                match.textContent = '';
            } else if (newPass.value === confirmPass.value) {
                match.textContent = 'Passwords match.';
                match.style.color = '#059669';
            } else {
                match.textContent = 'Passwords do not match yet.';
                match.style.color = '#b45309';
            }
        }
    }

    newPass.addEventListener('input', render);
    if (confirmPass) confirmPass.addEventListener('input', render);

    document.getElementById('changePassForm')?.addEventListener('submit', (e) => {
        const v = newPass.value || '';
        const hasLower = /[a-z]/.test(v);
        const hasUpper = /[A-Z]/.test(v);
        const hasDigit = /\d/.test(v);
        if (v.length < 10 || !hasLower || !hasUpper || !hasDigit) {
            e.preventDefault();
            newPass.focus();
            if (label) {
                label.textContent = 'Use at least 10 characters with upper/lowercase letters and a number.';
                label.style.color = '#b45309';
            }
            return false;
        }
        if (confirmPass && v !== confirmPass.value) {
            e.preventDefault();
            confirmPass.focus();
            return false;
        }
        return true;
    });

    render();
})();
</script>
