<div class="glass-card p-4 p-md-5">
    <div class="text-center mb-4">
        <div class="user-avatar-initials mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.5rem; background: linear-gradient(135deg, var(--zahs-amber), var(--zahs-amber-gold));">
            <i class="bi bi-shield-lock"></i>
        </div>
        <h3 class="fw-bold mb-1">Set New Password</h3>
        <p class="small text-muted mb-0">
            <% if (user && user.force_password_change) { %>
                Welcome! Please choose a secure personalized password before proceeding.
            <% } else { %>
                Enter your current and new password below.
            <% } %>
        </p>
    </div>

    <form action="/auth/change-password" method="POST" id="changePassForm" novalidate data-strength-meter>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <% if (typeof returnTo !== 'undefined' && returnTo) { %>
        <input type="hidden" name="returnTo" value="<%= returnTo %>">
        <% } %>
        <% if (user && !user.force_password_change) { %>
            <div class="mb-3">
                <label class="form-label small fw-bold text-muted" for="currentPass">Current Password</label>
                <div class="auth-input-group input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" name="current_password" id="currentPass" class="form-control" placeholder="Enter current password" required autocomplete="current-password" autofocus>
                    <button type="button" class="btn-peek" data-meter-peek-for="currentPass" aria-label="Show password" aria-pressed="false" title="Toggle password visibility">
                        <i class="bi bi-eye text-muted"></i>
                    </button>
                </div>
            </div>
        <% } else { %>
            <input type="hidden" data-autofocus-marker value="newPass">
        <% } %>

        <div class="mb-2">
            <label class="form-label small fw-bold text-muted" for="newPass">New Password</label>
            <div class="auth-input-group input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input type="password" name="new_password" id="newPass" class="form-control" placeholder="Minimum 10 characters, mixed case + number" minlength="10" required autocomplete="new-password" aria-describedby="passRules passStrength" data-meter-new>
            <button type="button" class="btn-peek" data-meter-peek-for="newPass" aria-label="Show password" aria-pressed="false" title="Toggle password visibility">
                <i class="bi bi-eye text-muted"></i>
            </button>
            </div>
            <div id="passRules" class="form-text small text-muted mt-1">
                Use at least 10 characters with upper/lowercase letters and a number.
            </div>
            <div class="progress mt-2" style="height: 6px; border-radius: 50px;" aria-hidden="true">
                <div id="passStrengthBar" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
            </div>
            <div id="passStrength" class="small fw-semibold mt-1 text-muted" aria-live="polite">Password strength: —</div>
        </div>

        <div class="mb-4">
            <label class="form-label small fw-bold text-muted" for="confirmPass">Confirm New Password</label>
            <div class="auth-input-group input-group">
            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
            <input type="password" name="confirm_password" id="confirmPass" class="form-control" placeholder="Re-enter new password" minlength="10" required autocomplete="new-password" aria-describedby="passMatch" data-meter-confirm>
            <button type="button" class="btn-peek" data-meter-peek-for="confirmPass" aria-label="Show password" aria-pressed="false" title="Toggle password visibility">
                <i class="bi bi-eye text-muted"></i>
            </button>
            </div>
            <div id="passMatch" class="small fw-semibold mt-1 text-muted" aria-live="polite"></div>
        </div>

        <button type="submit" class="btn btn-liquid-primary w-100 py-2 fs-6 auth-submit" id="changePassBtn">
            <i class="bi bi-check-lg me-2"></i> Update Password &amp; Continue
        </button>
    </form>

    <div class="text-center mt-3">
        <p class="small text-muted mb-1">Signed in as <%= user ? user.first_name : '' %> <%= user ? user.last_name : '' %>. Wrong account?</p>
        <form action="/auth/logout" method="POST" class="d-inline">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="btn btn-link p-0 small">Sign out</button>
        </form>
    </div>
</div>

<script src="/js/password-meter.js" defer></script>
