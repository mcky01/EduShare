<%# Forgot-password page: step 1 request-code, step 2 email+code+new passwords (one form, no JS). %>
<div class="auth-single-card">
    <!-- Brand header: big seal left, EduShare + school stacked right -->
    <div class="auth-brand-header">
        <div class="auth-brand-lockup">
            <img src="<%= school.logo || '/images/zahs-logo.png' %>" alt="ZAHS Logo" class="auth-brand-seal">
            <div class="auth-brand-text">
                <div class="fw-extrabold auth-brand-name">EduShare</div>
                <div class="auth-brand-school"><%= school.name %></div>
                <div class="auth-brand-motto">"<%= school.motto %>"</div>
            </div>
        </div>
    </div>

    <div class="auth-form-heading">
        <h3 class="fw-bold text-dark mb-0">Forgot Password</h3>
        <p class="text-muted small mb-0 mt-1">Enter your account email to get a verification code, then set a new password.</p>
    </div>

    <!-- Inline Error Notice (mirrors login) -->
    <% if (typeof forgotError !== 'undefined' && forgotError) { %>
    <div class="alert auth-alert-error d-flex align-items-start gap-2 py-2 px-3 mb-3" role="alert" aria-live="assertive">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div><%= forgotError %></div>
    </div>
    <% } %>

    <!-- Client-side validation error (hidden until JS shows it) -->
    <div id="clientError" class="alert auth-alert-error d-flex align-items-start gap-2 py-2 px-3 mb-3 d-none" role="alert" aria-live="assertive" hidden>
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div id="clientErrorText"></div>
    </div>

    <% const sentTo = typeof codeSentTo !== 'undefined' ? codeSentTo : null; %>
    <% const shownEmail = typeof email !== 'undefined' && email ? email : (sentTo || ''); %>

    <% if (sentTo) { %>
    <div class="alert alert-success d-flex align-items-start gap-2 py-2 px-3 mb-3" role="status" aria-live="polite">
        <i class="bi bi-envelope-check mt-1"></i>
        <div><%= typeof sentNotice !== 'undefined' && sentNotice ? sentNotice : 'If an account exists for that email, a verification code was sent.' %> Enter it below with your new password.</div>
    </div>
    <div class="auth-step-summary">
        <span><i class="bi bi-envelope me-1"></i><%= sentTo %></span>
        <a href="/auth/forgot-password">Use a different email</a>
    </div>
    <form action="/auth/forgot-password/verify" method="POST" novalidate data-meter-live>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" name="email" value="<%= sentTo %>">
        <div class="auth-field">
            <label class="form-label small fw-bold text-muted mb-1" for="fpCode">Verification code</label>
            <div class="auth-input-group input-group">
                <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                <input type="text" name="code" id="fpCode" class="form-control" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="6-digit code" required autofocus aria-describedby="fpCodeExpiry">
            </div>
            <div class="form-text" id="fpCodeExpiry">Code expires in <span data-otp-countdown data-ttl="10" aria-hidden="true">10:00</span>.</div>
            <span data-otp-announce class="visually-hidden" aria-live="polite"></span>
        </div>
        <div class="auth-field">
            <label class="form-label small fw-bold text-muted mb-1" for="fpNewPass">New password</label>
            <div class="auth-input-group input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input type="password" name="new_password" id="fpNewPass" class="form-control js-peek" placeholder="10+ chars, upper + lower + number" minlength="10" required autocomplete="new-password" aria-describedby="fpPassStrength fpPassMatch">
                <button type="button" class="btn-peek" data-meter-peek-for="fpNewPass" aria-label="Show password" aria-pressed="false" title="Toggle password visibility">
                    <i class="bi bi-eye text-muted"></i>
                </button>
            </div>
            <div id="fpPassStrength" data-meter-live-label class="form-text small text-muted mt-1" aria-live="polite">Use at least 10 characters with upper/lowercase letters and a number.</div>
            <div id="fpPassMatch" data-meter-live-match class="form-text small text-muted" aria-live="polite"></div>
        </div>
        <div class="auth-field">
            <label class="form-label small fw-bold text-muted mb-1" for="fpConfirmPass">Confirm new password</label>
            <div class="auth-input-group input-group">
                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                <input type="password" name="confirm_password" id="fpConfirmPass" class="form-control js-peek" placeholder="Re-enter new password" minlength="10" required autocomplete="new-password" aria-describedby="fpPassMatch">
            </div>
        </div>
        <button type="submit" class="btn btn-liquid-primary w-100 fs-6 auth-submit">
            <i class="bi bi-check-lg me-2"></i>Verify Code &amp; Update Password
        </button>
        <p class="text-center small mt-2 mb-0">Didn&apos;t get the code? <button type="submit" formaction="/auth/forgot-password/request-code" data-resend class="btn btn-link p-0 align-baseline small fw-semibold">Resend code</button></p>
    </form>
    <% } else { %>
    <form action="/auth/forgot-password/request-code" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="auth-field">
            <label class="form-label small fw-bold text-muted mb-1" for="fpEmail">Account email</label>
            <div class="auth-input-group input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input type="email" name="email" id="fpEmail" class="form-control" placeholder="you@example.com" required autocomplete="email" autofocus value="<%= shownEmail %>">
            </div>
        </div>
        <button type="submit" class="btn btn-liquid-primary w-100 fs-6 auth-submit">
            <i class="bi bi-send me-2"></i>Send Code
        </button>
    </form>
    <% } %>

    <p class="text-center small mt-3 mb-0">Remembered it? <a href="/auth/login">Back to sign in</a></p>
</div>

<!-- Floating reset guide: instructions scoped to password recovery -->
<button type="button" class="auth-help-fab" id="loginHelpFab" aria-label="How to reset your password" aria-expanded="false" aria-controls="loginHelpPanel">
    <i class="bi bi-question-lg" aria-hidden="true"></i>
</button>
<div class="auth-help-panel d-none" id="loginHelpPanel" role="dialog" aria-label="How to reset your password">
    <div class="auth-help-panel-head">
        <strong>How to reset your password</strong>
        <button type="button" class="btn-close btn-close-sm" id="loginHelpCloseBtn" aria-label="Close password help"></button>
    </div>
    <ol class="auth-help-steps">
        <li><strong>Enter your account email.</strong> <span class="text-muted">Use the email linked to your account, then press Send Code.</span></li>
        <li><strong>Check your inbox.</strong> <span class="text-muted">Enter the 6-digit verification code — it expires after 10 minutes.</span></li>
        <li><strong>Choose a new password.</strong> <span class="text-muted">10+ characters with upper/lowercase letters and a number, then confirm it and press Verify Code &amp; Update Password.</span></li>
    </ol>
    <p class="auth-help-note">Still stuck? Contact your Class Adviser, or for staff visit the ICT Coordination Office (Room 204).</p>
</div>

<script src="/js/register.js" defer></script>
<script src="/js/password-meter.js" defer></script>
