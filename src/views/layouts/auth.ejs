<%- include('../partials/head') %>
<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

<div class="auth-wrapper d-flex align-items-center justify-content-center min-vh-100 p-3 p-md-4 position-relative overflow-hidden">
    <!-- Philippine classroom photo backdrop with emerald scrim -->
    <div class="auth-photo-bg" role="presentation" aria-hidden="true"></div>
    <div class="auth-photo-scrim" role="presentation" aria-hidden="true"></div>
    <!-- Ambient Liquid Mesh Orbs -->
    <div class="ambient-orb orb-1"></div>
    <div class="ambient-orb orb-2"></div>
    <div class="ambient-orb orb-3"></div>

    <div class="w-100 position-relative auth-shell">
        <%- include('../partials/toast') %>
        <%- body %>
    </div>
</div>

<!-- Bootstrap 5 Bundle JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<%- typeof script !== 'undefined' ? script : '' %>

</body>
</html>
