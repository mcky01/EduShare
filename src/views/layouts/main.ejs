<%- include('../partials/head') %>
<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

<a href="#mainContent" class="visually-hidden-focusable">Skip to main content</a>
<%- include('../partials/navbar') %>

<div class="main-layout">
    <%- include('../partials/sidebar') %>

    <main class="content-wrapper" id="mainContent" tabindex="-1">
        <%- include('../partials/toast') %>
        <%- body %>
    </main>
</div>

<%- include('../partials/modals') %>

<!-- Bootstrap 5 Bundle JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- EduShare Global JS (external file: CSP-safe, no inline handlers) -->
<script src="/js/app.js"></script>

<!-- Reusable card/table view toggle -->
<script src="/js/view-toggle.js"></script>

<!-- Shared local list filter (teacher/student filter bars) -->
<script src="/js/local-filter.js"></script>

<% if (typeof user !== 'undefined' && user && user.role === 'student') { %>
<!-- Student notification bell polling -->
<script src="/js/notifications.js"></script>
<% } %>

<%- typeof script !== 'undefined' ? script : '' %>

</body>
</html>
