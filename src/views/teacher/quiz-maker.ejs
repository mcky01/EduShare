<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge-emerald"><i class="bi bi-cpu me-1"></i>Ollama Qwen 2.5 7B Engine</span>
            <span class="badge-amber">Auto-Graded & Gradebook Synced</span>
        </div>
        <h2 class="fw-bold mb-0 text-dark">AI Quiz Maker</h2>
        <p class="text-muted small mb-0">Generate curriculum-grounded quizzes with multiple choice, true/false, and identification items.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Left: Setup Parameters Form -->
    <div class="col-lg-5">
        <div class="glass-card p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-sliders text-success me-2"></i>Configure Quiz</h5>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label small fw-bold">Quiz Title</label>
                    <input type="text" id="quizTitle" class="glass-input" value="Quiz 2: Figures of Speech & Poetry" required>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-bold">Subject Area</label>
                    <input type="text" id="quizSubject" class="glass-input" value="English">
                </div>
                <div class="col-6">
                    <label class="form-label small fw-bold">Grade Level</label>
                    <select id="quizGrade" class="glass-input">
                        <option value="Grade 7">Grade 7</option>
                        <option value="Grade 8">Grade 8</option>
                        <option value="Grade 9">Grade 9</option>
                        <option value="Grade 10">Grade 10</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small fw-bold">Topic / Content Focus</label>
                    <input type="text" id="quizTopic" class="glass-input" value="Simile, Metaphor, Personification, and Hyperbole" required>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-bold">Delivery Term <span class="text-muted fw-normal">(select first)</span></label>
                    <select id="quizTerm" class="glass-input">
                        <option value="T1" selected>Term 1 (Q1-Q2)</option>
                        <option value="T2">Term 2 (Q3)</option>
                        <option value="T3">Term 3 (Q4)</option>
                    </select>
                </div>
                <div class="col-6 d-flex align-items-end">
                    <div id="quizGroundBadge" class="small fw-semibold text-muted">Sources: not generated yet</div>
                </div>
                <div class="col-12">
                    <label class="form-label small fw-bold">DepEd Competency <span class="text-muted fw-normal" id="quizCompCount"></span></label>
                    <select id="quizCompetency" class="glass-input">
                        <% (typeof competencies !== 'undefined' ? competencies : []).forEach(comp => { %>
                            <option value="<%= comp.code %>: <%= comp.description %>" data-code="<%= comp.code %>" data-term="<%= comp.term || '' %>">
                                <%= comp.code %>: <%= comp.description %>
                            </option>
                        <% }) %>
                        <option value="General Standard" data-code="" data-term="">Custom / Unlisted Competency</option>
                    </select>
                </div>

                <div class="col-4">
                    <label class="form-label small fw-bold">Multiple Choice</label>
                    <input type="number" id="quizMcCount" class="glass-input text-center" value="3" min="1" max="10">
                </div>
                <div class="col-4">
                    <label class="form-label small fw-bold">True / False</label>
                    <input type="number" id="quizTfCount" class="glass-input text-center" value="2" min="0" max="10">
                </div>
                <div class="col-4">
                    <label class="form-label small fw-bold">Identification</label>
                    <input type="number" id="quizIdCount" class="glass-input text-center" value="1" min="0" max="10">
                </div>

                <div class="col-6">
                    <label class="form-label small fw-bold">Time Limit (Minutes)</label>
                    <input type="number" id="quizTimeLimit" class="glass-input" value="15" min="5">
                </div>
                <div class="col-6">
                    <label class="form-label small fw-bold">Passing Mark (%)</label>
                    <input type="number" id="quizPassingScore" class="glass-input" value="60" min="50" max="100">
                </div>

                <div class="col-12">
                    <label class="form-label small fw-bold">Assign to Class Sections</label>
                    <div class="d-flex flex-column gap-2" id="quizTargetClasses">
                        <% classes.forEach((cls, idx) => { %>
                            <div class="form-check p-2 rounded-3" style="background: rgba(255,255,255,0.6);">
                                <input class="form-check-input ms-0 me-2 quiz-cls-cb" type="checkbox" value="<%= cls.id %>" id="qCls_<%= cls.id %>"<%= idx === 0 && classes.length > 0 ? ' checked' : '' %>>
                                <label class="form-check-label small fw-semibold text-dark" for="qCls_<%= cls.id %>">
                                    <%= cls.class_name %> (<%= cls.section %>)
                                </label>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="col-12 mt-4">
                    <button type="button" id="btnGenerateQuiz" class="btn btn-liquid-primary w-100 py-2 fs-6 shadow">
                        <i class="bi bi-stars me-2"></i> Generate Questions with AI
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Questions Preview & Save -->
    <div class="col-lg-7">
        <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Generated Questions & Answer Key</h5>
                    <span id="questionCountBadge" class="badge-emerald">0 Questions</span>
                </div>

                <div id="quizReviewBox" class="mb-3" style="display: none;"></div>

                <div id="quizQuestionsContainer" style="max-height: 520px; overflow-y: auto;">
                    <div class="text-center text-muted p-5">
                        <i class="bi bi-card-checklist fs-1 text-warning d-block mb-2"></i>
                        <h6>No Questions Generated Yet</h6>
                        <p class="small">Configure your parameters on the left and click "Generate Questions with AI".</p>
                    </div>
                </div>
            </div>

            <div class="border-top pt-3 mt-3 d-flex justify-content-end gap-2 d-none" id="saveQuizActions" style="display: none;">
                <button type="button" id="btnSaveQuiz" class="btn btn-liquid-primary px-4 py-2">
                    <i class="bi bi-check2-circle me-1"></i> Finalize & Publish Quiz
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/js/quiz-maker-teacher.js"></script>
