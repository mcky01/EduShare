<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge-emerald"><i class="bi bi-cpu me-1"></i>Ollama Qwen 2.5 7B Engine</span>
            <span class="badge-amber">Auto-Graded & Gradebook Synced</span>
        </div>
        <h2 class="fw-bold mb-0 text-dark">AI Quiz Maker</h2>
        <p class="text-muted small mb-0">Generate plan-grounded quizzes with multiple choice, true/false, and identification items.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Left: Setup Parameters Form -->
    <div class="col-lg-5">
        <div class="glass-card p-4 h-100 d-flex flex-column">
            <h5 class="fw-bold mb-3"><i class="bi bi-sliders text-success me-2"></i>Configure Quiz</h5>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label small fw-bold">Quiz Title</label>
                    <input type="text" id="quizTitle" class="glass-input" value="Quiz 2: Figures of Speech & Poetry" required>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-bold">Subject Area</label>
                    <input type="text" id="quizSubject" class="glass-input" value="English">
                </div>
                <div class="col-6">
                    <label class="form-label small fw-bold">Grade Level</label>
                    <% const _quizGrade = (typeof teacherProfile !== 'undefined' && teacherProfile && teacherProfile.grade_level) ? teacherProfile.grade_level : 'Grade 7'; %>
                    <select id="quizGrade" class="glass-input">
                        <% ['Grade 7', 'Grade 8', 'Grade 9', 'Grade 10', 'Grade 11', 'Grade 12'].forEach(function(g) { %>
                            <option value="<%= g %>" <%= _quizGrade === g ? 'selected' : '' %>><%= g %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small fw-bold">Topic / Content Focus</label>
                    <input type="text" id="quizTopic" class="glass-input" value="Simile, Metaphor, Personification, and Hyperbole" required>
                </div>
                <div class="col-12">
                    <div class="alert alert-info py-2 px-3 mb-0 small">
                        <strong><i class="bi bi-journal-text me-1"></i>Ground from your lesson plan (recommended).</strong>
                        Paste the plan (or upload PDF/DOCX/DOC/TXT) so quiz items come from its Assessment section.
                        Optionally attach the just-generated deck JSON so items match what was projected.
                    </div>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-bold">Plan Format</label>
                    <select id="quizPlanFormat" class="glass-input">
                        <option value="ilaw" selected>ILAW</option>
                        <option value="dll">DLL</option>
                        <option value="dlp">DLP</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-bold">Focus Session</label>
                    <select id="quizFocusSession" class="glass-input">
                        <option value="">Whole plan</option>
                        <option value="S1">Session 1</option>
                        <option value="S2">Session 2</option>
                        <option value="S3">Session 3</option>
                        <option value="S4">Session 4</option>
                        <option value="S5">Session 5</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small fw-bold">Lesson Plan Text <span class="text-muted fw-normal">(paste, or leave blank for ungrounded)</span></label>
                    <textarea id="quizPlanText" class="glass-input" rows="5" placeholder="Paste the DLL/DLP/ILAW plan here — quiz items come from its Assessment section first."></textarea>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-bold">Plan File <span class="text-muted fw-normal">(optional)</span></label>
                    <input type="file" id="quizPlanFile" class="glass-input" accept=".pdf,.docx,.doc,.txt">
                </div>
                <div class="col-6">
                    <label class="form-label small fw-bold">Deck JSON <span class="text-muted fw-normal">(optional)</span></label>
                    <input type="file" id="quizDeckFile" class="glass-input" accept=".json,application/json">
                    <div class="form-text small">Export from the lesson preview, or auto-filled after generating a deck.</div>
                </div>
                <div class="col-12" id="quizPlanCoverageWrap" style="display: none;">
                    <div id="quizPlanCoverage" class="small fw-semibold text-muted">Plan: not provided.</div>
                </div>

                <div class="col-4">
                    <label class="form-label small fw-bold">Multiple Choice</label>
                    <input type="number" id="quizMcCount" class="glass-input text-center" value="3" min="0" max="10">
                </div>
                <div class="col-4">
                    <label class="form-label small fw-bold">True / False</label>
                    <input type="number" id="quizTfCount" class="glass-input text-center" value="2" min="0" max="10">
                </div>
                <div class="col-4">
                    <label class="form-label small fw-bold">Identification</label>
                    <input type="number" id="quizIdCount" class="glass-input text-center" value="1" min="0" max="10">
                </div>

                <div class="col-6">
                    <label class="form-label small fw-bold">Time Limit (Minutes)</label>
                    <input type="number" id="quizTimeLimit" class="glass-input" value="15" min="5">
                </div>
                <div class="col-6">
                    <label class="form-label small fw-bold">Passing Mark (%)</label>
                    <input type="number" id="quizPassingScore" class="glass-input" value="60" min="50" max="100">
                </div>

                <div class="col-12">
                    <label class="form-label small fw-bold">Assign to Class Sections</label>
                    <div class="d-flex flex-column gap-2" id="quizTargetClasses">
                        <% classes.forEach((cls, idx) => { %>
                            <div class="form-check p-2 rounded-3" style="background: rgba(255,255,255,0.6);">
                                <input class="form-check-input ms-0 me-2 quiz-cls-cb" type="checkbox" value="<%= cls.id %>" id="qCls_<%= cls.id %>"<%= idx === 0 && classes.length > 0 ? ' checked' : '' %>>
                                <label class="form-check-label small fw-semibold text-dark" for="qCls_<%= cls.id %>">
                                    <%= cls.class_name %> (<%= cls.section %>)
                                </label>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="col-12 mt-4">
                    <button type="button" id="btnGenerateQuiz" class="btn btn-liquid-primary w-100 py-2 fs-6 shadow">
                        <i class="bi bi-stars me-2"></i> Generate Questions with AI
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Questions Preview & Save -->
    <div class="col-lg-7">
        <div class="glass-card p-4 h-100 d-flex flex-column">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h5 class="fw-bold mb-0">Generated Questions & Answer Key</h5>
                    <div class="d-flex align-items-center gap-2">
                        <span id="questionCountBadge" class="badge-emerald">0 Questions</span>
                        <span id="quizGroundBadge" class="small fw-semibold text-muted">Plan: not provided</span>
                    </div>
                </div>

                <div id="quizReviewBox" class="mb-3" style="display: none;"></div>

                <div id="quizQuestionsContainer" style="flex: 1 1 auto; min-height: 0; overflow-y: auto; max-height: min(1300px, 130vh);">
                    <div class="text-center text-muted p-5">
                        <i class="bi bi-card-checklist fs-1 text-warning d-block mb-2"></i>
                        <h6>No Questions Generated Yet</h6>
                        <p class="small">Configure your parameters on the left and click "Generate Questions with AI".</p>
                    </div>
                </div>
            </div>

            <div class="border-top pt-3 mt-3 d-flex justify-content-end gap-2 d-none" id="saveQuizActions" style="display: none;">
                <button type="button" id="btnSaveQuiz" class="btn btn-liquid-primary px-4 py-2">
                    <i class="bi bi-check2-circle me-1"></i> Finalize & Publish Quiz
                </button>
            </div>
        </div>
    </div>
</div>

<script src="/js/quiz-maker-teacher.js"></script>
