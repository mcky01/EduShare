<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--zahs-emerald-deep);">My Teaching Classes</h2>
        <p class="text-muted small mb-0">Create new sections, view student rosters, and distribute learning activities.</p>
    </div>
    <button type="button" class="btn btn-liquid-primary" data-bs-toggle="modal" data-bs-target="#createClassModal">
        <i class="bi bi-plus-lg me-1"></i> Create Class Section
    </button>
</div>

<!-- Class Cards Grid -->
<div class="row g-3">
    <% if (classes.length === 0) { %>
        <div class="col-12">
            <div class="glass-card p-5 text-center text-muted">
                <i class="bi bi-mortarboard fs-1 text-success d-block mb-2"></i>
                <h5>No Classes Created Yet</h5>
                <p class="small">Click "Create Class Section" above to establish your first classroom.</p>
            </div>
        </div>
    <% } %>

    <% classes.forEach(c => { %>
        <div class="col-md-6 col-lg-4">
            <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between glass-card-hover">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge-emerald"><%= c.subject %></span>
                        <span class="badge-amber font-monospace">Code: <%= c.class_code %></span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1"><%= c.class_name %></h5>
                    <p class="small text-muted mb-3"><%= c.grade_level %> &bull; Section <%= c.section %></p>
                    <div class="small text-secondary mb-3">
                        <div><i class="bi bi-people me-1 text-success"></i> <%= c.student_count || 0 %> Students Enrolled</div>
                        <div><i class="bi bi-geo-alt me-1 text-success"></i> <%= c.room || 'Room 201' %></div>
                        <div><i class="bi bi-calendar3 me-1 text-success"></i> <%= c.schedule || 'Regular Schedule' %></div>
                    </div>
                </div>
                <div class="border-top pt-3" style="border-color: rgba(16,185,129,0.15) !important;">
                    <a href="/teacher/classes/<%= c.id %>" class="btn btn-sm btn-liquid-primary w-100 text-center">
                        Open Class Hub &rarr;
                    </a>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<!-- Modal: Create Class -->
<div class="modal fade modal-glass" id="createClassModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-mortarboard text-success me-2"></i>Create New Class Section</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/teacher/classes" method="POST">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold">Class Name / Title</label>
                            <input type="text" name="class_name" class="glass-input" placeholder="e.g. English 7 - Section Rizal" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Subject Area</label>
                            <input type="text" name="subject" class="glass-input" placeholder="e.g. English" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Grade Level</label>
                            <select name="grade_level" class="glass-input">
                                <option value="Grade 7">Grade 7</option>
                                <option value="Grade 8">Grade 8</option>
                                <option value="Grade 9">Grade 9</option>
                                <option value="Grade 10">Grade 10</option>
                                <option value="Grade 11">Grade 11</option>
                                <option value="Grade 12">Grade 12</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Section Name</label>
                            <input type="text" name="section" class="glass-input" placeholder="e.g. Rizal" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Classroom / Room</label>
                            <input type="text" name="room" class="glass-input" placeholder="e.g. Room 204">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Schedule / Time</label>
                            <input type="text" name="schedule" class="glass-input" placeholder="e.g. Mon/Wed/Fri 8:00 AM - 9:00 AM">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-liquid-primary">Create Class</button>
                </div>
            </form>
        </div>
    </div>
</div>
