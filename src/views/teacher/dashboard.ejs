<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--zahs-emerald-deep);">Teacher Dashboard</h2>
        <p class="text-muted small mb-0">Welcome back, Teacher <%= user.first_name %>! Here is your classroom teaching overview.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/teacher/lesson-generator" class="btn btn-liquid-primary">
            <i class="bi bi-stars me-1"></i> AI Lesson Generator
        </a>
        <a href="/teacher/quiz-maker" class="btn btn-liquid-amber">
            <i class="bi bi-card-checklist me-1"></i> AI Quiz Maker
        </a>
    </div>
</div>

<!-- Stat Cards -->
<% const _hasSubs = (typeof recentSubmissions !== 'undefined' && recentSubmissions && recentSubmissions.length > 0); %>
<% const _gradeHref = _hasSubs ? ('/teacher/activities/' + recentSubmissions[0].activity_id + '/classes/' + recentSubmissions[0].class_id + '/grading') : '/teacher/classes'; %>
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a href="/teacher/classes" class="text-decoration-none text-reset d-block">
        <div class="glass-card stat-card-glass glass-card-hover">
            <div class="stat-icon-wrapper stat-icon-emerald">
                <i class="bi bi-mortarboard"></i>
            </div>
            <div>
                <div class="stat-value"><%= stats.classes %></div>
                <div class="stat-label">Assigned Classes</div>
            </div>
        </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="d-block">
        <div class="glass-card stat-card-glass glass-card-hover">
            <div class="stat-icon-wrapper stat-icon-emerald">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="stat-value"><%= stats.students %></div>
                <div class="stat-label">Total Students</div>
            </div>
        </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a href="<%= _gradeHref %>" class="text-decoration-none text-reset d-block">
        <div class="glass-card stat-card-glass glass-card-hover">
            <div class="stat-icon-wrapper stat-icon-amber">
                <i class="bi bi-pencil-square"></i>
            </div>
            <div>
                <div class="stat-value"><%= stats.toGrade %></div>
                <div class="stat-label">Submissions To Grade</div>
            </div>
        </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a href="/teacher/quiz-maker" class="text-decoration-none text-reset d-block">
        <div class="glass-card stat-card-glass glass-card-hover">
            <div class="stat-icon-wrapper stat-icon-emerald">
                <i class="bi bi-question-diamond"></i>
            </div>
            <div>
                <div class="stat-value"><%= stats.quizzes %></div>
                <div class="stat-label">Created Quizzes</div>
            </div>
        </div>
        </a>
    </div>
</div>

<!-- Classes Grid Preview -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="fw-bold mb-0">My Active Classes</h5>
    <div class="d-flex align-items-center gap-2">
        <%- include('../partials/view-toggle', { scope: 'teacher-dashboard-classes', label: 'dashboard classes' }) %>
        <a href="/teacher/classes" class="small text-success fw-bold text-decoration-none">Manage All Classes &rarr;</a>
    </div>
</div>

<div class="row g-3 mb-4" data-view-cards="teacher-dashboard-classes">
    <% if (classes.length === 0) { %>
        <div class="col-12">
            <div class="glass-card p-5 text-center text-muted">
                <i class="bi bi-journal-plus fs-1 text-success d-block mb-2"></i>
                <h5>No Classes Created Yet</h5>
                <p class="small">Click "Create Class" to establish your first section with an auto-generated student join code.</p>
                <a href="/teacher/classes" class="btn btn-liquid-primary">Go to Classes to create your first section</a>
            </div>
        </div>
    <% } %>

    <% classes.forEach(c => { %>
        <div class="col-md-6 col-lg-4">
            <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between glass-card-hover">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge-emerald"><%= c.subject %></span>
                        <span class="badge-amber font-monospace d-inline-flex align-items-center gap-1">Code: <%= c.class_code %>
                            <button type="button" class="btn btn-sm btn-glass py-0 px-1 copy-code-btn" data-code="<%= c.class_code %>" title="Copy class code" aria-label="Copy class code <%= c.class_code %>"><i class="bi bi-clipboard"></i></button>
                        </span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1"><%= c.class_name %></h5>
                    <p class="small text-muted mb-3"><%= c.grade_level %> &bull; Section <%= c.section %></p>
                    <div class="small text-secondary mb-3">
                        <i class="bi bi-clock me-1 text-success"></i> <%= c.schedule || 'Flexible' %><br>
                        <i class="bi bi-geo-alt me-1 text-success"></i> <%= c.room || 'Regular Classroom' %>
                    </div>
                </div>
                <div class="border-top pt-3 d-flex justify-content-between align-items-center" style="border-color: rgba(16,185,129,0.15) !important;">
                    <a href="/teacher/classes/<%= c.id %>" class="btn btn-sm btn-liquid-primary w-100 text-center">
                        Open Class Hub &rarr;
                    </a>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<% if (classes.length > 0) { %>
<div class="glass-table-container d-none mb-4" data-view-table="teacher-dashboard-classes">
    <div class="table-responsive">
        <table class="glass-table">
            <thead>
                <tr>
                    <th scope="col">Class</th>
                    <th scope="col">Subject</th>
                    <th scope="col">Code</th>
                    <th scope="col">Schedule</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% classes.forEach(c => { %>
                    <tr>
                        <td>
                            <div class="fw-bold text-dark"><%= c.class_name %></div>
                            <div class="small text-muted"><%= c.grade_level %> &bull; Section <%= c.section %></div>
                        </td>
                        <td><span class="badge-emerald"><%= c.subject %></span></td>
                        <td class="font-monospace fw-semibold small"><%= c.class_code %></td>
                        <td class="small text-muted"><%= c.schedule || 'Flexible' %></td>
                        <td class="text-end">
                            <a href="/teacher/classes/<%= c.id %>" class="btn btn-sm btn-liquid-primary">Open Class Hub &rarr;</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
<% } %>

<!-- Pending Submissions Queue -->
<div class="glass-card p-4">
    <% if (recentSubmissions && recentSubmissions.length > 0) { %>
        <h5 class="fw-bold mb-3"><i class="bi bi-inbox text-warning me-2"></i>Submissions Awaiting Grading</h5>
        <div class="table-responsive">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Class Section</th>
                        <th>Activity Title</th>
                        <th>Submitted At</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% recentSubmissions.forEach(sub => { %>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark"><%= sub.first_name %> <%= sub.last_name %></div>
                            </td>
                            <td><%= sub.class_name %></td>
                            <td class="fw-semibold text-success"><%= sub.activity_title %></td>
                            <td class="small text-muted"><%= new Date(sub.submitted_at).toLocaleString() %></td>
                            <td>
                                <a href="/teacher/activities/<%= sub.activity_id %>/classes/<%= sub.class_id %>/grading" class="btn btn-sm btn-glass text-success fw-bold">
                                    Grade &rarr;
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="text-center text-muted py-3">
            <i class="bi bi-inbox fs-2 d-block mb-2 text-success"></i>
            <h6 class="fw-bold text-dark">All caught up</h6>
            <p class="small mb-3">No submissions awaiting grading right now.</p>
            <a href="/teacher/classes" class="btn btn-sm btn-liquid-primary">View Classes</a>
        </div>
    <% } %>
</div>
<!-- Copy-to-clipboard handled globally by /js/app.js (covers .copy-code-btn + #copyFeedback). -->
<span class="small text-muted copy-feedback" id="copyFeedback" role="status" aria-live="polite"></span>
