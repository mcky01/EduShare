<!-- Class Header Banner -->
<div class="glass-card p-4 mb-4" id="classHeaderBanner" style="background: linear-gradient(135deg, rgba(13,82,44,0.1), rgba(245,158,11,0.06)), rgba(255,255,255,0.85);">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge-emerald"><%= cls.subject %></span>
                <span class="badge-amber font-monospace fs-6 px-3 py-1 d-inline-flex align-items-center gap-2">Student Join Code: <strong><%= cls.class_code %></strong>
                    <button type="button" class="btn btn-sm btn-glass py-0 px-1 copy-code-btn" data-code="<%= cls.class_code %>" data-feedback="classCodeFeedback" title="Copy class code" aria-label="Copy class code"><i class="bi bi-clipboard"></i></button>
                </span>
                <span class="small text-muted copy-feedback" id="classCodeFeedback" role="status" aria-live="polite"></span>
            </div>
            <h2 class="fw-bold text-dark mb-1"><%= cls.class_name %></h2>
            <div class="small text-muted">
                <%= cls.grade_level %> &bull; Section <%= cls.section %> &bull; <%= cls.room || 'Room 201' %> &bull; <%= cls.schedule || 'Regular Schedule' %>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-liquid-amber" data-bs-toggle="modal" data-bs-target="#postAnnouncementModal">
                <i class="bi bi-megaphone me-1"></i> Announce
            </button>
            <a href="/teacher/gradebook?classId=<%= cls.id %>" class="btn btn-glass">
                <i class="bi bi-table me-1"></i> Gradebook
            </a>
        </div>
    </div>
</div>

<!-- Scroll-only Sticky Context Bar: hidden at top, appears once the header scrolls away -->
<div class="glass-card px-3 py-2 mb-4 align-items-center gap-2 flex-wrap class-sticky-bar d-none" id="classStickyBar" role="region" aria-label="Class quick actions" style="position: sticky; top: 12px; z-index: 1020; display: none;">
    <span class="fw-bold small text-dark"><i class="bi bi-mortarboard text-success me-1"></i><%= cls.class_name %></span>
    <span class="badge-amber font-monospace d-inline-flex align-items-center gap-1"><%= cls.class_code %>
        <button type="button" class="btn btn-sm btn-glass py-0 px-1 copy-code-btn" data-code="<%= cls.class_code %>" data-feedback="classCodeFeedbackSticky" title="Copy class code" aria-label="Copy class code"><i class="bi bi-clipboard"></i></button>
    </span>
    <span class="small text-muted copy-feedback" id="classCodeFeedbackSticky" role="status" aria-live="polite"></span>
    <span class="ms-auto d-flex gap-2">
        <button type="button" class="btn btn-sm btn-liquid-amber" data-bs-toggle="modal" data-bs-target="#postAnnouncementModal"><i class="bi bi-megaphone me-1"></i>Announce</button>
        <a href="/teacher/gradebook?classId=<%= cls.id %>" class="btn btn-sm btn-glass"><i class="bi bi-table me-1"></i>Gradebook</a>
    </span>
</div>

<!-- Navigation Tabs -->
<ul class="nav nav-pills gap-2 mb-4 p-2 glass-card" style="background: rgba(255,255,255,0.65);">
    <li class="nav-item">
        <a class="nav-link rounded-pill fw-bold <%= activeTab === 'materials' ? 'active bg-success' : 'text-dark' %>" href="/teacher/classes/<%= cls.id %>?tab=materials">
            <i class="bi bi-folder me-1"></i> Materials (<%= materials.length %>)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill fw-bold <%= activeTab === 'activities' ? 'active bg-success' : 'text-dark' %>" href="/teacher/classes/<%= cls.id %>?tab=activities">
            <i class="bi bi-pencil-square me-1"></i> Activities (<%= activities.length %>)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill fw-bold <%= activeTab === 'quizzes' ? 'active bg-success' : 'text-dark' %>" href="/teacher/classes/<%= cls.id %>?tab=quizzes">
            <i class="bi bi-card-checklist me-1"></i> Quizzes (<%= quizzes.length %>)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill fw-bold <%= activeTab === 'announcements' ? 'active bg-success' : 'text-dark' %>" href="/teacher/classes/<%= cls.id %>?tab=announcements">
            <i class="bi bi-megaphone me-1"></i> Announcements (<%= announcements.length %>)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill fw-bold <%= activeTab === 'students' ? 'active bg-success' : 'text-dark' %>" href="/teacher/classes/<%= cls.id %>?tab=students">
            <i class="bi bi-people me-1"></i> Students (<%= students.length %>)
        </a>
    </li>
</ul>

<!-- TAB CONTENT -->
<% if (activeTab === 'materials') { %>
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h5 class="fw-bold mb-0">Class Learning Materials</h5>
        <div class="d-flex gap-2 align-items-center">
            <%- include('../partials/view-toggle', { scope: 'teacher-class-materials', label: 'class materials' }) %>
            <button type="button" class="btn btn-sm btn-glass" data-bs-toggle="modal" data-bs-target="#postFromLibraryModal">
                <i class="bi bi-plus-circle me-1"></i> Post From Library
            </button>
        </div>
    </div>

    <div class="row g-3" data-view-cards="teacher-class-materials">
        <% if (materials.length === 0) { %>
            <div class="col-12">
                <div class="glass-card p-5 text-center text-muted">
                    <i class="bi bi-file-earmark-text fs-2 d-block mb-2 text-success"></i>
                    <h6>No Materials Posted Yet</h6>
                    <p class="small">Share slide decks, reading guides, and study notes with this class section.</p>
                </div>
            </div>
        <% } %>

        <% materials.forEach(m => { %>
            <div class="col-md-6 col-lg-4">
                <div class="glass-card p-3 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge-emerald"><%= m.subject || 'Material' %></span>
                            <span class="small text-muted font-monospace"><%= m.file_size || '' %></span>
                        </div>
                        <h6 class="fw-bold text-dark mb-1"><%= m.title %></h6>
                        <p class="small text-muted mb-3"><%= m.description || 'No description provided.' %></p>
                    </div>
                    <div class="border-top pt-2 d-flex justify-content-between align-items-center">
                        <span class="small text-muted"><%= new Date(m.posted_at).toLocaleDateString() %></span>
                        <% if (m.file_path) { %>
                            <a href="<%= m.file_path %>" target="_blank" class="btn btn-sm btn-glass">
                                <i class="bi bi-download me-1"></i> View / Download
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <% if (materials.length > 0) { %>
    <div class="glass-table-container d-none" data-view-table="teacher-class-materials">
        <div class="table-responsive">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Subject</th>
                        <th scope="col">Size</th>
                        <th scope="col">Posted</th>
                        <th scope="col" class="text-end">File</th>
                    </tr>
                </thead>
                <tbody>
                    <% materials.forEach(m => { %>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark"><%= m.title %></div>
                                <div class="small text-muted"><%= m.description || 'No description provided.' %></div>
                            </td>
                            <td><span class="badge-emerald"><%= m.subject || 'Material' %></span></td>
                            <td class="small text-muted font-monospace"><%= m.file_size || '' %></td>
                            <td class="small text-muted"><%= m.posted_at ? new Date(m.posted_at).toLocaleDateString() : 'N/A' %></td>
                            <td class="text-end">
                                <% if (m.file_path) { %>
                                    <a href="<%= m.file_path %>" target="_blank" class="btn btn-sm btn-glass">
                                        <i class="bi bi-download me-1"></i> View / Download
                                    </a>
                                <% } else { %>
                                    <span class="small text-muted">—</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

<% } else if (activeTab === 'activities') { %>
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h5 class="fw-bold mb-0">Class Activities & Assignments</h5>
        <div class="d-flex gap-2 align-items-center">
            <%- include('../partials/view-toggle', { scope: 'teacher-class-activities', label: 'class activities' }) %>
            <button type="button" class="btn btn-sm btn-liquid-primary" data-bs-toggle="modal" data-bs-target="#createActivityModal">
                <i class="bi bi-plus-lg me-1"></i> Add Activity
            </button>
        </div>
    </div>

    <div class="row g-3" data-view-cards="teacher-class-activities">
        <% if (activities.length === 0) { %>
            <div class="col-12">
                <div class="glass-card p-5 text-center text-muted">
                    <i class="bi bi-clipboard-check fs-2 d-block mb-2 text-success"></i>
                    <h6>No Activities Assigned Yet</h6>
                    <p class="small">Assign performance tasks or homework for students to submit online.</p>
                </div>
            </div>
        <% } %>

        <% activities.forEach(act => { %>
            <div class="col-md-6 col-lg-4">
                <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge-amber"><%= act.points %> Points</span>
                            <span class="small text-muted">Due: <%= act.due_date ? new Date(act.due_date).toLocaleDateString() : 'No deadline' %></span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2"><%= act.title %></h5>
                        <p class="small text-secondary mb-3" style="max-height: 80px; overflow-y: auto;"><%= act.instructions || 'Follow instructions provided.' %></p>
                        <% if (act.file_path) { %>
                            <div class="mb-3">
                                <a href="<%= act.file_path %>" target="_blank" rel="noopener" class="btn btn-sm btn-glass">
                                    <i class="bi bi-paperclip me-1"></i> Worksheet Attachment
                                </a>
                            </div>
                        <% } %>
                    </div>
                    <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                        <span class="small text-muted"><%= act.submission_count %> / <%= act.total_students %> Submitted</span>
                        <a href="/teacher/activities/<%= act.id %>/classes/<%= cls.id %>/grading" class="btn btn-sm btn-liquid-primary">
                            Review & Grade &rarr;
                        </a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <% if (activities.length > 0) { %>
    <div class="glass-table-container d-none" data-view-table="teacher-class-activities">
        <div class="table-responsive">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th scope="col">Activity</th>
                        <th scope="col">Points</th>
                        <th scope="col">Due</th>
                        <th scope="col">Submissions</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% activities.forEach(act => { %>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark"><%= act.title %></div>
                                <div class="small text-muted"><%= act.instructions || 'Follow instructions provided.' %></div>
                                <% if (act.file_path) { %>
                                    <a href="<%= act.file_path %>" target="_blank" rel="noopener" class="small text-success fw-bold">
                                        <i class="bi bi-paperclip me-1"></i> Worksheet Attachment
                                    </a>
                                <% } %>
                            </td>
                            <td><span class="badge-amber"><%= act.points %> Pts</span></td>
                            <td class="small text-muted"><%= act.due_date ? new Date(act.due_date).toLocaleDateString() : 'No deadline' %></td>
                            <td class="small"><%= act.submission_count %> / <%= act.total_students %></td>
                            <td class="text-end">
                                <a href="/teacher/activities/<%= act.id %>/classes/<%= cls.id %>/grading" class="btn btn-sm btn-liquid-primary">
                                    Review & Grade &rarr;
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

<% } else if (activeTab === 'quizzes') { %>
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h5 class="fw-bold mb-0">Scheduled Online Quizzes</h5>
        <div class="d-flex gap-2 align-items-center">
            <%- include('../partials/view-toggle', { scope: 'teacher-class-quizzes', label: 'class quizzes' }) %>
            <a href="/teacher/quiz-maker" class="btn btn-sm btn-liquid-amber">
                <i class="bi bi-plus-lg me-1"></i> AI Quiz Maker
            </a>
        </div>
    </div>

    <div class="row g-3" data-view-cards="teacher-class-quizzes">
        <% if (quizzes.length === 0) { %>
            <div class="col-12">
                <div class="glass-card p-5 text-center text-muted">
                    <i class="bi bi-card-checklist fs-2 d-block mb-2 text-warning"></i>
                    <h6>No Quizzes Assigned Yet</h6>
                    <p class="small">Use the AI Quiz Maker to generate and assign auto-graded assessments.</p>
                </div>
            </div>
        <% } %>

        <% quizzes.forEach(q => { %>
            <div class="col-md-6 col-lg-4">
                <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge-emerald"><%= q.total_questions %> Questions</span>
                            <span class="badge-amber"><%= q.time_limit_minutes %> Mins</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1"><%= q.title %></h5>
                        <p class="small text-muted mb-3"><%= q.description || 'Curriculum-aligned quiz assessment.' %></p>
                    </div>
                    <div class="border-top pt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span class="small text-muted"><%= q.attempt_count || 0 %> Students Taken</span>
                        <span class="d-flex align-items-center gap-2 flex-wrap">
                            <% if (q.start_time || q.end_time) { %>
                                <span class="small text-muted font-monospace">
                                    <%= q.start_time ? new Date(q.start_time).toLocaleString() : 'Open' %> &ndash; <%= q.end_time ? new Date(q.end_time).toLocaleString() : 'No close' %>
                                </span>
                            <% } %>
                            <% if (q.is_published == 1) { %>
                                <span class="badge-emerald">Published</span>
                            <% } else { %>
                                <span class="badge-gray">Draft</span>
                            <% } %>
                        </span>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <% if (quizzes.length > 0) { %>
    <div class="glass-table-container d-none" data-view-table="teacher-class-quizzes">
        <div class="table-responsive">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th scope="col">Quiz</th>
                        <th scope="col">Questions</th>
                        <th scope="col">Time</th>
                        <th scope="col">Schedule</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% quizzes.forEach(q => { %>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark"><%= q.title %></div>
                                <div class="small text-muted"><%= q.description || 'Curriculum-aligned quiz assessment.' %> &bull; <%= q.attempt_count || 0 %> taken</div>
                            </td>
                            <td><span class="badge-emerald"><%= q.total_questions %></span></td>
                            <td><span class="badge-amber"><%= q.time_limit_minutes %> min</span></td>
                            <td class="small text-muted font-monospace">
                                <% if (q.start_time || q.end_time) { %>
                                    <%= q.start_time ? new Date(q.start_time).toLocaleString() : 'Open' %> &ndash; <%= q.end_time ? new Date(q.end_time).toLocaleString() : 'No close' %>
                                <% } else { %> — <% } %>
                            </td>
                            <td>
                                <% if (q.is_published == 1) { %>
                                    <span class="badge-emerald">Published</span>
                                <% } else { %>
                                    <span class="badge-gray">Draft</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

<% } else if (activeTab === 'announcements') { %>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Class Announcements</h5>
        <button type="button" class="btn btn-sm btn-liquid-primary" data-bs-toggle="modal" data-bs-target="#postAnnouncementModal">
            <i class="bi bi-plus-lg me-1"></i> Post Announcement
        </button>
    </div>

    <div class="d-flex flex-column gap-3">
        <% if (announcements.length === 0) { %>
            <div class="glass-card p-5 text-center text-muted">
                <i class="bi bi-megaphone fs-2 d-block mb-2 text-success"></i>
                <h6>No Announcements Yet</h6>
                <p class="small">Post your first bulletin or syllabus notice for your students.</p>
            </div>
        <% } %>

        <% announcements.forEach(a => { %>
            <div class="glass-card p-4 <%= a.is_pinned ? 'border-start border-4 border-warning' : '' %>">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <% if (a.is_pinned) { %>
                            <span class="badge-amber"><i class="bi bi-pin-angle-fill me-1"></i>PINNED</span>
                        <% } %>
                        <h5 class="fw-bold text-dark mb-0"><%= a.title %></h5>
                    </div>
                    <span class="small text-muted"><%= new Date(a.created_at).toLocaleString() %></span>
                </div>
                <p class="small text-secondary mb-2" style="white-space: pre-wrap;"><%= a.message %></p>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-emerald" title="Students who opened this announcement"><i class="bi bi-eye me-1"></i><%= typeof a.read_count !== 'undefined' ? a.read_count : 0 %> read</span>
                    <% if (a.category) { %><span class="small text-muted"><%= a.category %></span><% } %>
                </div>
            </div>
        <% }) %>
    </div>

<% } else if (activeTab === 'students') { %>
    <%- include('../partials/local-filter', {
        scope: 'teacher-class-students',
        searchId: 'studentSearch',
        searchPlaceholder: 'Search LRN or name...',
        searchLabel: 'Search students by LRN or name',
        countId: 'studentCount',
        countLabel: 'Enrolled'
    }) %>

    <div class="glass-table-container">
        <div class="table-responsive">
            <table class="glass-table">
                <thead>
                    <tr>
                        <th>Student Name</th>
                        <th>LRN</th>
                        <th>Gender</th>
                        <th>Grade & Section</th>
                        <th>Enrolled Date</th>
                    </tr>
                </thead>
                <tbody id="studentRosterBody">
                    <% if (students.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                No students have joined this class yet. Share the code <strong><%= cls.class_code %></strong> with your students.
                            </td>
                        </tr>
                    <% } %>
                    <% students.forEach(s => { %>
                        <tr data-filter-scope="teacher-class-students" data-search="<%= ((s.last_name || '') + ' ' + (s.first_name || '') + ' ' + (s.lrn || '') + ' ' + (s.email || '')).toLowerCase() %>">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="user-avatar-initials" style="width: 34px; height: 34px; font-size: 0.8rem;">
                                        <%= s.first_name[0] %><%= s.last_name[0] %>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark"><%= s.last_name %>, <%= s.first_name %></div>
                                        <div class="small text-muted"><%= s.email %></div>
                                    </div>
                                </div>
                            </td>
                            <td class="font-monospace fw-semibold"><%= s.lrn %></td>
                            <td><%= s.gender %></td>
                            <td><%= s.grade_level %> - <%= s.section %></td>
                            <td class="small text-muted"><%= new Date(s.enrollment_date).toLocaleDateString() %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
<% } %>

<!-- Modal: Post Announcement -->
<div class="modal fade modal-glass" id="postAnnouncementModal" tabindex="-1" aria-hidden="true" aria-labelledby="postAnnouncementTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="postAnnouncementTitle"><i class="bi bi-megaphone text-success me-2"></i>Post Class Announcement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/teacher/classes/<%= cls.id %>/announcements" method="POST">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Title</label>
                        <input type="text" name="title" class="glass-input" placeholder="e.g. Schedule for First Quarter Assessment" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Message Content</label>
                        <textarea name="message" class="glass-input" rows="4" placeholder="Write your announcement details here..." required></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Category</label>
                            <select name="category" class="glass-input">
                                <option value="general">General</option>
                                <option value="academic">Academic</option>
                                <option value="reminder">Reminder</option>
                                <option value="urgent">Urgent</option>
                            </select>
                        </div>
                        <div class="col-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="is_pinned" value="1" id="pinnedCheck">
                                <label class="form-check-label small fw-bold" for="pinnedCheck">Pin Announcement</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-liquid-primary">Publish Announcement</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Create Activity -->
<div class="modal fade modal-glass" id="createActivityModal" tabindex="-1" aria-hidden="true" aria-labelledby="createActivityTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="createActivityTitle"><i class="bi bi-file-earmark-plus text-success me-2"></i>Assign Class Activity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/teacher/activities" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="class_ids" value="<%= cls.id %>">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Activity Title</label>
                        <input type="text" name="title" class="glass-input" placeholder="e.g. Activity 2: Poem Analysis Essay" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Instructions</label>
                        <textarea name="instructions" class="glass-input" rows="3" placeholder="Provide clear task instructions for students..."></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Max Points</label>
                            <input type="number" name="points" class="glass-input" value="100" required min="1">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Due Date</label>
                            <input type="date" name="due_date" class="glass-input">
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Attach Worksheet / Guide (Optional)</label>
                        <input type="file" name="activity_file" class="glass-input" accept=".pdf,.docx,.pptx,.xlsx,.txt,.jpg,.jpeg,.png,.gif,.webp">
                        <div class="form-text small text-muted">Max 50 MB.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-liquid-primary">Create Activity</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Post From Library -->
<div class="modal fade modal-glass" id="postFromLibraryModal" tabindex="-1" aria-hidden="true" aria-labelledby="postFromLibraryTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="postFromLibraryTitle"><i class="bi bi-folder-plus text-success me-2"></i>Post Material From Library</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/teacher/library/repost" method="POST">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="class_ids" value="<%= cls.id %>">
                <div class="modal-body">
                    <% if (availableLibrary.length === 0) { %>
                        <p class="text-muted small">No unposted library items available. You can upload new materials in your Material Library.</p>
                    <% } else { %>
                        <label class="form-label small fw-bold">Select Material to Post</label>
                        <select name="item_id" class="glass-input mb-3" required>
                            <% availableLibrary.forEach(item => { %>
                                <option value="<%= item.id %>"><%= item.title %> (<%= item.subject %>)</option>
                            <% }) %>
                        </select>
                    <% } %>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <% if (availableLibrary.length > 0) { %>
                        <button type="submit" class="btn btn-liquid-primary">Post Material</button>
                    <% } %>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Scroll-only sticky bar — external file, CSP-safe (see /js/class-detail.js). -->
<script src="/js/class-detail.js" defer></script>
