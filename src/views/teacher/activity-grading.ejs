<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a href="/teacher/classes/<%= cls.id %>?tab=activities" class="small text-success text-decoration-none fw-bold">&larr; Back to Class</a>
            <span class="text-muted">&bull;</span>
            <span class="badge-emerald"><%= cls.class_name %></span>
        </div>
        <h2 class="fw-bold mb-0 text-dark"><%= activity.title %></h2>
        <div class="small text-muted">Max Score: <%= activity.points %> Points &bull; Due: <%= activity.due_date ? new Date(activity.due_date).toLocaleDateString() : 'None' %></div>
    </div>
</div>

<% const _graded = submissions.filter(s => s.status === 'graded').length; %>
<!-- Progress Header + Status Filter -->
<div class="glass-card p-3 mb-3 d-flex align-items-center gap-3 flex-wrap" data-grading-progress data-total="<%= submissions.length %>" data-graded="<%= _graded %>">
    <span class="fw-bold small text-dark"><i class="bi bi-clipboard-check text-success me-1"></i>Graded <span id="gradedCount"><%= _graded %></span> / <%= submissions.length %></span>
    <div class="progress flex-grow-1" style="min-width: 160px; height: 10px;">
        <div class="progress-bar bg-success" id="gradedBar" role="progressbar" style="width: <%= submissions.length ? Math.round(_graded / submissions.length * 100) : 0 %>%;" aria-valuenow="<%= _graded %>" aria-valuemin="0" aria-valuemax="<%= submissions.length %>"></div>
    </div>
    <select id="gradeStatusFilter" class="glass-input py-1 small" style="max-width: 180px;" aria-label="Filter by grading status">
        <option value="all">All</option>
        <option value="graded">Graded</option>
        <option value="submitted">Submitted</option>
        <option value="missing">Missing</option>
    </select>
    <button type="button" class="btn btn-sm btn-liquid-primary" id="bulkSaveBtn" data-bulk-save data-activity-id="<%= activity.id %>" data-class-id="<%= cls.id %>" data-grade-endpoint="/teacher/activities/grade">
        <i class="bi bi-check-all me-1"></i>Save All Graded
    </button>
    <span class="small text-muted" id="bulkSaveStatus" role="status" aria-live="polite"></span>
</div>

<div class="glass-table-container">
    <div class="table-responsive">
        <table class="glass-table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Status</th>
                    <th>Submitted File / Note</th>
                    <th>Submitted Time</th>
                    <th>Score / Grade</th>
                    <th>Feedback</th>
                    <th>Save</th>
                </tr>
            </thead>
            <tbody id="gradingBody">
                <% submissions.forEach(sub => { %>
                    <% const _st = sub.status === 'graded' ? 'graded' : (sub.submission_id ? 'submitted' : 'missing'); %>
                    <tr data-grade-row data-status="<%= _st %>" data-student-id="<%= sub.student_profile_id %>" data-submission-id="<%= sub.submission_id || '' %>">
                        <td>
                            <div class="fw-bold text-dark"><%= sub.last_name %>, <%= sub.first_name %></div>
                            <div class="small text-muted">LRN: <%= sub.lrn %></div>
                        </td>
                        <td>
                            <% if (sub.status === 'graded') { %>
                                <span class="badge-emerald"><i class="bi bi-check2-circle me-1"></i>Graded</span>
                            <% } else if (sub.submission_id) { %>
                                <span class="badge-amber"><i class="bi bi-hourglass-split me-1"></i>Submitted</span>
                            <% } else { %>
                                <span class="badge-gray">Missing</span>
                            <% } %>
                        </td>
                        <td style="max-width: 250px;">
                            <% if (sub.file_path) { %>
                                <div class="mb-1">
                                    <a href="<%= sub.file_path %>" target="_blank" class="btn btn-sm btn-glass text-success fw-semibold">
                                        <i class="bi bi-download me-1"></i> View Attachment
                                    </a>
                                </div>
                            <% } %>
                            <% if (sub.note) { %>
                                <div class="small text-secondary fst-italic">"<%= sub.note %>"</div>
                            <% } %>
                            <% if (!sub.file_path && !sub.note) { %>
                                <span class="text-muted small">&mdash;</span>
                            <% } %>
                        </td>
                        <td class="small text-muted font-monospace">
                            <%= sub.submitted_at ? new Date(sub.submitted_at).toLocaleString() : 'Not submitted' %>
                        </td>
                        <td style="width: 130px;">
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.5" name="score" form="grade-form-<%= sub.student_profile_id %>" data-grade-score data-max="<%= activity.points %>" class="glass-input text-center fw-bold text-success py-1" value="<%= sub.score != null ? sub.score : '' %>" max="<%= activity.points %>" min="0" placeholder="0">
                                    <span class="input-group-text bg-transparent border-0 small text-muted">/ <%= activity.points %></span>
                                </div>
                            </td>
                            <td>
                                <input type="text" name="feedback" form="grade-form-<%= sub.student_profile_id %>" data-grade-feedback class="glass-input py-1 small" placeholder="Teacher comments..." value="<%= sub.feedback || '' %>">
                            </td>
                            <td>
                                <form id="grade-form-<%= sub.student_profile_id %>" action="/teacher/activities/grade" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                    <input type="hidden" name="submission_id" value="<%= sub.submission_id || '' %>">
                                    <input type="hidden" name="activity_id" value="<%= activity.id %>">
                                    <input type="hidden" name="class_id" value="<%= cls.id %>">
                                    <input type="hidden" name="student_id" value="<%= sub.student_profile_id %>">
                                    <button type="submit" class="btn btn-sm btn-liquid-primary" data-grade-save aria-label="Save grade">
                                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Grading helpers (status filter, score clamp, bulk-save) — external file, CSP-safe. -->
<script src="/js/grading.js" defer></script>
