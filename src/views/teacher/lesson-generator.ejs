<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge-emerald"><i class="bi bi-cpu me-1"></i>Ollama Qwen 2.5 7B Plan-grounded</span>
            <span class="badge-amber">From your DLL / DLP / ILAW</span>
        </div>
        <h2 class="fw-bold mb-0 text-dark">AI Lesson Discussion-Deck Generator</h2>
        <p class="text-muted small mb-0">Paste your finished lesson plan (or upload the file). The AI translates it into projection slides (like PPT/Canva) that support — not replace — your plan.</p>
    </div>
</div>

<!-- STEP 1: Lesson Plan Input -->
<div id="lessonStep1" class="glass-card p-4 p-md-5 mb-4">
    <h4 class="fw-bold mb-3"><i class="bi bi-journal-text text-success me-2"></i>Step 1: Provide Your Lesson Plan</h4>
    <p class="text-muted small mb-4">Your plan is the source of truth. Facts, examples, activities, and assessments on the slides come only from this plan.</p>

    <div class="row g-3" id="lessonSetupForm">
        <div class="col-md-4">
            <label class="form-label small fw-bold">Plan Format</label>
            <select id="planFormat" class="glass-input">
                <option value="ilaw" selected>ILAW</option>
                <option value="dll">DLL</option>
                <option value="dlp">DLP</option>
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label small fw-bold">Focus Session</label>
            <select id="focusSession" class="glass-input">
                <option value="">Whole plan (single lesson)</option>
                <option value="S1">Session 1</option>
                <option value="S2">Session 2</option>
                <option value="S3">Session 3</option>
                <option value="S4">Session 4</option>
                <option value="S5">Session 5</option>
            </select>
            <div class="form-text small">Multi-session plans: one deck per session. The full plan stays as context.</div>
        </div>

        <div class="col-md-4">
            <label class="form-label small fw-bold">Plan File <span class="text-muted fw-normal">(optional)</span></label>
            <input type="file" id="planFile" class="glass-input" accept=".pdf,.docx,.doc,.txt">
            <div class="form-text small">PDF, DOCX, DOC, or TXT (max 8MB). Tables and session columns are preserved.</div>
        </div>

        <div class="col-12">
            <label class="form-label small fw-bold">Lesson Plan <span class="text-muted fw-normal">(paste your DLL/DLP/ILAW as text — or upload a file and review it as an editable table)</span></label>
            <textarea id="planText" class="glass-input" rows="6" placeholder="Paste your full lesson plan here: Intentions/Objectives, Learning Experiences/Procedure, Assessment, Ways Forward/Assignment..."></textarea>
            <div class="d-flex justify-content-between align-items-center mt-1 flex-wrap gap-2">
                <div id="planCoverage" class="small fw-semibold text-muted">Coverage: paste or upload a plan to preview.</div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="planViewToggle" class="btn btn-sm btn-glass py-0 px-2 small" style="display: none;">Show full plan</button>
                    <div id="planCharCount" class="small text-muted">0 / 20000</div>
                </div>
            </div>
            <div id="planChecklist" class="mt-2" style="display: none;"></div>
            <div id="planScopeBanner" class="alert alert-info py-2 px-3 mt-2 mb-0 small" style="display: none;"></div>
            <div id="planParseStatus" class="small mt-1 text-muted"></div>
            <!-- Editable section table (populated after file parse; one row per plan section, one column per session). -->
            <div id="planGridWrap" class="mt-3" style="display: none;">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <h6 class="fw-bold mb-0"><i class="bi bi-table text-success me-1"></i>Review & Edit Plan Sections</h6>
                    <span class="small text-muted">Click any cell to edit. Edits are used for generation.</span>
                </div>
                <div class="table-responsive">
                    <table class="glass-table small" id="planGrid">
                        <thead><tr id="planGridHead"></tr></thead>
                        <tbody id="planGridBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label small fw-bold">Lesson Topic <span class="text-muted fw-normal" id="topicAutofillHint">(auto-fills from plan)</span></label>
            <input type="text" id="lessonTopic" class="glass-input" placeholder="e.g. Navigating Conflicts: Filipino Values">
        </div>

        <div class="col-md-3">
            <label class="form-label small fw-bold">Subject Area</label>
            <input type="text" id="lessonSubject" class="glass-input" value="English">
        </div>

        <div class="col-md-3">
            <label class="form-label small fw-bold">Grade Level</label>
            <% const _lessonGrade = (typeof teacherProfile !== 'undefined' && teacherProfile && teacherProfile.grade_level) ? teacherProfile.grade_level : 'Grade 7'; %>
            <select id="lessonGrade" class="glass-input">
                <% ['Grade 7', 'Grade 8', 'Grade 9', 'Grade 10', 'Grade 11', 'Grade 12'].forEach(function(g) { %>
                    <option value="<%= g %>" <%= _lessonGrade === g ? 'selected' : '' %>><%= g %></option>
                <% }); %>
            </select>
        </div>

        <div class="col-12">
            <label class="form-label small fw-bold">Teacher Custom Pedagogical Instructions</label>
            <textarea id="lessonInstructions" class="glass-input" rows="2" placeholder="e.g. Emphasize Filipino values like pakikisama and bayanihan through active recitation and group story mapping"></textarea>
        </div>

        <div class="col-12 mt-2">
            <label class="small d-flex align-items-start gap-2 mb-0">
                <input type="checkbox" class="form-check-input mt-1" id="planAiDecl">
                <span>Include AI Declaration closing slide <span class="text-muted">(states the deck was AI-translated from my ILAW/DLL/DLP plan)</span></span>
            </label>
        </div>

        <div class="col-12 mt-2">
            <a class="small fw-bold text-success" data-bs-toggle="collapse" href="#lessonStyleOpts" role="button" aria-expanded="false" aria-controls="lessonStyleOpts">
                <i class="bi bi-sliders me-1"></i>Advanced Settings (Optional) <span class="badge-gray small">approach · integration · language · class context</span>
            </a>
        </div>

        <div class="col-12 collapse" id="lessonStyleOpts">
            <div class="row g-3 pt-2">
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Teaching Approach</label>
                    <div class="d-flex flex-column gap-1" id="approachGroup">
                        <% ['Inquiry-based','Collaborative','5E','Problem-based','Explicit teaching'].forEach(a => { %>
                            <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0 approach-cb" value="<%= a %>"> <%= a %></label>
                        <% }) %>
                        <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0" id="approachOtherCb"> Other:</label>
                        <input type="text" id="approachOther" class="glass-input py-1" placeholder="e.g. Game-based">
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold">Integration</label>
                    <div class="d-flex flex-column gap-1" id="integrationGroup">
                        <% ['Values formation','Technology','Local culture/community','Other subjects'].forEach(a => { %>
                            <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0 integration-cb" value="<%= a %>"> <%= a %></label>
                        <% }) %>
                        <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0" id="integrationOtherCb"> Other:</label>
                        <input type="text" id="integrationOther" class="glass-input py-1" placeholder="e.g. Environment">
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold">Available Resources / Constraints</label>
                    <div class="d-flex flex-column gap-1" id="resourcesGroup">
                        <% ['Textbook','Digital tools / projector','Low-resource setting','Printed activity sheets'].forEach(a => { %>
                            <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0 resources-cb" value="<%= a %>"> <%= a %></label>
                        <% }) %>
                        <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0" id="resourcesOtherCb"> Other:</label>
                        <input type="text" id="resourcesOther" class="glass-input py-1" placeholder="e.g. No internet">
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold">Language of Instruction</label>
                    <select id="lessonLanguage" class="glass-input">
                        <option value="">Auto</option>
                        <option value="English">English</option>
                        <option value="Filipino">Filipino</option>
                        <option value="Mother tongue">Mother tongue</option>
                        <option value="Code-switching">Code-switching (English/Filipino)</option>
                    </select>
                    <label class="form-label small fw-bold mt-3">Assessment Preference</label>
                    <div class="d-flex flex-column gap-1" id="assessmentGroup">
                        <% ['Formative checks each phase','Exit ticket','Group performance','Short quiz'].forEach(a => { %>
                            <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0 assessment-cb" value="<%= a %>"> <%= a %></label>
                        <% }) %>
                        <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0" id="assessmentOtherCb"> Other:</label>
                        <input type="text" id="assessmentOther" class="glass-input py-1" placeholder="e.g. Portfolio">
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold">Class Profile <span class="text-muted fw-normal">(auto-filled from plan when available)</span></label>
                    <div class="d-flex flex-column gap-1">
                        <% ['Large class (40+ learners)','Mixed reading levels','Strong in recitation, weak in writing','Limited prior knowledge','Fast learners, need enrichment'].forEach(a => { %>
                            <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0 profile-cb" value="<%= a %>"> <%= a %></label>
                        <% }) %>
                        <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0" id="profileOtherCb"> Other:</label>
                        <input type="text" id="profileOther" class="glass-input py-1" placeholder="e.g. 45 learners, visual learners">
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold">Inclusion Needs</label>
                    <div class="d-flex flex-column gap-1">
                        <% ['None','Large-print sheets','Extra time','Simplified instructions','Peer buddy support'].forEach(a => { %>
                            <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0 inclusion-cb" value="<%= a %>"> <%= a %></label>
                        <% }) %>
                        <label class="small d-flex align-items-center gap-2 mb-0"><input type="checkbox" class="form-check-input mt-0" id="inclusionOtherCb"> Other:</label>
                        <input type="text" id="inclusionOther" class="glass-input py-1" placeholder="e.g. Hearing support">
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold">Sessions / Duration</label>
                    <select id="lessonDuration" class="glass-input">
                        <option value="">Auto (60 mins)</option>
                        <option value="1 session of 45 mins">1 session of 45 mins</option>
                        <option value="1 session of 60 mins">1 session of 60 mins</option>
                        <option value="2 sessions of 60 mins">2 sessions of 60 mins</option>
                        <option value="1 week (4 sessions)">1 week (4 sessions)</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="col-12 mt-2">
            <label class="small d-flex align-items-start gap-2 mb-0">
                <input type="checkbox" class="form-check-input mt-1" id="planAttest">
                <span>I confirm this plan matches our CG/BOW. I understand slides must stay traceable to the plan and I will review before saving.</span>
            </label>
        </div>

        <div class="col-12 mt-3 pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div id="lessonGroundBadge" class="small fw-semibold text-muted">Plan: not provided yet</div>
            <button type="button" id="btnGenerateLesson" class="btn btn-liquid-primary px-4 py-2 fs-6 shadow">
                <i class="bi bi-stars me-2"></i> Generate Discussion Deck
            </button>
        </div>
    </div>
</div>

<!-- STEP 2 & 3: Generated Slides Preview & Save -->
<div id="lessonStep2" style="display: none;">
    <div class="glass-card p-4 mb-4" style="background: linear-gradient(135deg, rgba(16,185,129,0.15), rgba(245,158,11,0.08)), rgba(255,255,255,0.9);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge-emerald mb-2">Step 2: Interactive Review</span>
                <h3 class="fw-bold text-dark mb-1" id="displayLessonTopic">Lesson Title</h3>
                <div class="small text-muted" id="displayLessonComp">Competency</div>
                <div class="small text-muted mt-1">Projection lines are what learners see. <strong>Say / Do</strong> notes stay with you as the teacher.</div>
                <div class="small fw-semibold mt-1" id="displayPlanCoverage"></div>
                <div class="btn-group btn-group-sm mt-2" role="group" aria-label="Preview mode">
                    <button type="button" class="btn btn-glass active" id="viewProjectionBtn" aria-pressed="true"><i class="bi bi-easel me-1"></i>Projection</button>
                    <button type="button" class="btn btn-glass" id="viewTeacherBtn" aria-pressed="false"><i class="bi bi-mic me-1"></i>Teacher view</button>
                </div>
                <div class="small text-muted mt-1" id="projectionHint">Projection view hides citations, scripts, and notes — exactly what students would see.</div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-glass" data-print-lesson>
                    <i class="bi bi-printer me-1"></i> Print / PDF
                </button>
                <button type="button" class="btn btn-glass" id="btnExportPptx">
                    <i class="bi bi-file-earmark-ppt me-1"></i> Download .pptx
                </button>
                <button type="button" class="btn btn-liquid-primary" data-bs-toggle="modal" data-bs-target="#saveToLibraryModal">
                    <i class="bi bi-cloud-check me-1"></i> Save to My Library
                </button>
                <button type="button" class="btn btn-glass text-muted" data-back-to-setup>
                    <i class="bi bi-arrow-repeat me-1"></i> Regenerate
                </button>
            </div>
        </div>
        <div id="lessonPrepBox" class="mt-3" style="display: none;"></div>
    </div>

    <!-- Slide Cards Grid -->
    <div id="lessonReviewBox" class="mb-3" style="display: none;"></div>
    <div class="row" id="slidesPreviewContainer">
        <!-- Rendered dynamically by lesson-wizard.js -->
    </div>
</div>

<!-- Modal: Save to Library and Post to Class -->
<div class="modal fade modal-glass" id="saveToLibraryModal" tabindex="-1" aria-hidden="true" aria-labelledby="saveToLibraryTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="saveToLibraryTitle"><i class="bi bi-cloud-arrow-up text-success me-2"></i>Save & Post Lesson</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">This lesson presentation will be stored in your personal Material Library. Optionally check classes to post immediately:</p>
                <div class="d-flex flex-column gap-2 mb-3">
                    <% classes.forEach(cls => { %>
                        <div class="form-check p-2 rounded-3" style="background: rgba(255,255,255,0.7);">
                            <input class="form-check-input ms-0 me-2 post-class-checkbox" type="checkbox" value="<%= cls.id %>" id="postCls_<%= cls.id %>">
                            <label class="form-check-label fw-semibold text-dark" for="postCls_<%= cls.id %>">
                                <%= cls.class_name %> (<%= cls.grade_level %> - <%= cls.section %>)
                            </label>
                        </div>
                    <% }) %>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveLessonToLibrary" class="btn btn-liquid-primary">Confirm & Save</button>
            </div>
        </div>
    </div>
</div>

<!-- AI Lesson Generation Overlay -->
<div class="ai-lesson-overlay" id="aiLessonOverlay" role="alertdialog" aria-live="assertive" aria-hidden="true">
    <div class="ai-lesson-card">
        <div class="ai-lesson-spinner"></div>
        <div class="ai-lesson-title">AI is translating your plan into slides…</div>
        <div class="ai-lesson-sub">Reading your plan, sequencing the discussion, drafting visuals.</div>
        <div class="ai-lesson-sub">Local models typically take 60–120 seconds.</div>
        <div class="ai-lesson-timer" id="aiLessonTimer">00:00</div>
        <div class="ai-lesson-skeleton-row">
            <div class="ai-lesson-skeleton-mini"></div>
            <div class="ai-lesson-skeleton-mini"></div>
            <div class="ai-lesson-skeleton-mini"></div>
            <div class="ai-lesson-skeleton-mini"></div>
        </div>
    </div>
</div>

<script src="/js/lesson-wizard.js"></script>
