<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1" style="color: var(--zahs-emerald-deep);">My Material Library</h2>
        <p class="text-muted small mb-0">Personal instructional repository &bull; Upload presentations, worksheets, and AI-generated lessons.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-liquid-primary" data-bs-toggle="modal" data-bs-target="#uploadMaterialModal">
            <i class="bi bi-cloud-arrow-up me-1"></i> Upload Material
        </button>
        <a href="/teacher/lesson-generator" class="btn btn-liquid-amber">
            <i class="bi bi-stars me-1"></i> AI Lesson Generator
        </a>
    </div>
</div>

<!-- Filter Bar -->
<% const _subjects = [...new Set((items || []).map(i => (i.subject || 'General')))]; %>
<%- include('../partials/local-filter', {
    scope: 'library',
    searchId: 'librarySearch',
    searchPlaceholder: 'Filter by title or description...',
    searchLabel: 'Filter library by text',
    selectId: 'librarySubject',
    selectLabel: 'Filter library by subject',
    selectOptions: _subjects,
    selectAllLabel: 'All subjects',
    countId: 'libraryCount',
    countLabel: 'items',
    viewToggle: { scope: 'library', label: 'library' }
}) %>

<!-- Material Items: card grid + table view of the same items -->
<div class="row g-3" id="libraryGrid" data-view-cards="library">
    <% if (items.length === 0) { %>
        <div class="col-12">
            <div class="glass-card p-5 text-center text-muted">
                <i class="bi bi-folder2-open fs-1 text-success d-block mb-2"></i>
                <h5>Your Library is Empty</h5>
                <p class="small">Upload worksheets, documents, or use the AI Lesson Generator to create study slides.</p>
                <button type="button" class="btn btn-liquid-primary" data-bs-toggle="modal" data-bs-target="#uploadMaterialModal">
                    Upload Your First File
                </button>
            </div>
        </div>
    <% } %>

    <% items.forEach(item => { %>
        <div class="col-md-6 col-lg-4 library-card" data-filter-scope="library" data-search="<%= ((item.title || '') + ' ' + (item.description || '')).toLowerCase() %>" data-filter-group="<%= item.subject || 'General' %>" data-created="<%= item.created_at ? new Date(item.created_at).toLocaleDateString() : 'N/A' %>" data-file-type="<%= item.file_type || 'Document' %>" data-source="<%= item.source %>">
            <div class="glass-card p-4 h-100 d-flex flex-column justify-content-between glass-card-hover">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge-emerald"><%= item.subject || 'General' %></span>
                        <span class="badge-amber text-uppercase" style="font-size: 0.7rem;"><%= item.source %></span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1"><%= item.title %></h5>
                    <p class="small text-muted mb-3"><%= item.description || 'Instructional resource.' %></p>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <span class="badge-emerald" style="font-size: 0.7rem;"><i class="bi bi-file-earmark me-1"></i><%= item.file_type || 'Document' %></span>
                        <span class="badge-amber" style="font-size: 0.7rem;"><%= item.file_size || 'N/A' %></span>
                        <% if (item.created_at) { %><span class="badge-gray small">Posted <%= new Date(item.created_at).toLocaleDateString() %></span><% } %>
                    </div>
                </div>

                <div class="border-top pt-3 d-flex justify-content-between align-items-center" style="border-color: rgba(16,185,129,0.15) !important;">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-liquid-primary repost-picker" data-item-id="<%= item.id %>" data-item-title="<%= item.title %>" data-bs-toggle="modal" data-bs-target="#repostSharedModal">
                            <i class="bi bi-share me-1"></i> Post to Class
                        </button>
                        <% if (item.source === 'ai_lesson' && item.lesson_content) { %>
                            <button type="button" class="btn btn-sm btn-glass lesson-viewer" data-lesson="<%= encodeURIComponent(item.lesson_content) %>" data-lesson-title="<%= item.title %>" data-bs-toggle="modal" data-bs-target="#lessonViewModal">
                                <i class="bi bi-eye me-1"></i> View Slides
                            </button>
                        <% } %>
                    </div>
                    <% if (item.file_path) { %>
                        <a href="<%= item.file_path %>" target="_blank" class="btn btn-sm btn-glass">
                            <i class="bi bi-download"></i>
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<div class="glass-table-container d-none" id="libraryTableWrap" data-view-table="library">
    <div class="table-responsive">
        <table class="glass-table" id="libraryTable">
            <thead>
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Subject</th>
                    <th scope="col">Type</th>
                    <th scope="col">Size</th>
                    <th scope="col">Posted</th>
                    <th scope="col">Source</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="libraryTableBody">
                <% items.forEach(item => { %>
                    <tr class="library-row" data-filter-scope="library" data-search="<%= ((item.title || '') + ' ' + (item.description || '')).toLowerCase() %>" data-filter-group="<%= item.subject || 'General' %>">
                        <td>
                            <div class="fw-bold text-dark"><%= item.title %></div>
                            <div class="small text-muted"><%= item.description || 'Instructional resource.' %></div>
                        </td>
                        <td><span class="badge-emerald"><%= item.subject || 'General' %></span></td>
                        <td class="small"><%= item.file_type || 'Document' %></td>
                        <td class="small text-muted font-monospace"><%= item.file_size || 'N/A' %></td>
                        <td class="small text-muted"><%= item.created_at ? new Date(item.created_at).toLocaleDateString() : 'N/A' %></td>
                        <td><span class="badge-amber text-uppercase" style="font-size: 0.7rem;"><%= item.source %></span></td>
                        <td>
                            <div class="d-flex gap-1 justify-content-end flex-wrap">
                                <button type="button" class="btn btn-sm btn-liquid-primary repost-picker" data-item-id="<%= item.id %>" data-item-title="<%= item.title %>" data-bs-toggle="modal" data-bs-target="#repostSharedModal">
                                    <i class="bi bi-share me-1"></i> Post
                                </button>
                                <% if (item.source === 'ai_lesson' && item.lesson_content) { %>
                                    <button type="button" class="btn btn-sm btn-glass lesson-viewer" data-lesson="<%= encodeURIComponent(item.lesson_content) %>" data-lesson-title="<%= item.title %>" data-bs-toggle="modal" data-bs-target="#lessonViewModal">
                                        <i class="bi bi-eye me-1"></i> Slides
                                    </button>
                                <% } %>
                                <% if (item.file_path) { %>
                                    <a href="<%= item.file_path %>" target="_blank" class="btn btn-sm btn-glass" title="View / download <%= item.title %>" aria-label="View or download <%= item.title %>">
                                        <i class="bi bi-download"></i>
                                    </a>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Repost to Class (shared) -->
<div class="modal fade modal-glass" id="repostSharedModal" tabindex="-1" aria-hidden="true" aria-labelledby="repostSharedTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="repostSharedTitle">Post "<span id="repostItemTitle"></span>" to Class</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/teacher/library/repost" method="POST">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="item_id" id="repostItemId" value="">
                <div class="modal-body">
                    <label class="form-label small fw-bold mb-2">Select Target Class Sections:</label>
                    <div class="d-flex flex-column gap-2">
                        <% classes.forEach(cls => { %>
                            <div class="form-check p-2 rounded-3" style="background: rgba(255,255,255,0.6);">
                                <input class="form-check-input ms-0 me-2" type="checkbox" name="class_ids" value="<%= cls.id %>" id="clsShared_<%= cls.id %>">
                                <label class="form-check-label fw-semibold text-dark" for="clsShared_<%= cls.id %>">
                                    <%= cls.class_name %> (<%= cls.grade_level %> - <%= cls.section %>)
                                </label>
                            </div>
                        <% }) %>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-liquid-primary">Post to Selected</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Lesson Slide Viewer -->
<div class="modal fade modal-glass" id="lessonViewModal" tabindex="-1" aria-hidden="true" aria-labelledby="lessonViewTitle">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-easel text-success me-2"></i><span id="lessonViewTitle">Lesson Slides</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="lessonViewSlides" class="d-flex flex-column gap-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="/js/library-viewer.js"></script>

<!-- Modal: Upload Material -->
<div class="modal fade modal-glass" id="uploadMaterialModal" tabindex="-1" aria-hidden="true" aria-labelledby="uploadMaterialTitle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="uploadMaterialTitle"><i class="bi bi-cloud-arrow-up text-success me-2"></i>Upload Material</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/teacher/library/upload" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Document Title</label>
                        <input type="text" name="title" class="glass-input" placeholder="e.g. English 7 Module 1 Reading Packet" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Description / Summary</label>
                        <textarea name="description" class="glass-input" rows="3" placeholder="Brief summary of file contents..."></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Subject Area</label>
                            <input type="text" name="subject" class="glass-input" value="English">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Grade Level</label>
                            <select name="grade_level" class="glass-input">
                                <option value="Grade 7">Grade 7</option>
                                <option value="Grade 8">Grade 8</option>
                                <option value="Grade 9">Grade 9</option>
                                <option value="Grade 10">Grade 10</option>
                                <option value="Grade 11">Grade 11</option>
                                <option value="Grade 12">Grade 12</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Select File (PDF, DOCX, PPTX, XLSX, TXT, JPG, PNG, GIF, WEBP)</label>
                        <input type="file" name="material_file" class="glass-input" accept=".pdf,.docx,.pptx,.xlsx,.txt,.jpg,.jpeg,.png,.gif,.webp" required>
                        <div class="form-text small text-muted">Max 50 MB.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-liquid-primary">Upload & Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
