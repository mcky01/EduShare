# EduShare 2.0 Environment Configuration Template
PORT=3000
NODE_ENV=development

# Session Configuration
# Required in production (app throws on boot without it). Any long random string.
SESSION_SECRET=your_long_random_session_secret_key_here

# CORS: comma-separated allowed origins. Leave empty to disable CORS
# (same-origin only) — the safe default for a server-rendered app.
FRONTEND_ORIGINS=

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=edushare_db_v2

# AI Configuration (Local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
AI_TIMEOUT_MS=120000

# AI Primary provider: nine_router (default) or ollama.
# 9Router is an OpenAI-compatible gateway on your machine (http://localhost:20128/v1).
# Create a key at http://localhost:20128/dashboard, then paste it here.
# Verified working free model (2026-09-13): oc/nemotron-3-ultra-free
AI_PRIMARY=nine_router
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=paste_your_9router_key_here
NINE_ROUTER_MODEL=oc/nemotron-3-ultra-free
NINE_ROUTER_TIMEOUT_MS=90000

# RAG / curriculum grounding (zero-cost, fully local)
# Embeddings ALWAYS come from Ollama /api/embed — never from 9Router.
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_TOPK=6
RAG_PREFILTER_LIMIT=50
RAG_MIN_SCORE=0.35

# School Information Default
SCHOOL_NAME="Zeferino Arroyo High School"
SCHOOL_ABBR="ZAHS"
SCHOOL_MOTTO="Basta Zeferinian, Magaling Yan!"
SCHOOL_YEAR="2026-2027"
CURRENT_TERM="Term 1"

# Mail (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.school.gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
MAIL_FROM=EduShare 2.0 <your.school.gmail@gmail.com>
# true = print OTPs to the console and skip real delivery. Set false to send mail.
OTP_DEV_LOG=true
